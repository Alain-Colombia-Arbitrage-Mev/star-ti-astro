{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "star-ti-astro",
  "compatibility_date": "2026-07-01",
  // Sitio Astro estatico + script minimo que redirige www.* -> apex (301).
  // El build de Cloudflare ejecuta el build de Astro y wrangler sube dist/.
  "main": "worker/index.js",
  // Mantiene activa star-ti-astro.guardcolombia.workers.dev (wrangler la
  // desactiva por defecto cuando hay rutas definidas)
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Sirve dist/404.html (generada por src/pages/404.astro) en rutas inexistentes
    "not_found_handling": "404-page",
    // Necesario para que el script vea las peticiones www.* antes de servir assets
    "run_worker_first": true
  },
  // Los apex (star-ti.com, starsolutionsti.com.co, starsolutionsti.com.ve) estan
  // conectados como Custom Domains desde el dashboard. Los www usan rutas de zona
  // porque ya existian registros DNS proxied creados manualmente.
  // www.starsolutionsti.com.ve pendiente: la zona esta "moved" (NS fuera de Cloudflare).
  // Limite de envios del formulario: 5 por minuto por IP (ver worker/index.js).
  // namespace_id es un identificador numerico libre, unico dentro de la cuenta.
  "ratelimits": [
    { "name": "LEAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "routes": [
    { "pattern": "www.star-ti.com/*", "zone_name": "star-ti.com" },
    { "pattern": "www.starsolutionsti.com.co/*", "zone_name": "starsolutionsti.com.co" }
  ]
}

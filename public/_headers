# Cache immutable assets (hashed filenames change on each build)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache fonts (self-hosted, rarely change)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images
/assets/*
  Cache-Control: public, max-age=2592000, must-revalidate

# Cache static files
/logo.png
  Cache-Control: public, max-age=2592000, must-revalidate

/favicon.png
  Cache-Control: public, max-age=2592000, must-revalidate

/og-default.png
  Cache-Control: public, max-age=2592000, must-revalidate

# HTML pages - short cache with revalidation
# /gracias/* tambien recibe las cabeceras de /*: Cloudflare une con coma los
# valores repetidos, asi que aqui solo va lo exclusivo de esta ruta.
/gracias/*
  X-Robots-Tag: noindex, nofollow

# CSP: 'unsafe-inline' en script-src porque Astro emite <script type="module">
# inline en cada pagina. Origenes externos: imagenes de www.bitdefender.com y
# Cloudflare Turnstile (challenges.cloudflare.com) para los formularios.
/*
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://star-ti.com https://www.bitdefender.com; media-src 'self'; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

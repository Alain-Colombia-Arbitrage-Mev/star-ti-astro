---
import type { SEOData } from '@data/seo';
import { BASE_URL } from '@data/seo';
import '@/styles/global.css';

interface Props {
  seo: SEOData;
}

const { seo } = Astro.props;
const ogTitle = seo.ogTitle || seo.title;
const ogType = seo.ogType || 'website';
const ogImage = seo.ogImage || `${BASE_URL}/og-default.png`;
const htmlLang = seo.lang || 'es';
// og:locale debe seguir el idioma real de la pagina (Miami esta en ingles).
const ogLocale = htmlLang.startsWith('en') ? 'en_US' : 'es_CO';

// Build breadcrumb JSON-LD
const breadcrumbJsonLd = seo.breadcrumb ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: seo.breadcrumb.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.url.startsWith('http') ? item.url : `${BASE_URL}${item.url}`,
  })),
} : null;
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Self-hosted fonts for performance (no external requests) -->
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: 'Instrument Sans';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/instrument-sans-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Instrument Sans';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/instrument-sans-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/space-grotesk-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/space-grotesk-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
    </style>

    <!-- Preconnect solo a origenes externos que esta pagina realmente consume -->
    {seo.preconnect?.map((origin) => (
      <>
        <link rel="preconnect" href={origin} crossorigin />
        <link rel="dns-prefetch" href={origin} />
      </>
    ))}

    <!-- SEO Meta Tags -->
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {/* Meta keywords removed: ignorado por Google desde 2009, tratado como spam signal por Bing */}
    <link rel="canonical" href={seo.canonical} />
    <meta name="robots" content={seo.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="author" content="Starsolution S.A.S." />
    <meta name="geo.region" content="CO" />
    <meta name="geo.placename" content="Bogota" />

    <!-- Hreflang solo en paginas con equivalente regional real (home, venezuela, miami, contacto) -->
    {seo.hreflang?.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />
    <meta property="og:site_name" content="Starsolution" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content="es_VE" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD Structured Data -->
    {seo.jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(seo.jsonLd)} />
    )}

    <!-- FAQ Schema -->
    {seo.faqJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(seo.faqJsonLd)} />
    )}

    <!-- Breadcrumb Schema -->
    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}
  </head>
  <body class="bg-white min-h-screen w-full font-['Instrument_Sans',sans-serif]">
    <main>
      <slot />
    </main>
  </body>
</html>

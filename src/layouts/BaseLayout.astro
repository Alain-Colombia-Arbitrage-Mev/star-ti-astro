---
import type { SEOData } from '@data/seo';
import { BASE_URL } from '@data/seo';
import '@/styles/global.css';
import LeadFormGuard from '@/components/LeadFormGuard.astro';

interface Props {
  seo: SEOData;
}

const { seo } = Astro.props;
const ogTitle = seo.ogTitle || seo.title;
const ogType = seo.ogType || 'website';
const ogImage = seo.ogImage || `${BASE_URL}/og-default.png`;
const htmlLang = seo.lang || 'es';
// og:locale debe seguir el idioma real de la pagina (Miami esta en ingles).
const ogLocale = htmlLang.startsWith('en') ? 'en_US' : 'es_CO';

// Build breadcrumb JSON-LD
const breadcrumbJsonLd = seo.breadcrumb ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: seo.breadcrumb.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.url.startsWith('http') ? item.url : `${BASE_URL}${item.url}`,
  })),
} : null;
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Tag Manager (contenedor GTM-T28HTCQ, cuenta "star": trae la configuracion historica). Las etiquetas de
         GA4 y Google Ads se configuran en GTM; la conversion de lead es la visita a /gracias/. -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-T28HTCQ');</script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Self-hosted fonts for performance (no external requests) -->
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: 'Instrument Sans';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/instrument-sans-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Instrument Sans';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/instrument-sans-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/space-grotesk-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/space-grotesk-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
    </style>

    <!-- Preconnect solo a origenes externos que esta pagina realmente consume -->
    {seo.preconnect?.map((origin) => (
      <>
        <link rel="preconnect" href={origin} crossorigin />
        <link rel="dns-prefetch" href={origin} />
      </>
    ))}

    <!-- SEO Meta Tags -->
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {/* Meta keywords removed: ignorado por Google desde 2009, tratado como spam signal por Bing */}
    <link rel="canonical" href={seo.canonical} />
    <meta name="robots" content={seo.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="author" content="Star Solutions TI S.A.S." />
    <meta name="geo.region" content="CO" />
    <meta name="geo.placename" content="Bogota" />

    <!-- Hreflang solo en paginas con equivalente regional real (home, venezuela, contacto) -->
    {seo.hreflang?.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />
    <meta property="og:site_name" content="Star Solutions TI" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content="es_VE" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- JSON-LD Structured Data -->
    {seo.jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(seo.jsonLd)} />
    )}

    <!-- FAQ Schema -->
    {seo.faqJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(seo.faqJsonLd)} />
    )}

    <!-- Breadcrumb Schema -->
    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}
  </head>
  <body class="bg-white min-h-screen w-full font-['Instrument_Sans',sans-serif]">
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T28HTCQ" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <main>
      <slot />
    </main>
    <LeadFormGuard />
    <!-- Zoho SalesIQ (chat del sitio, Zoho One de Star). Activo en todo el sitio
         desde el 19-oct-2026; para apagarlo, poner CHAT_ENABLED en false. -->
    <style is:global>
      /* Burbuja de SalesIQ del mismo tamano que el boton de WhatsApp (64 px). */
      #zsiq_float, .zsiq_floatmain { transform: scale(1.5); transform-origin: bottom right; }
      /* Con el chat activo, WhatsApp pasa a la izquierda para no taparse con la burbuja. */
      html.chat-on .wa-float { right: auto; left: 1.5rem; }
    </style>
    <script is:inline>
      var CHAT_ENABLED = true;
      if (CHAT_ENABLED) {
        document.documentElement.classList.add('chat-on');
        window.$zoho = window.$zoho || {};
        $zoho.salesiq = $zoho.salesiq || { ready: function () { $zoho.salesiq.language('es'); } };
        var zs = document.createElement('script');
        zs.id = 'zsiqscript';
        zs.defer = true;
        zs.src = 'https://salesiq.zohopublic.com/widget?wc=siqccee16aa641815ba42697dac61caf02846f13ff800dc242433896540249be60c';
        document.body.appendChild(zs);
      }
    </script>
  </body>
</html>

---
// Antispam compartido para todos los form[data-lead-form] (POST a /api/leads).
// El worker valida lo que este script agrega:
// 1. Campo trampa `_website`: invisible para personas; los bots lo llenan.
// 2. `_elapsed`: milisegundos entre carga y envio; un bot envia en < 3 s.
// 3. Cloudflare Turnstile (widget "Star Solutions - formularios"). La clave del
//    sitio es publica; la secreta vive solo en el Worker (TURNSTILE_SECRET_KEY).
//    PUBLIC_TURNSTILE_SITE_KEY en el build la reemplaza si algun dia se rota.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '0x4AAAAAAFZhj9AjInibWIe_';
---

<div hidden data-lead-guard data-turnstile-sitekey={siteKey}></div>

<script>
  const config = document.querySelector<HTMLElement>('[data-lead-guard]');
  const siteKey = config?.dataset.turnstileSitekey ?? '';
  const forms = document.querySelectorAll<HTMLFormElement>('form[data-lead-form]');
  const loadedAt = performance.now();

  function addHidden(form: HTMLFormElement, name: string, value = '') {
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = name;
    input.value = value;
    form.append(input);
    return input;
  }

  forms.forEach((form) => {
    // Trampa: input de texto real fuera de pantalla (los bots ignoran type=hidden).
    const trap = document.createElement('input');
    trap.type = 'text';
    trap.name = '_website';
    trap.tabIndex = -1;
    trap.autocomplete = 'off';
    trap.setAttribute('aria-hidden', 'true');
    trap.style.cssText = 'position:absolute;left:-10000px;width:1px;height:1px;opacity:0;';
    form.append(trap);

    const elapsed = addHidden(form, '_elapsed');
    form.addEventListener('submit', (event) => {
      elapsed.value = String(Math.round(performance.now() - loadedAt));
      // Confirmación inmediata: el botón muestra "Enviando…" y no admite un
      // segundo clic. Se aplaza un instante por si otro script cancela el envío.
      const submit = (event as SubmitEvent).submitter ?? form.querySelector('[type="submit"]');
      window.setTimeout(() => {
        if (event.defaultPrevented || !(submit instanceof HTMLButtonElement)) return;
        submit.dataset.label ??= submit.innerHTML;
        const en = document.documentElement.lang.startsWith('en');
        submit.innerHTML = `<span class="lead-spinner" aria-hidden="true"></span> ${en ? 'Sending…' : 'Enviando…'}`;
        submit.setAttribute('aria-busy', 'true');
        submit.disabled = true;
      }, 0);
    });

    if (siteKey) {
      const widget = document.createElement('div');
      widget.className = 'lead-turnstile';
      widget.style.cssText = 'display:flex;justify-content:center;margin:0.75rem 0;';
      // Antes del bloque del formulario que contiene el boton, no dentro de su
      // fila: en ConsultoriaForm el boton vive en un contenedor flex y el widget
      // quedaba al lado, desbordando la pantalla en el celular.
      const submit = form.querySelector('[type="submit"]');
      const anchor = submit?.closest('form > *') ?? submit;
      if (anchor) anchor.before(widget);
      else form.append(widget);
    }
  });

  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    document.querySelectorAll<HTMLButtonElement>('form[data-lead-form] [type="submit"][aria-busy="true"]').forEach((b) => {
      if (b.dataset.label) b.innerHTML = b.dataset.label;
      b.removeAttribute('aria-busy');
      b.disabled = false;
    });
  });

  if (siteKey && forms.length) {
    (window as any).onTurnstileLoad = () => {
      const lang = document.documentElement.lang.startsWith('en') ? 'en' : 'es';
      document.querySelectorAll<HTMLElement>('.lead-turnstile').forEach((el) => {
        (window as any).turnstile.render(el, { sitekey: siteKey, language: lang });
      });
    };
    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad';
    script.async = true;
    document.head.append(script);
  }
</script>

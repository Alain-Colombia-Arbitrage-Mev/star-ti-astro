---
// Tarjeta con el logo oficial de la marca para el encabezado de cada página de
// herramienta (reemplaza las imágenes genéricas). Logos en public/marcas/,
// normalizados a WebP de hasta 800x320 px con fondo transparente. Lleva el sello
// "certificados técnica y comercialmente": Star lo está en todas las marcas que
// distribuye (confirmado por George, 18-oct-2026).
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Ancho máximo de la tarjeta (clase de Tailwind). */
  maxWidth?: string;
}

const { src, alt, width, height, maxWidth = 'max-w-md' } = Astro.props;
---

<div class:list={['brand-logo-card relative w-full mx-auto aspect-[4/3] rounded-3xl bg-white border border-gray-100 shadow-xl overflow-hidden flex items-center justify-center', maxWidth]}>
  <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full bg-red-50" aria-hidden="true"></div>
  <div class="absolute -bottom-20 -left-20 w-56 h-56 rounded-full bg-gray-50" aria-hidden="true"></div>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    class="relative w-[72%] max-h-[46%] object-contain"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <span class="absolute bottom-4 left-1/2 -translate-x-1/2 inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-gray-900 px-3.5 py-1.5 text-xs font-semibold text-white shadow-md">
    <svg class="h-3.5 w-3.5 text-emerald-400" fill="none" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 7.5l2.5 2.5L11 4.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
    Certificados técnica y comercialmente
  </span>
</div>

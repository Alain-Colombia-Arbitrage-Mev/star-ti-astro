---
// Preguntas de compra de cada página (datos en src/data/keywordFaqs.ts).
import { keywordFaqs } from '@data/keywordFaqs';
interface Props { page: string; title?: string }
const { page, title = 'Preguntas antes de cotizar' } = Astro.props;
const items = keywordFaqs[page] ?? [];
---
{items.length > 0 && (
  <section class="kwfaq" aria-labelledby={`kwfaq-${page}`}>
    <div class="kwfaq-in">
      <h2 id={`kwfaq-${page}`}>{title}</h2>
      <div class="kwfaq-list">
        {items.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="kwfaq-cta"><a href="/contacto/">Pida su cotización sin costo</a> o escríbanos por WhatsApp.</p>
    </div>
  </section>
)}
<style>
  .kwfaq{background:#f8fafc;border-top:1px solid #e5e7eb;padding:64px 20px}
  .kwfaq-in{max-width:860px;margin:0 auto}
  .kwfaq h2{font-size:clamp(1.6rem,3vw,2.1rem);font-weight:700;color:#0f172a;text-align:center;margin:0 0 28px}
  .kwfaq-list{display:flex;flex-direction:column;gap:12px}
  .kwfaq details{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:18px 22px;transition:border-color .2s,box-shadow .2s}
  .kwfaq details[open]{border-color:#fdba74;box-shadow:0 6px 20px -12px rgba(239,68,68,.35)}
  .kwfaq summary{cursor:pointer;font-weight:600;color:#0f172a;list-style:none;display:flex;justify-content:space-between;gap:16px}
  .kwfaq summary::-webkit-details-marker{display:none}
  .kwfaq summary::after{content:'+';color:#ef4444;font-size:1.3rem;line-height:1;transition:transform .2s}
  .kwfaq details[open] summary::after{transform:rotate(45deg)}
  .kwfaq details p{margin:12px 0 0;color:#475569;line-height:1.65;font-size:.97rem}
  .kwfaq-cta{text-align:center;margin-top:26px;color:#475569}
  .kwfaq-cta a{color:#dc2626;font-weight:600;text-decoration:underline}
</style>

---
// Bloque "Siguiente paso": lleva a quien lee un artículo hacia la página que vende.
interface Item { href: string; kicker: string; title: string; text: string }
interface Props { items: Item[]; title?: string }
const { items, title = 'Siguiente paso para su empresa' } = Astro.props;
---
<section class="nstep" aria-label={title}>
  <div class="nstep-in">
    <h2>{title}</h2>
    <div class="nstep-grid">
      {items.map((i) => (
        <a href={i.href} class="nstep-card">
          <span class="nstep-k">{i.kicker}</span>
          <strong>{i.title}</strong>
          <span class="nstep-t">{i.text}</span>
          <span class="nstep-go">Ver más →</span>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .nstep{background:#0b0f19;padding:56px 20px}
  .nstep-in{max-width:1100px;margin:0 auto}
  .nstep h2{color:#fff;font-size:clamp(1.5rem,2.6vw,2rem);font-weight:700;text-align:center;margin:0 0 26px}
  .nstep-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
  .nstep-card{display:flex;flex-direction:column;gap:8px;padding:22px;border-radius:16px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);color:#e5e7eb;text-decoration:none;transition:transform .25s,border-color .25s,background .25s}
  .nstep-card:hover{transform:translateY(-4px);border-color:#f97316;background:rgba(249,115,22,.08)}
  .nstep-k{font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#f97316}
  .nstep-card strong{color:#fff;font-size:1.08rem}
  .nstep-t{color:#9ca3af;font-size:.93rem;line-height:1.55}
  .nstep-go{margin-top:auto;color:#ef4444;font-weight:600;font-size:.92rem}
  @media (prefers-reduced-motion:reduce){.nstep-card{transition:none}.nstep-card:hover{transform:none}}
</style>

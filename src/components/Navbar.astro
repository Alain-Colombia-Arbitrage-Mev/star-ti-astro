                <div class="text-xs text-gray-500">{t('Guía comparativa Colombia', 'Colombia comparison guide')}</div>
              </a>
              <a href="/sealpath/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-emerald-50 transition">
                <div class="font-semibold">SealPath</div>
                <div class="text-xs text-gray-500">{t('Seguridad de datos DLP', 'DLP data security')}</div>

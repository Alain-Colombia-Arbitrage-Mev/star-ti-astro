---
// lang por defecto 'es': las paginas en espanol no pasan prop. Solo /miami/ e
// /miami/contacto/ pasan lang="en". Los enlaces apuntan a paginas de producto
// que solo existen en espanol; los nombres de marca no se traducen.
interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const t = (es: string, enStr: string) => (en ? enStr : es);
const contacto = en ? '/miami/contacto/' : '/contacto/';
---
<nav class="sticky top-0 z-50 bg-white border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href={en ? '/miami/' : '/'} class="flex-shrink-0 flex items-center">
        <img src="/logo.png" alt="Starsolution" class="h-10 w-10 lg:h-14 lg:w-14" width="48" height="48" loading="eager" fetchpriority="high" />
        <span class="hidden lg:inline font-bold text-lg text-gray-900 ml-2">Starsolution</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        <a href={en ? '/miami/' : '/'} class="px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-50 rounded-3xl transition">Home</a>

        <!-- STAR PROTECTION Dropdown -->
        <div class="relative group/protection">
          <button class="px-4 py-2 text-sm font-medium text-gray-900 hover:bg-red-50 rounded-3xl transition flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-red-500"></span>
            Star Protection
            <svg class="w-3 h-3 transition-transform duration-200 group-hover/protection:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="absolute top-full left-0 mt-2 w-72 bg-white border border-gray-200 rounded-2xl shadow-xl shadow-black/5 py-0 opacity-0 invisible group-hover/protection:opacity-100 group-hover/protection:visible transition-all duration-300 overflow-hidden">
            <div class="bg-red-50 px-4 py-3 border-b border-red-100">
              <div class="font-bold text-red-600 text-xs uppercase tracking-wider">Star Protection</div>
              <div class="text-xs text-red-500 mt-0.5">{t('Defensa proactiva de endpoints y email', 'Proactive endpoint and email defense')}</div>
            </div>
            <div class="py-2">
              <a href="/bitdefender/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-red-50 transition">
                <div class="font-semibold">Bitdefender GravityZone EDR/XDR</div>

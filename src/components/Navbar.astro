            <a href="/kaspersky/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-white rounded-lg transition">
              <div class="font-semibold text-gray-900">Kaspersky Endpoint</div>
              <div class="text-xs text-gray-500 mt-0.5">{t('Protección endpoint + servidores', 'Endpoint + server protection')}</div>
            </a>
            <a href="/acronis/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-white rounded-lg transition">
              <div class="font-semibold text-gray-900">Acronis</div>
              <div class="text-xs text-gray-500 mt-0.5">{t('Backup y recuperación ante ransomware', 'Backup and ransomware recovery')}</div>
            </a>
          </div>
        </div></div>
      </div>

      <!-- Mobile STAR INSPECTION -->
      <div class="space-y-1">
        <button class="mobile-dropdown-btn w-full flex items-center justify-between px-4 py-3 text-sm font-medium text-gray-900 hover:bg-blue-50 rounded-lg transition" data-target="mobile-inspection" aria-expanded="false" aria-controls="mobile-inspection" type="button">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            Star Inspection
          </span>
          <svg class="w-5 h-5 dropdown-chevron" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">

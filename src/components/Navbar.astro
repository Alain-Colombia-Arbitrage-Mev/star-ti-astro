              <a href="/anydesk/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 transition">
                <div class="font-semibold">AnyDesk</div>
                <div class="text-xs text-gray-500">{t('Escritorio remoto ultra rápido', 'Ultra-fast remote desktop')}</div>
              </a>
              <a href="/cableado-estructurado/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 transition">
                <div class="font-semibold">{t('Cableado Estructurado', 'Structured Cabling')}</div>
                <div class="text-xs text-gray-500">{t('Instalación de redes', 'Network installation')}</div>
              </a>
              <a href="/equipos-computo/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 transition">
                <div class="font-semibold">{t('Equipos de Computo', 'IT Equipment')}</div>
                <div class="text-xs text-gray-500">{t('Hardware empresarial', 'Enterprise hardware')}</div>
              </a>
              <a href="/portafolio/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-red-50 transition border-t border-gray-100">
                <div class="font-semibold text-red-700">{t('Portafolio 2026 (PDF)', '2026 Portfolio (PDF)')}</div>
                <div class="text-xs text-gray-500">{t('Todas nuestras soluciones', 'All our solutions')}</div>
              </a>
            </div>
          </div>
        </div>

        <a href="/blog/" class="px-1.5 xl:px-2.5 2xl:px-3 py-2 text-sm font-medium whitespace-nowrap text-gray-900 hover:bg-gray-50 rounded-3xl transition">Blog</a>
      </div>

      <div class="flex items-center gap-3 lg:gap-4">
      <!-- CTA Button -->
      <a href={contacto} class="group hidden lg:inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-red-600 pl-3 pr-3.5 py-1.5 text-[13px] font-semibold text-white shadow-md shadow-red-600/30 ring-1 ring-red-400/40 hover:bg-red-700 hover:shadow-lg hover:shadow-red-600/40 transition">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-white opacity-75 animate-ping"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-white"></span>
        </span>
        {t('Diagnóstico gratis', 'Free assessment')}
        <svg class="hidden xl:block w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12" /></svg>
      </a>

      <!-- Sello ISO 27001: abre el certificado SGS en una pestaña nueva -->
      <a
        href={isoCertificado}
        target="_blank"
        rel="noopener"
        class="flex-shrink-0 transition hover:scale-105"
        title={t('Ver nuestro certificado ISO 27001 (SGS)', 'View our ISO 27001 certificate (SGS)')}
      >
        <img src="/certificados/sello-iso-27001-sgs.webp" alt={t('Certificado ISO 27001 SGS - ver PDF', 'ISO 27001 SGS certificate - view PDF')} class="h-10 w-auto lg:h-12" width="131" height="128" loading="eager" />
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-gray-900 transition-transform duration-200 active:scale-90"
        aria-label={t('Abrir menu', 'Open menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        type="button"
      >
        <svg class="w-6 h-6 transition-transform duration-200" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="w-6 h-6 hidden transition-transform duration-200" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="mm lg:hidden" data-open="false">
      <div class="mm-inner"><div class="py-4 space-y-1 border-t border-gray-200">
      <a href={en ? '/miami/' : '/'} class="block px-4 py-3 text-sm font-medium text-gray-900 hover:bg-gray-50 rounded-lg transition">Home</a>

      <!-- Mobile STAR PROTECTION -->
      <div class="space-y-1">
        <button class="mobile-dropdown-btn w-full flex items-center justify-between px-4 py-3 text-sm font-medium text-gray-900 hover:bg-red-50 rounded-lg transition" data-target="mobile-protection" aria-expanded="false" aria-controls="mobile-protection" type="button">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-red-500"></span>
            Star Protection
          </span>
          <svg class="w-5 h-5 dropdown-chevron" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">

---
// lang por defecto 'es': las paginas en espanol no pasan prop. Solo /miami/ e
// /miami/contacto/ pasan lang="en". Los enlaces apuntan a paginas de producto
// que solo existen en espanol; los nombres de marca no se traducen.
interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const t = (es: string, enStr: string) => (en ? enStr : es);
const contacto = en ? '/miami/contacto/' : '/contacto/';
const isoCertificado = '/certificados/certificado-iso-27001-star-solutions-ti.pdf';
---
<nav class="sticky top-0 z-50 bg-white border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href={en ? '/miami/' : '/'} class="flex-shrink-0 flex items-center">
        <img src="/logo.png" alt="Star Solutions TI" class="h-10 w-10 lg:h-14 lg:w-14" width="48" height="48" loading="eager" fetchpriority="high" />
        <span class="inline lg:hidden xl:inline font-bold text-base sm:text-lg text-gray-900 ml-2 whitespace-nowrap">Star Solutions TI</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-0 xl:gap-1">
        <a href={en ? '/miami/' : '/'} class="hidden 2xl:inline-block px-1.5 xl:px-2.5 2xl:px-3 py-2 text-sm font-medium whitespace-nowrap text-gray-900 hover:bg-gray-50 rounded-3xl transition">Home</a>

        <!-- STAR PROTECTION Dropdown -->
        <div class="relative group/protection" data-dropdown>
          <button type="button" data-dropdown-btn aria-expanded="false" aria-controls="dd-protection" class="px-1.5 xl:px-2.5 2xl:px-3 py-2 text-sm font-medium whitespace-nowrap text-gray-900 hover:bg-red-50 rounded-3xl transition flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-red-500"></span>
            Star Protection
            <svg class="dd-chevron w-3 h-3" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div id="dd-protection" class="dd-panel absolute top-full left-0 mt-2 w-72 bg-white border border-gray-200 rounded-2xl shadow-xl shadow-black/5 py-0 overflow-hidden">
            <div class="bg-red-50 px-4 py-3 border-b border-red-100">
              <div class="font-bold text-red-600 text-xs uppercase tracking-wider">Star Protection</div>
              <div class="text-xs text-red-500 mt-0.5">{t('Defensa proactiva de endpoints y email', 'Proactive endpoint and email defense')}</div>
            </div>
            <div class="py-2">
              <a href="/bitdefender/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-red-50 transition">
                <div class="font-semibold">Bitdefender GravityZone EDR/XDR</div>
                <div class="text-xs text-gray-500">{t('Protección endpoint multicapa', 'Multi-layered endpoint protection')}</div>
              </a>
              <a href="/hornetsecurity/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-red-50 transition">
                <div class="font-semibold">Hornetsecurity 365</div>
                <div class="text-xs text-gray-500">{t('Seguridad email empresarial', 'Enterprise email security')}</div>
              </a>
              <a href="/kymatio/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-red-50 transition">
                <div class="font-semibold">Kymatio</div>
                <div class="text-xs text-gray-500">{t('Gestión del riesgo humano', 'Human risk management')}</div>
              </a>
              <a href="/proofpoint/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-red-50 transition">
                <div class="font-semibold">Proofpoint</div>
                <div class="text-xs text-gray-500">{t('Email security avanzado', 'Advanced email security')}</div>
              </a>
              <a href="/kaspersky/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-red-50 transition">
                <div class="font-semibold">Kaspersky Endpoint</div>
                <div class="text-xs text-gray-500">{t('Protección endpoint + servidores', 'Endpoint + server protection')}</div>
              </a>
              <a href="/acronis/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-red-50 transition">
                <div class="font-semibold">Acronis</div>
                <div class="text-xs text-gray-500">{t('Backup y recuperación ante ransomware', 'Backup and ransomware recovery')}</div>
              </a>
            </div>
          </div>
        </div>

        <!-- STAR INSPECTION Dropdown -->
        <div class="relative group/inspection" data-dropdown>
          <button type="button" data-dropdown-btn aria-expanded="false" aria-controls="dd-inspection" class="px-1.5 xl:px-2.5 2xl:px-3 py-2 text-sm font-medium whitespace-nowrap text-gray-900 hover:bg-blue-50 rounded-3xl transition flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            Star Inspection
            <svg class="dd-chevron w-3 h-3" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div id="dd-inspection" class="dd-panel absolute top-full left-0 mt-2 w-72 bg-white border border-gray-200 rounded-2xl shadow-xl shadow-black/5 py-0 overflow-hidden">
            <div class="bg-blue-50 px-4 py-3 border-b border-blue-100">
              <div class="font-bold text-blue-600 text-xs uppercase tracking-wider">Star Inspection</div>
              <div class="text-xs text-blue-500 mt-0.5">{t('Visibilidad y detección de amenazas', 'Visibility and threat detection')}</div>
            </div>
            <div class="py-2">
              <a href="/enthec/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-blue-50 transition">
                <div class="font-semibold">Enthec</div>
                <div class="text-xs text-gray-500">{t('Superficie de ataque', 'Attack surface')}</div>
              </a>
              <a href="/vicarius/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-blue-50 transition">
                <div class="font-semibold">Vicarius</div>
                <div class="text-xs text-gray-500">{t('Vulnerabilidades y CVEs', 'Vulnerabilities and CVEs')}</div>
              </a>
              <a href="/hacking-etico/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-blue-50 transition">
                <div class="font-semibold">{t('Hacking Ético', 'Ethical Hacking')}</div>
                <div class="text-xs text-gray-500">{t('Pentesting certificado', 'Certified pentesting')}</div>
              </a>
            </div>
          </div>
        </div>

        <!-- STAR COMPLIANCE Dropdown -->
        <div class="relative group/compliance" data-dropdown>
          <button type="button" data-dropdown-btn aria-expanded="false" aria-controls="dd-compliance" class="px-1.5 xl:px-2.5 2xl:px-3 py-2 text-sm font-medium whitespace-nowrap text-gray-900 hover:bg-emerald-50 rounded-3xl transition flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Star Compliance
            <svg class="dd-chevron w-3 h-3" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div id="dd-compliance" class="dd-panel absolute top-full left-0 mt-2 w-72 bg-white border border-gray-200 rounded-2xl shadow-xl shadow-black/5 py-0 overflow-hidden">
            <div class="bg-emerald-50 px-4 py-3 border-b border-emerald-100">
              <div class="font-bold text-emerald-600 text-xs uppercase tracking-wider">Star Compliance</div>
              <div class="text-xs text-emerald-500 mt-0.5">{t('Cumplimiento normativo y gobernanza', 'Regulatory compliance and governance')}</div>
            </div>
            <div class="py-2">
              <a href="/iso-27001/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-emerald-50 transition">

          </button>
          <div id="dd-soc" class="dd-panel absolute top-full left-0 mt-2 w-72 bg-white border border-gray-200 rounded-2xl shadow-xl shadow-black/5 py-0 overflow-hidden">
            <div class="bg-violet-50 px-4 py-3 border-b border-violet-100">
              <div class="font-bold text-violet-600 text-xs uppercase tracking-wider">Star SOC</div>
              <div class="text-xs text-violet-500 mt-0.5">{t('Centro de operaciones de seguridad 24/7', '24/7 security operations center')}</div>
            </div>
            <div class="py-2">
              <a href="/soc-24x7/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-violet-50 transition">
                <div class="font-semibold">SOC 24x7</div>
                <div class="text-xs text-gray-500">Monitoreo, detección y respuesta a incidentes</div>
              </a>
              <a href="/stellar-cyber/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-violet-50 transition">

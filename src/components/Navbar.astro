              <div class="font-bold text-gray-600 text-xs uppercase tracking-wider">{t('Más Soluciones', 'More Solutions')}</div>
              <div class="text-xs text-gray-500 mt-0.5">{t('Infraestructura y productividad', 'Infrastructure and productivity')}</div>
            </div>

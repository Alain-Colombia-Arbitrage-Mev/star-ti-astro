<style is:global>
  /* Menús desplegables (escritorio). Nacen del botón que los abre y se van por
     el mismo camino; se abren al instante y esperan un instante antes de
     cerrar, para que el mouse pueda cruzar el espacio hasta el panel. */
  [data-dropdown] { position: relative; }
  [data-dropdown][data-open]::after {
    /* Puente invisible sobre el hueco entre botón y panel */
    content: ''; position: absolute; top: 100%; left: 0; width: 18rem; height: 0.75rem;
  }
  [data-dropdown]:has(.dd-panel--right)[data-open]::after { left: auto; right: 0; }
  .dd-panel {
    opacity: 0; visibility: hidden;
    transform: translateY(-6px) scale(0.98);
    transform-origin: top left;
    transition: opacity 140ms ease-out, transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0s linear 200ms;
  }
  .dd-panel--right { transform-origin: top right; }
  [data-dropdown][data-open] > .dd-panel {
    opacity: 1; visibility: visible; transform: none;
    transition: opacity 120ms ease-out, transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0s;
  }
  .dd-chevron { transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  [data-dropdown][data-open] .dd-chevron { transform: rotate(180deg); }

  /* Menú móvil y acordeones: crecen hacia abajo desde su botón y se recogen
     por el mismo camino. Se pueden revertir a mitad de la animación. */
  .mm, .mm-acc {
    display: grid; grid-template-rows: 0fr; visibility: hidden;
    transition: grid-template-rows 280ms cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0s linear 280ms;
  }
  .mm[data-open='true'], .mm-acc[data-open='true'] {
    grid-template-rows: 1fr; visibility: visible;
    transition: grid-template-rows 280ms cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0s;
  }
  .mm-inner, .mm-acc-inner { min-height: 0; overflow: hidden; }
  .mm-inner > div, .mm-acc-inner > div {
    opacity: 0; transform: translateY(-4px);
    transition: opacity 180ms ease-out, transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .mm[data-open='true'] > .mm-inner > div,
  .mm-acc[data-open='true'] > .mm-acc-inner > div { opacity: 1; transform: none; }
  .dropdown-chevron { transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  [aria-expanded='true'] > .dropdown-chevron { transform: rotate(180deg); }

  @media (prefers-reduced-motion: reduce) {
    .dd-panel, [data-dropdown][data-open] > .dd-panel { transform: none; }
    .mm, .mm-acc, .mm[data-open='true'], .mm-acc[data-open='true'] { transition: visibility 0s; }
    .mm-inner > div, .mm-acc-inner > div { transform: none; transition: opacity 150ms ease; }
    .dd-chevron, .dropdown-chevron { transition: none; }
  }
</style>

<script>
  // ---- Menús de escritorio: mouse, toque (tablets) y teclado ----
  const CLOSE_DELAY = 140; // ms de gracia al salir con el mouse
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('[data-dropdown]'));

  function setOpen(dd: HTMLElement, open: boolean) {
    const btn = dd.querySelector<HTMLButtonElement>('[data-dropdown-btn]');
    if (open) {
      dropdowns.forEach((other) => { if (other !== dd) setOpen(other, false); });
      dd.setAttribute('data-open', '');
    } else {
      dd.removeAttribute('data-open');
    }
    btn?.setAttribute('aria-expanded', String(open));
  }

  dropdowns.forEach((dd) => {
    const btn = dd.querySelector<HTMLButtonElement>('[data-dropdown-btn]');
    let closeTimer: number | undefined;
    const cancelClose = () => window.clearTimeout(closeTimer);

    dd.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      cancelClose();
      setOpen(dd, true);
    });
    dd.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      cancelClose();
      closeTimer = window.setTimeout(() => setOpen(dd, false), CLOSE_DELAY);
    });
    // Toque o teclado (Enter/Espacio): alterna. Con mouse ya se abrió al pasar.
    btn?.addEventListener('click', (e) => {
      const viaMouse = (e as PointerEvent).pointerType === 'mouse';
      if (viaMouse && dd.hasAttribute('data-open')) return;
      setOpen(dd, !dd.hasAttribute('data-open'));
    });
    let suppressFocusOpen = false;
    // Solo el foco con teclado abre el panel; el foco que deja un toque o un
    // clic lo maneja el evento click (si no, el toque abriría y cerraría a la vez).
    dd.addEventListener('focusin', (e) => {
      cancelClose();
      if (suppressFocusOpen) return;
      if ((e.target as Element).matches(':focus-visible')) setOpen(dd, true);
    });
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget as Node | null)) setOpen(dd, false);
    });
    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dd.hasAttribute('data-open')) {
        setOpen(dd, false);
        // Devolver el foco al botón sin reabrir el panel
        suppressFocusOpen = true;
        btn?.focus({ preventScroll: true });
        suppressFocusOpen = false;
      }
    });
  });

  document.addEventListener('pointerdown', (e) => {
    dropdowns.forEach((dd) => { if (!dd.contains(e.target as Node)) setOpen(dd, false); });
  });

  // ---- Menú móvil ----
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function setMobileOpen(open: boolean) {
    if (!mobileMenu || !menuBtn) return;
    mobileMenu.dataset.open = String(open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    menuBtn.setAttribute('aria-expanded', String(open));
  }

  menuBtn?.addEventListener('click', () => setMobileOpen(mobileMenu?.dataset.open !== 'true'));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu?.dataset.open === 'true') {
      setMobileOpen(false);
      menuBtn?.focus();
    }
  });

  // Al tocar un enlace (incluidos los que llevan al formulario en la misma página)
  mobileMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMobileOpen(false)));

  document.querySelectorAll<HTMLButtonElement>('.mobile-dropdown-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = document.getElementById(btn.dataset.target!);
      if (!target) return;
      const open = target.dataset.open !== 'true';
      target.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
    });
  });
</script>

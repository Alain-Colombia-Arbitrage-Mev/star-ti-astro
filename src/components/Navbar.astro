              <a href="/netwrix/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-emerald-50 transition">
                <div class="font-semibold">Netwrix</div>
                <div class="text-xs text-gray-500">{t('Auditoría e identidad', 'Auditing and identity')}</div>
              </a>
              <a href="/lastpass/" class="block px-4 py-3 text-sm text-gray-700 hover:bg-emerald-50 transition">
                <div class="font-semibold">LastPass</div>
                <div class="text-xs text-gray-500">{t('Gestión de contraseñas y accesos', 'Password and access management')}</div>
              </a>
            </div>
          </div>
        </div>

        <!-- STAR SOC Dropdown -->
        <div class="relative group/soc" data-dropdown>
          <button type="button" data-dropdown-btn aria-expanded="false" aria-controls="dd-soc" class="px-1.5 xl:px-2.5 2xl:px-3 py-2 text-sm font-medium whitespace-nowrap text-gray-900 hover:bg-violet-50 rounded-3xl transition flex items-center gap-1.5">

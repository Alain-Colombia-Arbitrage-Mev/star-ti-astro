---
// Franja animada con los logos de clientes (inicio). Cada logo va a color en su
// propia tarjeta; al pasar el mouse la franja se detiene y la tarjeta se eleva.
// La lista se duplica para que el desplazamiento sea continuo; la copia va oculta
// para lectores de pantalla. Queda estática si el usuario pidió menos movimiento.
import { clientes, LOGOS_VERSION } from '@data/clientes';
---

<section class="bg-white py-16 sm:py-20" aria-labelledby="clientes-titulo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-6 sm:mb-8">
    <span class="text-red-700 text-xs font-semibold uppercase tracking-wider">Nuestros clientes</span>
    <h2 id="clientes-titulo" class="text-3xl sm:text-4xl font-bold text-gray-900 mt-3 mb-3">
      Empresas y entidades que confían en nosotros
    </h2>
    <p class="text-gray-600 max-w-2xl mx-auto">
      Entidades públicas, sector salud, construcción, medios e industria protegen su información con Star Solutions TI.
    </p>
  </div>

  <div class="clientes-viewport">
    <div class="clientes-track">
      {[0, 1].map((copy) => (
        <ul class="clientes-list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {clientes.map((c) => (
            <li class="clientes-card">
              <img
                src={`${c.logo}?v=${LOGOS_VERSION}`}
                alt={copy === 0 ? c.name : ''}
                title={c.name}
                width={c.width}
                height={c.height}
                loading="eager"
                decoding="async"
                class="clientes-logo"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .clientes-viewport {
    overflow: hidden;
    /* Espacio vertical para que la tarjeta pueda elevarse sin recortarse */
    padding-block: 1.25rem 2rem;
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .clientes-track {
    display: flex;
    width: max-content;
    animation: clientes-scroll 58s linear infinite;
  }
  .clientes-viewport:hover .clientes-track {
    animation-play-state: paused;
  }
  .clientes-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    margin: 0;
    list-style: none;
  }
  .clientes-card {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 6.5rem;
    padding: 1rem 1.75rem;
    background: #fff;
    border: 1px solid #eef0f3;
    border-radius: 1.25rem;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 4px 12px rgba(15, 23, 42, 0.04);
    transition:
      transform 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out),
      border-color 220ms ease;
  }
  /* Solo con mouse: en pantallas táctiles un toque deja la tarjeta "levantada" */
  @media (hover: hover) and (pointer: fine) {
    .clientes-card:hover {
      transform: translateY(-6px) scale(1.04);
      border-color: #fecaca;
      box-shadow: 0 18px 40px -12px rgba(220, 38, 38, 0.25), 0 6px 16px rgba(15, 23, 42, 0.08);
    }
  }
  .clientes-logo {
    height: 3.75rem;
    width: auto;
    max-width: 12rem;
    object-fit: contain;
    transition: transform 220ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .clientes-card:hover .clientes-logo {
      transform: scale(1.04);
    }
  }
  @media (min-width: 640px) {
    .clientes-list {
      gap: 2rem;
      padding-right: 2rem;
    }
    .clientes-card {
      height: 8rem;
      padding: 1.25rem 2.5rem;
    }
    .clientes-logo {
      height: 5rem;
      max-width: 16rem;
    }
  }
  @keyframes clientes-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .clientes-viewport {
      mask-image: none;
      -webkit-mask-image: none;
    }
    .clientes-track {
      animation: none;
      width: auto;
      justify-content: center;
    }
    .clientes-list {
      flex-wrap: wrap;
      justify-content: center;
      padding: 0 1rem;
    }
    .clientes-list[aria-hidden='true'] {
      display: none;
    }
    .clientes-card,
    .clientes-logo {
      transition: none;
    }
    .clientes-card:hover,
    .clientes-card:hover .clientes-logo {
      transform: none;
    }
  }
</style>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import ConsultoriaForm from '@components/ConsultoriaForm.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import { seoData } from '@data/seo';

const seo = seoData['hacking-etico'];
---

<BaseLayout seo={seo}>
  <Navbar />

  <!-- Hero Section -->
  <section class="relative py-20 sm:py-28 lg:py-36 bg-gradient-to-br from-white to-gray-50 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Left Content -->
        <div>
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 bg-[#fee2e2] border border-[#fecaca] px-4 py-2 rounded-full mb-8">
            <svg class="w-4 h-4 text-[#dc2626]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="text-[#dc2626] text-xs font-semibold tracking-wider uppercase">
              Ciberseguridad Ofensiva
            </span>
          </div>

          <!-- Main Heading -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight mb-6">
            <span class="block text-[#0f172a]">Servicio de Hacking Ético</span>
            <span class="block text-[#dc2626]">y Pentesting en Colombia</span>
          </h1>

          <!-- Subheading -->
          <p class="text-xl text-[#64748b] leading-relaxed mb-4">
            Encontramos sus vulnerabilidades antes que los cibercriminales
          </p>

          <p class="text-base text-[#64748b] leading-relaxed mb-10">
            Servicios profesionales de pentesting y análisis de vulnerabilidades con metodología
            OWASP, PTES y NIST. Proteja su infraestructura con evaluaciones exhaustivas realizadas
            por especialistas certificados.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-4 mb-10">
            <a
              href="/contacto/"
              class="bg-gradient-to-r from-red-600 to-red-700 text-white font-semibold px-8 py-4 rounded-full hover:from-red-700 hover:to-red-800 transition shadow-lg inline-flex items-center justify-center gap-2"
            >
              Agendar Evaluación
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            <a
              href="#metodologia"
              class="bg-white border-2 border-gray-200 text-gray-800 font-semibold px-8 py-4 rounded-full hover:bg-gray-50 transition inline-flex items-center justify-center gap-2 focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
            >
              Ver Metodología
            </a>
          </div>

          <!-- Trust Indicators -->
          <div class="flex flex-wrap items-center gap-6">
            <div class="flex items-center gap-2 text-sm text-[#64748b]">
              <svg class="w-5 h-5 text-[#22c55e]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="font-semibold">Certificados CEH y OSCP</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-[#64748b]">
              <svg class="w-5 h-5 text-[#22c55e]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="font-semibold">100% Confidencial</span>
            </div>
          </div>
        </div>

        <!-- Right - Visual -->
        <div class="relative">
          <div class="flex justify-center mb-6">
            <img
              src="/assets/robot-ia-ciberseguridad-trasera.webp"
              alt="Robot de inteligencia artificial con circuitos para hacking ético y pentesting certificado"
              class="w-full max-w-xs mx-auto rounded-2xl shadow-xl"
              width="320"
              height="320"
              loading="lazy"
            />
          </div>
          <div class="bg-gradient-to-br from-[#fee2e2] to-[#fecaca] rounded-2xl p-12 relative overflow-hidden">
            <!-- Terminal mockup -->
            <div class="bg-[#1e293b] rounded-xl shadow-2xl overflow-hidden">
              <!-- Terminal header -->
              <div class="bg-[#0f172a] px-4 py-3 flex items-center gap-2">
                <div class="flex gap-2">
                  <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                  <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                  <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                </div>
                <div class="text-gray-400 text-xs ml-4">pentesting-session.sh</div>
              </div>
              <!-- Terminal content -->
              <div class="p-6 font-mono text-xs text-green-400 space-y-2">
                <div>$ sudo nmap -sV -O target.company.com</div>
                <div class="text-gray-500">Starting Nmap scan...</div>
                <div class="text-white">PORT    STATE SERVICE   VERSION</div>
                <div>22/tcp  open  ssh       OpenSSH 7.4</div>
                <div>80/tcp  open  http      Apache 2.4.6</div>
                <div>443/tcp open  ssl/https nginx</div>
                <div class="text-gray-500 mt-4">$ ./exploit_scanner --owasp-top10</div>
                <div class="text-yellow-400">&#9888; SQL Injection vulnerability detected</div>
                <div class="text-yellow-400">&#9888; XSS vulnerability found in /login</div>
                <div class="text-red-400">&#9888; Critical: Outdated SSL certificate</div>
                <div class="text-gray-500 mt-4">Generating full report...</div>
                <div class="flex items-center gap-2 mt-2">
                  <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                  <span>Scan complete. 12 vulnerabilities found.</span>
                </div>
              </div>
            </div>

            <!-- Floating stats -->
            <div class="absolute -bottom-4 -right-4 bg-white rounded-xl p-4 shadow-xl border border-gray-200">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
                  <svg class="w-7 h-7 text-[#dc2626]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                </div>
                <div>
                  <div class="text-2xl font-bold text-[#0f172a]">12</div>
                  <div class="text-xs text-[#64748b]">Vulnerabilidades</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GEO / AI Discoverability Block -->
  <section class="bg-white pt-14 sm:pt-16" aria-labelledby="que-es-hacking-etico">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="que-es-hacking-etico" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">¿Qué es el hacking ético?</h2>
      <p class="text-lg text-gray-700 leading-relaxed">El hacking ético es la práctica de atacar de forma controlada y autorizada los sistemas de una organización para encontrar vulnerabilidades antes que los criminales, documentarlas con evidencia y entregar un plan de remediación priorizado. Incluye pruebas de penetración (pentesting) sobre aplicaciones web, redes, infraestructura y personas (ingeniería social), ejecutadas bajo un alcance y reglas de enfrentamiento acordadas por contrato. Las empresas lo contratan para cumplir requisitos regulatorios — PCI DSS, SFC Circular 007, ISO 27001 — y para validar sus defensas con ataques reales en lugar de solo escaneos automáticos. Star Solutions TI ejecuta pruebas de hacking ético en Colombia con un equipo certificado CEH y OSCP, entregando un informe ejecutivo para dirección y un informe técnico con pasos de remediación para el equipo de TI.</p>
    </div>
  </section>

  <!-- Servicio de hacking ético en Colombia: búsquedas reales de Search Console (18-oct-2026):
       "servicio de hacking/hackeo ético", "empresas de hacking ético en Colombia", "pentesting para ISO 27001". -->
  <section class="bg-white pt-14 sm:pt-16" aria-labelledby="servicio-hacking-etico-colombia">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="servicio-hacking-etico-colombia" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">Servicio de hacking ético en Colombia</h2>
      <p class="text-lg text-gray-700 leading-relaxed mb-8">Star Solutions TI realiza hacking ético y pentesting para empresas y entidades públicas en Colombia con su propio equipo de planta, certificado en CEH y OSCP. Somos además una empresa certificada en ISO/IEC 27001:2022 por SGS: protegemos la información que nos entregan durante el ejercicio con los mismos controles que le recomendamos implementar.</p>
      <div class="grid md:grid-cols-3 gap-5">
        <div class="border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-2">Pentesting para ISO 27001 y regulación</h3>
          <p class="text-gray-700 text-sm leading-relaxed text-left">La norma ISO/IEC 27001:2022 pide gestionar las vulnerabilidades técnicas (control 8.8) y probar la seguridad de los sistemas (control 8.29). Nuestro informe sirve como evidencia para el auditor, para el MSPI de MinTIC en entidades públicas y para las exigencias de ciberseguridad de la Superintendencia Financiera.</p>
        </div>
        <div class="border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-2">Hacking ético para entidades públicas</h3>
          <p class="text-gray-700 text-sm leading-relaxed text-left">Contratamos por SECOP y estamos inscritos en el RUP con la clase UNSPSC 81111800, que incluye servicios de seguridad de redes e internet. Tenemos más de 100 contratos con entidades públicas. <a href="/ciberseguridad-sector-publico/" class="font-semibold text-red-700 hover:text-red-800">Ver experiencia en sector público</a></p>
        </div>
        <div class="border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-2">Qué exigirle a una empresa de hacking ético</h3>
          <ul class="text-gray-700 text-sm space-y-2">
            <li>✓ Contrato de autorización y acuerdo de confidencialidad firmados antes de empezar</li>
            <li>✓ Equipo con certificaciones reconocidas (CEH, OSCP)</li>
            <li>✓ Informe ejecutivo y técnico con criticidad CVSS y plan de remediación</li>
            <li>✓ Re-test incluido para verificar las correcciones</li>
            <li>✓ Proveedor certificado en ISO 27001 que proteja sus hallazgos</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Awareness -->
  <section class="py-16 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-[#0f172a] mb-4">
          La seguridad pasiva ya no es suficiente
        </h2>
        <p class="text-lg text-[#64748b] max-w-3xl mx-auto">
          Los antivirus y firewalls son esenciales, pero no detectan todas las vulnerabilidades.
          Un enfoque proactivo es la única forma de adelantarse a los atacantes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Stat 1 -->
        <div class="text-center">
          <div class="bg-[#fee2e2] w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-[#dc2626]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="text-4xl font-bold text-[#dc2626] mb-2">USD 4,99 M</div>
          <div class="text-sm text-[#64748b]">
            Costo promedio global de una brecha de datos (IBM, Cost of a Data Breach 2026)
          </div>
        </div>

        <!-- Stat 2 -->
        <div class="text-center">
          <div class="bg-[#fef3c7] w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-[#f59e0b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="text-4xl font-bold text-[#f59e0b] mb-2">247 días</div>
          <div class="text-sm text-[#64748b]">
            Tiempo promedio para identificar y contener una brecha (IBM, Cost of a Data Breach 2026)
          </div>
        </div>

        <!-- Stat 3 -->
        <div class="text-center">
          <div class="bg-[#dcfce7] w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-[#16a34a]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div class="text-4xl font-bold text-[#16a34a] mb-2">62%</div>
          <div class="text-sm text-[#64748b]">
            De las brechas involucran el factor humano: errores, engaños o credenciales robadas (Verizon DBIR 2026)
          </div>
        </div>
      </div>

      <div class="mt-12 bg-gradient-to-r from-[#fee2e2] to-[#fecaca] rounded-2xl p-8">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-white rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-[#dc2626]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#0f172a] mb-3">
              El hacking ético es una inversión en tranquilidad
            </h3>
            <p class="text-[#64748b] leading-relaxed">
              Descubrir y remediar vulnerabilidades antes que los atacantes cuesta una fracción del daño
              que puede causar una brecha. Nuestros test de intrusión identifican debilidades en aplicaciones web,
              infraestructura de red, APIs, aplicaciones móviles y configuraciones cloud.
              <strong class="text-[#0f172a]"> Cada peso invertido en pentesting puede ahorrarle millones
              en pérdidas, multas regulatorias y daño reputacional.</strong>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Que es el White Hat Hacking -->
  <section class="py-24 bg-[#f8fafc]" id="metodologia">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-[#0f172a] mb-4">
          &iquest;Qué es el &quot;White Hat Hacking&quot;?
        </h2>
        <p class="text-lg text-[#64748b] max-w-3xl mx-auto">
          A diferencia de los hackers maliciosos (black hat), los hackers éticos (white hat) utilizan
          las mismas técnicas de intrusión pero con autorización legal para <strong>identificar
          vulnerabilidades</strong> antes que los cibercriminales puedan explotarlas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <div class="bg-white border-2 border-gray-200 rounded-2xl p-8">
          <div class="w-14 h-14 bg-[#fee2e2] rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-[#dc2626]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-[#0f172a] mb-4">Ético y Legal</h3>
          <p class="text-[#64748b] leading-relaxed">
            Trabajamos bajo estrictos acuerdos de confidencialidad (NDA) y contratos de autorización.
            Todo el proceso es transparente, documentado y realizado con pleno conocimiento y aprobación
            de su organización.
          </p>
        </div>

        <div class="bg-white border-2 border-gray-200 rounded-2xl p-8">
          <div class="w-14 h-14 bg-[#dbeafe] rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-[#2563eb]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-[#0f172a] mb-4">Reportes Accionables</h3>
          <p class="text-[#64748b] leading-relaxed">
            No solo encontramos problemas: entregamos informes técnicos detallados con evidencia de cada
            vulnerabilidad, clasificación de criticidad (CVSS), impacto potencial y recomendaciones específicas
            de remediación paso a paso.
          </p>
        </div>
      </div>

      <div class="bg-gradient-to-r from-[#0f172a] to-[#1e293b] rounded-2xl p-8 text-white">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div>
            <h3 class="text-2xl font-bold mb-4">Nuestro Proceso de Pentesting</h3>
            <ol class="space-y-3 text-sm">
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-6 h-6 bg-[#dc2626] rounded-full flex items-center justify-center text-xs font-bold">1</span>
                <span><strong>Reconocimiento:</strong> Recopilación de información publica (OSINT)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-6 h-6 bg-[#dc2626] rounded-full flex items-center justify-center text-xs font-bold">2</span>
                <span><strong>Escaneo:</strong> Identificación de puertos, servicios y tecnologias</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-6 h-6 bg-[#dc2626] rounded-full flex items-center justify-center text-xs font-bold">3</span>
                <span><strong>Enumeración:</strong> Análisis profundo de sistemas expuestos</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-6 h-6 bg-[#dc2626] rounded-full flex items-center justify-center text-xs font-bold">4</span>
                <span><strong>Explotación:</strong> Intento controlado de acceso no autorizado</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-6 h-6 bg-[#dc2626] rounded-full flex items-center justify-center text-xs font-bold">5</span>
                <span><strong>Post-explotación:</strong> Evaluación del impacto real</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-6 h-6 bg-[#dc2626] rounded-full flex items-center justify-center text-xs font-bold">6</span>
                <span><strong>Reporting:</strong> Entrega de informe ejecutivo y técnico</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-6 h-6 bg-[#dc2626] rounded-full flex items-center justify-center text-xs font-bold">7</span>
                <span><strong>Remediación:</strong> Asistencia en corrección de vulnerabilidades</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex-shrink-0 w-6 h-6 bg-[#dc2626] rounded-full flex items-center justify-center text-xs font-bold">8</span>
                <span><strong>Re-test:</strong> Verificación de que las correcciones fueron efectivas</span>
              </li>
            </ol>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
            <h4 class="font-bold text-lg mb-4">Frameworks que Seguimos</h4>
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <div class="w-2 h-2 bg-[#60a5fa] rounded-full"></div>
                <span class="text-sm">OWASP Testing Guide v4.2</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-2 h-2 bg-[#60a5fa] rounded-full"></div>
                <span class="text-sm">PTES (Penetration Testing Execution Standard)</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-2 h-2 bg-[#60a5fa] rounded-full"></div>
                <span class="text-sm">NIST SP 800-115</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-2 h-2 bg-[#60a5fa] rounded-full"></div>
                <span class="text-sm">OSSTMM (Open Source Security Testing)</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-2 h-2 bg-[#60a5fa] rounded-full"></div>
                <span class="text-sm">MITRE ATT&amp;CK Framework</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tipos de Auditorias -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16">

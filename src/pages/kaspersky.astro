---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import { seoData, BASE_URL } from '@data/seo';

const seo = seoData.kaspersky;

const KSP_SECTORS = [
  { sector: 'Banca y servicios financieros', need: 'Cumplir la Circular Externa 007 de la Superfinanciera y frenar ransomware dirigido.', how: 'System Watcher con rollback automatico, EDR y cifrado de equipos, con reporteria para auditoria.' },
  { sector: 'Salud y EPS', need: 'Proteger historias clinicas bajo la Ley 1581 de Habeas Data.', how: 'Anti-ransomware con reversion de cambios y Encryption Management en estaciones clinicas.' },
  { sector: 'Gobierno y entidades territoriales', need: 'Alinear con el MSPI de MinTIC y resistir amenazas dirigidas.', how: 'XDR Optimum con telemetria correlacionada y MXDR Optimum para el monitoreo 24/7 que la entidad no cubre.' },
  { sector: 'Manufactura y retail', need: 'Proteger sedes distribuidas sin equipo de TI en cada ciudad.', how: 'Consola cloud unica y Adaptive Anomaly Control para frenar comportamientos anomalos en cada sede.' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Distribuidor corporativo Kaspersky Colombia',
  serviceType: 'Kaspersky Business Distributor and Endpoint Security Implementation Service',
  provider: {
    '@type': 'Organization',
    name: 'Starsolution S.A.S.',
    url: BASE_URL,
    telephone: '+573007010017',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Calle 52 A # 22 - 16',
      addressLocality: 'Bogota',
      addressCountry: 'CO',
    },
  },
  areaServed: { '@type': 'Country', name: 'Colombia' },
  url: `${BASE_URL}/kaspersky/`,
  audience: { '@type': 'BusinessAudience', audienceType: 'Empresas en Colombia' },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'COP',
  },
};
---

<BaseLayout seo={seo}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <Navbar />

  <div class="bg-white min-h-screen font-['Instrument_Sans',sans-serif]">

    <!-- Hero Section -->
    <section class="bg-[#111827] relative overflow-hidden">
      <div class="absolute bg-[rgba(237,28,36,0.05)] blur-[60px] right-0 rounded-full w-[800px] h-[800px] top-0"></div>
      <div class="absolute bg-[rgba(30,58,138,0.1)] blur-[50px] bottom-0 left-0 rounded-full w-[600px] h-[600px]"></div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 lg:py-48">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <!-- Left Content -->
          <div class="max-w-xl">
            <span class="inline-block bg-red-500/15 text-red-200 text-xs font-semibold px-3 py-1.5 rounded-full uppercase tracking-wider mb-6 border border-red-500/30">
              Partner autorizado y distribuidor corporativo · Bogota, Colombia
            </span>

            <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold leading-tight mb-8">
              <span class="text-white">Distribuidor corporativo</span>
              <br />
              <span class="bg-clip-text bg-gradient-to-r from-[#ed1c24] to-[#dc2626]" style="--webkit-text-fill-color: transparent; -webkit-text-fill-color: transparent;">
                Kaspersky
              </span>
              <br />
              <span class="text-white">Colombia</span>
            </h1>

            <p class="text-lg text-[#94a3b8] mb-8">
              Como distribuidor corporativo Kaspersky en Colombia, cotizamos licencias <span class="font-medium text-white">Kaspersky Next</span>, renovaciones y ampliaciones para empresas. Implementamos EDR, XDR y MXDR con consola en la nube, integracion con Active Directory y soporte en espanol desde Bogota.
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/contacto/" class="bg-white text-[#111827] font-semibold px-8 py-4 rounded shadow-xl hover:bg-gray-100 transition flex items-center justify-center gap-2 focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">
                Cotizar Kaspersky
                <svg class="w-4 h-4" fill="none" viewBox="0 0 16 16">
                  <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.33333" />
                </svg>
              </a>
              <a href="#planes" class="border border-[#334155] text-white font-semibold px-8 py-4 rounded hover:bg-white/10 transition inline-block text-center focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">
                Ver planes Kaspersky Next
              </a>
            </div>
          </div>

          <!-- Right Content - Floating Cards -->
          <div class="relative h-[500px] hidden lg:block">
            <img
              src="/assets/icono-escudo-proteccion-activa.webp"
              alt="Escudo de protección activa Kaspersky para seguridad empresarial"
              class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 object-contain opacity-15"
              width="256"
              height="256"
              loading="lazy"
            />
            <!-- System Watcher Card - Top Right -->
            <div class="absolute right-10 top-10 bg-[#1f2937] border border-[#334155] rounded-2xl shadow-2xl w-64 p-6">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-2 h-2 bg-red-700 rounded-full"></div>
                <span class="text-[#94a3b8] text-xs uppercase tracking-wider">System Watcher</span>
              </div>
              <p class="text-white text-sm font-medium mb-4">Cryptolocker Revertido</p>
              <div class="bg-[#334155] rounded-full h-1 overflow-hidden">
                <div class="bg-red-700 h-full w-full"></div>
              </div>
            </div>

            <!-- KSN Network Card - Bottom Left -->
            <div class="absolute left-10 bottom-20 bg-white rounded-2xl shadow-lg border border-[rgba(255,255,255,0.1)] p-6 w-72">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                  <div class="bg-[#fef2f2] rounded p-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 16 16">
                      <path d="M8 1v14M1 8h14" stroke="#ED1C24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.33333" />
                    </svg>
                  </div>
                  <span class="font-bold text-sm text-[#111827]">KSN Network</span>
                </div>
                <div class="bg-[#f0fdf4] px-2 py-1 rounded">
                  <span class="text-[#16a34a] text-xs font-medium">PROTEGIDO</span>
                </div>
              </div>
              <p class="text-[#64748b] text-xs leading-relaxed">
                HuMachine Intelligence detecto amenaza de dia cero en archivo adjunto.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ¿Que es? · Bloque definicional para AI/GEO -->
    <section class="bg-white pt-14 sm:pt-16" aria-labelledby="que-es-kaspersky">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="que-es-kaspersky" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">
          ¿Que es Kaspersky Next?
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed">
          Kaspersky Next es la linea de ciberseguridad empresarial de Kaspersky, organizada en seis ediciones escalables (de EDR Foundations a XDR Expert) que combinan proteccion de endpoints con IA, EDR, XDR y deteccion y respuesta gestionada (MDR). Las empresas la usan para detener ransomware con System Watcher y su rollback automatico, investigar incidentes y responder desde una sola consola, en equipos Windows, macOS, Linux, servidores y moviles. En Colombia, Starsolution la implementa como partner autorizado y distribuidor corporativo Kaspersky, con soporte local en espanol y politicas alineadas con la Ley 1581 de Habeas Data e ISO 27001.
        </p>
      </div>
    </section>

    <!-- Distribuidor corporativo Kaspersky Colombia -->
    <section class="bg-white py-14 border-b border-gray-100" aria-labelledby="distribuidor-corporativo-kaspersky-colombia">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-[0.95fr_1.25fr] gap-10 lg:gap-14 items-start">
          <div>
            <span class="text-red-700 text-xs font-semibold uppercase tracking-wider">Distribuidor corporativo Kaspersky Colombia</span>
            <h2 id="distribuidor-corporativo-kaspersky-colombia" class="text-3xl sm:text-4xl font-bold mt-3 mb-5 text-gray-900">
              Licencias Kaspersky Next para empresas, renovacion y soporte local
            </h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-6">
              Si busca un distribuidor corporativo Kaspersky Colombia, Starsolution dimensiona la solucion segun endpoints, servidores, sedes, usuarios moviles y nivel de respuesta requerido. Cubrimos licenciamiento nuevo, renovaciones, ampliaciones, implementacion administrada y acompanamiento tecnico para equipos de TI.
            </p>
            <a href="/contacto/" class="inline-flex items-center justify-center bg-red-700 text-white font-semibold px-6 py-3 rounded hover:bg-[#dc2626] transition focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">
              Cotizar con distribuidor Kaspersky
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            <article class="bg-gray-50 border border-gray-200 rounded-xl p-5">
              <h3 class="font-semibold text-gray-900 mb-2">Licenciamiento B2B</h3>
              <p class="text-sm text-gray-600 leading-relaxed">Cotizacion de Kaspersky Next, EDR, XDR y MXDR para empresas, renovaciones y contratos multianuales.</p>
            </article>
            <article class="bg-gray-50 border border-gray-200 rounded-xl p-5">
              <h3 class="font-semibold text-gray-900 mb-2">Implementacion tecnica</h3>
              <p class="text-sm text-gray-600 leading-relaxed">Configuramos consola cloud, Active Directory, politicas por grupos, GPO, paquetes remotos y despliegue por fases.</p>
            </article>
            <article class="bg-gray-50 border border-gray-200 rounded-xl p-5">
              <h3 class="font-semibold text-gray-900 mb-2">Soporte en Colombia</h3>
              <p class="text-sm text-gray-600 leading-relaxed">Mesa tecnica en espanol, reportes para direccion, ajuste de politicas y escalamiento con fabricante cuando aplica.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- Kaspersky Next Section -->
    <section class="bg-[#f9fafb] py-16 sm:py-20 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16">
          <h2 class="text-4xl sm:text-5xl font-semibold mb-6">
            Kaspersky Next
            <br />
            <span class="text-red-700">Seguridad Simplificada</span>
          </h2>
          <p class="text-lg text-[#64748b] max-w-3xl">
            Gestión centralizada en la nube. Un solo agente ligero. Control total sobre endpoints, móviles y servidores con la tecnología anti-malware más probada y premiada de la industria.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <!-- System Watcher Card -->
          <div class="lg:col-span-4 bg-white border border-[#e2e8f0] rounded-2xl shadow-sm p-8">
            <div class="bg-[#f8fafc] rounded-lg w-10 h-10 flex items-center justify-center mb-8">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M10 2v16M2 10h16" stroke="#334155" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-xl font-medium mb-4 text-[#111827]">System Watcher</h3>
            <p class="text-[#64748b]">
              Tecnología patentada que detecta ransomware, detiene el ataque y revierte automáticamente los cambios maliciosos.
            </p>
          </div>

          <!-- Prevencion de Intrusos Card -->
          <div class="lg:col-span-4 bg-white border border-[#e2e8f0] rounded-2xl shadow-sm p-8">
            <div class="bg-[#f8fafc] rounded-lg w-10 h-10 flex items-center justify-center mb-8">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M1.66667 10H18.3333" stroke="#334155" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
                <circle cx="10" cy="10" r="8" stroke="#334155" stroke-width="1.66667" fill="none" />
              </svg>
            </div>
            <h3 class="text-xl font-medium mb-4 text-[#111827]">Prevención de Intrusos</h3>
            <p class="text-[#64748b]">
              Sistema de Prevención de Intrusiones (HIPS) y Firewall avanzado para bloquear ataques de red y exploits.
            </p>
          </div>

          <!-- HuMachine Intelligence Card - Large -->
          <div class="lg:col-span-8 bg-[#111827] border border-[#1e293b] rounded-2xl p-8 relative overflow-hidden">
            <div class="absolute bg-[rgba(237,28,36,0.1)] blur-[32px] right-[-63px] rounded-full w-64 h-64 top-[-63px]"></div>

            <div class="relative">
              <div class="bg-[rgba(127,29,29,0.3)] border border-[rgba(127,29,29,0.5)] inline-block px-2 py-1 rounded mb-6">
                <span class="text-[#fecaca] text-xs font-medium tracking-wider uppercase">
                  HuMachine Intelligence
                </span>
              </div>

              <h3 class="text-2xl font-medium text-white mb-4">Inteligencia Artificial Hibrida</h3>
              <p class="text-[#94a3b8] mb-12 max-w-lg">
                Kaspersky combina Big Data, Machine Learning y la experiencia humana de sus analistas globales (GReAT) para detectar amenazas que otros pasan por alto.
              </p>

              <div class="border-t border-[#1e293b] pt-8 grid grid-cols-2 gap-8">
                <div>
                  <div class="text-2xl font-bold text-red-700 mb-1">Top 1</div>
                  <div class="text-[#64748b] text-xs uppercase tracking-wider">Pruebas Independientes</div>
                </div>
                <div>
                  <div class="text-2xl font-bold text-red-700 mb-1">400M+</div>
                  <div class="text-[#64748b] text-xs uppercase tracking-wider">Usuarios Protegidos</div>
                </div>
              </div>
            </div>
          </div>

          <!-- EDR Optimum Card -->
          <div class="lg:col-span-4 bg-white border border-[#e2e8f0] rounded-2xl shadow-sm p-8 flex flex-col justify-between">
            <div>
              <h3 class="text-xl font-medium mb-4 text-[#111827]">Kaspersky Next EDR Optimum</h3>
              <p class="text-[#64748b]">
                Visibilidad de causa raíz, análisis en Cloud Sandbox y Adaptive Anomaly Control sin tener que contratar un analista SOC adicional. Disponible también en variante XDR y MXDR (Managed XDR) gestionada por el SOC global de Kaspersky.
              </p>
            </div>
            <a href="/contacto/" class="bg-[rgba(237,28,36,0.1)] text-red-700 text-xs font-bold uppercase px-6 py-3 rounded mt-6 hover:bg-[rgba(237,28,36,0.2)] transition inline-block text-center">
              Ver EDR
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparativa Kaspersky Next Tiers -->
    <section id="planes" class="py-16 sm:py-20 lg:py-24 bg-white scroll-mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Como elegir tu edicion de Kaspersky Next</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Kaspersky reemplazo la antigua linea Cloud (Standard / Plus / Select) por <strong>Kaspersky Next</strong>, con seis ediciones. Esta comparativa cubre los cuatro niveles pensados para empresas sin SOC interno (EDR Foundations, EDR Optimum, XDR Optimum y MXDR Optimum); para SOC enterprise existen ademas EDR Expert y XDR Expert. Esta es la guia rapida para empresas colombianas.
          </p>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-sm">
          <table class="w-full text-sm text-left text-gray-700 min-w-[820px]">
            <caption class="sr-only">Comparativa de los cuatro niveles de Kaspersky Next para empresas sin SOC interno: EDR Foundations, EDR Optimum, XDR Optimum y MXDR Optimum, con caracteristicas incluidas en cada tier. Kaspersky Next incluye ademas las ediciones enterprise EDR Expert y XDR Expert.</caption>
            <thead class="bg-gray-50 text-gray-900">
              <tr>
                <th scope="col" class="px-4 sm:px-6 py-4 font-semibold">Caracteristica</th>
                <th scope="col" class="px-4 sm:px-6 py-4 font-semibold">
                  <span class="block text-base">EDR Foundations</span>
                  <span class="block text-xs font-normal text-gray-500 mt-1">Empresas 10-100 endpoints</span>
                </th>
                <th scope="col" class="px-4 sm:px-6 py-4 font-semibold bg-red-50">
                  <span class="block text-base text-[#ed1c24]">EDR Optimum</span>
                  <span class="block text-xs font-normal text-gray-500 mt-1">100-500 endpoints · Mas popular</span>
                </th>
                <th scope="col" class="px-4 sm:px-6 py-4 font-semibold">
                  <span class="block text-base">XDR Optimum</span>
                  <span class="block text-xs font-normal text-gray-500 mt-1">500-2.000 endpoints</span>
                </th>
                <th scope="col" class="px-4 sm:px-6 py-4 font-semibold">
                  <span class="block text-base">MXDR Optimum</span>
                  <span class="block text-xs font-normal text-gray-500 mt-1">SOC gestionado por Kaspersky</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <tr><th scope="row" class="px-4 sm:px-6 py-3 font-medium text-gray-900 text-left">Antimalware multicapa + ML</th><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600 bg-red-50/40">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td></tr>
              <tr><th scope="row" class="px-4 sm:px-6 py-3 font-medium text-gray-900 text-left">System Watcher (anti-ransomware con rollback)</th><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600 bg-red-50/40">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td></tr>
              <tr><th scope="row" class="px-4 sm:px-6 py-3 font-medium text-gray-900 text-left">Firewall + HIPS + control web</th><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600 bg-red-50/40">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td></tr>
              <tr><th scope="row" class="px-4 sm:px-6 py-3 font-medium text-gray-900 text-left">EDR esencial (causa raiz, IOC scan)</th><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600 bg-red-50/40">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td></tr>
              <tr><th scope="row" class="px-4 sm:px-6 py-3 font-medium text-gray-900 text-left">Cloud Sandbox + Adaptive Anomaly Control</th><td class="px-4 sm:px-6 py-3 text-gray-300">No</td><td class="px-4 sm:px-6 py-3 text-emerald-600 bg-red-50/40">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td></tr>
              <tr><th scope="row" class="px-4 sm:px-6 py-3 font-medium text-gray-900 text-left">Cifrado de datos + Vulnerability &amp; Patch Mgmt</th><td class="px-4 sm:px-6 py-3 text-gray-300">No</td><td class="px-4 sm:px-6 py-3 text-emerald-600 bg-red-50/40">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td></tr>
              <tr><th scope="row" class="px-4 sm:px-6 py-3 font-medium text-gray-900 text-left">Mobile Device Management (Android / iOS)</th><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600 bg-red-50/40">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td></tr>
              <tr><th scope="row" class="px-4 sm:px-6 py-3 font-medium text-gray-900 text-left">XDR: telemetria correlacionada (red, mail, identidad)</th><td class="px-4 sm:px-6 py-3 text-gray-300">No</td><td class="px-4 sm:px-6 py-3 text-gray-300 bg-red-50/40">No</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td></tr>
              <tr><th scope="row" class="px-4 sm:px-6 py-3 font-medium text-gray-900 text-left">Threat hunting</th><td class="px-4 sm:px-6 py-3 text-gray-300">No</td><td class="px-4 sm:px-6 py-3 text-gray-300 bg-red-50/40">No</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td></tr>
              <tr><th scope="row" class="px-4 sm:px-6 py-3 font-medium text-gray-900 text-left">SOC 24x7 gestionado por Kaspersky (MXDR)</th><td class="px-4 sm:px-6 py-3 text-gray-300">No</td><td class="px-4 sm:px-6 py-3 text-gray-300 bg-red-50/40">No</td><td class="px-4 sm:px-6 py-3 text-gray-300">No</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td></tr>
              <tr><th scope="row" class="px-4 sm:px-6 py-3 font-medium text-gray-900 text-left">Soporte e implementacion local Starsolution (Bogota)</th><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600 bg-red-50/40">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td><td class="px-4 sm:px-6 py-3 text-emerald-600">Si</td></tr>
              <tr class="bg-gray-50">

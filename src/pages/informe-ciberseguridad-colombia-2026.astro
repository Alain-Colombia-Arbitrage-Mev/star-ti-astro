---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import { seoData } from '@data/seo';
import { INFORME_SOURCES, informeFaqs } from '@data/informe2026';

const seo = seoData['informe-ciberseguridad-colombia-2026'];
---

<BaseLayout seo={seo}>
  <Navbar />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-gray-950 via-slate-900 to-gray-900 pt-24 sm:pt-32 pb-20">
    <!-- Grid decorativo -->
    <div class="absolute inset-0 pointer-events-none opacity-5">
      <div class="absolute inset-0" style="background-image: linear-gradient(to right, #6b7280 1px, transparent 1px), linear-gradient(to bottom, #6b7280 1px, transparent 1px); background-size: 50px 50px;"></div>
    </div>
    <!-- Glow effects -->
    <div class="absolute top-16 right-1/4 w-[600px] h-[600px] bg-red-600/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-1/4 w-[400px] h-[400px] bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-8 flex items-center gap-2 text-sm text-gray-400">
        <a href="/" class="hover:text-white transition">Inicio</a>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="text-gray-300">Informe 2026</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Content -->
        <div>
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 bg-red-500/10 border border-red-500/30 rounded-full px-4 py-2 mb-6">
            <span class="h-2 w-2 rounded-full bg-red-500 animate-pulse"></span>
            <span class="text-red-400 text-sm font-semibold">Edición 2026 &bull; Fuentes Públicas + Experiencia en Campo</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Informe de<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-orange-400">Ciberseguridad</span><br />
            Empresarial<br />
            Colombia 2026
          </h1>

          <p class="text-lg sm:text-xl text-gray-300 mb-8 leading-relaxed">
            Un análisis del panorama de amenazas cibernéticas en Colombia a partir de fuentes públicas y de la experiencia de nuestro equipo con más de 1.150 empresas atendidas: tendencias de ransomware, costos de brechas y recomendaciones accionables para proteger su organización.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/contacto/?utm_source=informe&utm_medium=cta-hero&utm_campaign=informe-2026"
              class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white font-semibold px-8 py-4 rounded-xl transition shadow-xl shadow-red-900/30"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              Solicitar diagnóstico gratuito
            </a>
            <a
              href="#hallazgos"
              class="inline-flex items-center justify-center gap-2 bg-white/10 border border-white/20 text-white font-semibold px-8 py-4 rounded-xl hover:bg-white/20 transition"
            >
              Ver Hallazgos Clave
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </a>
          </div>

          <!-- Meta badges -->
          <div class="mt-8 flex flex-wrap gap-4 text-sm">
            <div class="flex items-center gap-2 text-gray-400">
              <svg class="w-4 h-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Acceso gratuito
            </div>
            <div class="flex items-center gap-2 text-gray-400">
              <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              Actualizado: octubre 2026
            </div>
            <div class="flex items-center gap-2 text-gray-400">
              <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
              Cada cifra con su fuente
            </div>
            <div class="flex items-center gap-2 text-gray-400">
              <svg class="w-4 h-4 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
              Citable y libre de uso
            </div>
          </div>
        </div>

        <!-- Right: Visual summary card -->
        <div class="relative">
          <div class="bg-white/5 border border-white/10 rounded-3xl p-8 backdrop-blur-sm">
            <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-6">Resumen Ejecutivo</p>
            <div class="space-y-5">
              <div class="flex items-start gap-4">
                <div class="bg-red-500/20 rounded-xl p-3 flex-shrink-0">
                  <svg class="w-6 h-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                </div>
                <div>
                  <div class="text-2xl font-bold text-white">62.299</div>
                  <div class="text-sm text-gray-400">denuncias por delitos informáticos en Colombia en 2025 (Policía Nacional)</div>
                </div>
              </div>
              <div class="border-t border-white/5"></div>
              <div class="flex items-start gap-4">
                <div class="bg-orange-500/20 rounded-xl p-3 flex-shrink-0">
                  <svg class="w-6 h-6 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                  <div class="text-2xl font-bold text-white">USD 4,99 M</div>
                  <div class="text-sm text-gray-400">costo promedio mundial de una brecha de datos (IBM 2026)</div>
                </div>
              </div>
              <div class="border-t border-white/5"></div>
              <div class="flex items-start gap-4">
                <div class="bg-yellow-500/20 rounded-xl p-3 flex-shrink-0">
                  <svg class="w-6 h-6 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </div>
                <div>
                  <div class="text-2xl font-bold text-white">+35%</div>
                  <div class="text-sm text-gray-400">denuncias en el primer semestre de 2026 frente a 2025 (Policía Nacional)</div>
                </div>
              </div>
              <div class="border-t border-white/5"></div>
              <div class="flex items-start gap-4">
                <div class="bg-blue-500/20 rounded-xl p-3 flex-shrink-0">
                  <svg class="w-6 h-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                </div>
                <div>
                  <div class="text-2xl font-bold text-white">31%</div>
                  <div class="text-sm text-gray-400">de brechas empezaron explotando una vulnerabilidad (Verizon DBIR 2026)</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Hero Image -->
          <div class="mt-6 flex items-center justify-center">
            <img src="/assets/robot-ia-laboratorio-monitores.webp" alt="Informe de ciberseguridad empresarial Colombia 2026 - análisis de amenazas" class="w-full max-w-xs rounded-2xl shadow-xl" width="320" height="320" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Findings Section -->
  <section id="hallazgos" class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="text-red-600 text-sm font-bold uppercase tracking-widest">Hallazgos Clave 2025-2026</span>
        <h2 class="text-4xl sm:text-5xl font-bold mt-3 mb-4 text-gray-900">Los números que debe conocer</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">Datos públicos de la Policía Nacional, IBM, Verizon y el FBI. Cada cifra indica su fuente.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Stat 1 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm hover:shadow-md transition group">
          <div class="flex items-start gap-5">
            <div class="bg-red-100 rounded-2xl p-4 flex-shrink-0 group-hover:bg-red-600 transition">
              <svg class="w-8 h-8 text-red-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </div>
            <div>
              <div class="text-5xl font-black text-red-600 mb-2">62.299</div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Denuncias por delitos informáticos en 2025</h3>
              <p class="text-gray-600">La Policía Nacional registró 62.299 denuncias por delitos informáticos en Colombia durante 2025. El hurto por medios informáticos, el acceso abusivo a sistemas y la violación de datos personales concentraron el 88 % de los casos. Son solo los casos denunciados: muchas empresas no denuncian.</p>
              <p class="text-xs text-gray-400 mt-3">Fuente: Policía Nacional – DIJIN, balance 2025.</p>
            </div>
          </div>
        </div>

        <!-- Stat 2 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm hover:shadow-md transition group">
          <div class="flex items-start gap-5">
            <div class="bg-orange-100 rounded-2xl p-4 flex-shrink-0 group-hover:bg-orange-600 transition">
              <svg class="w-8 h-8 text-orange-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <div class="text-5xl font-black text-orange-600 mb-2">USD 4,99 M</div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Costo promedio de una brecha</h3>
              <p class="text-gray-600">El costo promedio mundial de una brecha de datos llegó a USD 4,99 millones, un récord. Incluye detección, respuesta, notificación y pérdida de negocio. En Colombia hay que sumar el riesgo de sanciones de la SIC por datos personales expuestos.</p>
              <p class="text-xs text-gray-400 mt-3">Fuente: IBM, Cost of a Data Breach Report 2026.</p>
            </div>
          </div>
        </div>

        <!-- Stat 3 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm hover:shadow-md transition group">
          <div class="flex items-start gap-5">
            <div class="bg-yellow-100 rounded-2xl p-4 flex-shrink-0 group-hover:bg-yellow-500 transition">
              <svg class="w-8 h-8 text-yellow-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </div>
            <div>
              <div class="text-5xl font-black text-yellow-600 mb-2">62%</div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Brechas con factor humano</h3>
              <p class="text-gray-600">El 62 % de las brechas analizadas involucró el factor humano: errores, engaños como el phishing o credenciales robadas. En Colombia es común que los correos fraudulentos suplanten a entidades como la DIAN o a bancos para ganar credibilidad.</p>
              <p class="text-xs text-gray-400 mt-3">Fuente: Verizon, Data Breach Investigations Report 2026.</p>
            </div>
          </div>
        </div>

        <!-- Stat 4 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm hover:shadow-md transition group">
          <div class="flex items-start gap-5">
            <div class="bg-blue-100 rounded-2xl p-4 flex-shrink-0 group-hover:bg-blue-600 transition">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
            </div>
            <div>
              <div class="text-5xl font-black text-blue-600 mb-2">31%</div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">Brechas que empezaron por una vulnerabilidad</h3>
              <p class="text-gray-600">Por primera vez en la historia del informe de Verizon, explotar una vulnerabilidad superó al robo de credenciales como la forma más común de entrar: 31 % de las brechas. Mantener los sistemas actualizados y hacer pruebas de penetración ya no es opcional.</p>
              <p class="text-xs text-gray-400 mt-3">Fuente: Verizon, Data Breach Investigations Report 2026.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Additional stats row -->
      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl p-5 border border-gray-200 text-center">
          <div class="text-3xl font-black text-gray-900 mb-1">247 días</div>
          <div class="text-sm text-gray-500">Para identificar y contener una brecha (IBM 2026)</div>
        </div>
        <div class="bg-white rounded-xl p-5 border border-gray-200 text-center">
          <div class="text-3xl font-black text-gray-900 mb-1">48%</div>
          <div class="text-sm text-gray-500">De brechas incluyeron ransomware (Verizon DBIR 2026)</div>
        </div>
        <div class="bg-white rounded-xl p-5 border border-gray-200 text-center">
          <div class="text-3xl font-black text-gray-900 mb-1">48%</div>
          <div class="text-sm text-gray-500">De brechas involucraron a un tercero o proveedor (Verizon DBIR 2026)</div>
        </div>
        <div class="bg-white rounded-xl p-5 border border-gray-200 text-center">
          <div class="text-3xl font-black text-gray-900 mb-1">USD 3.046 M</div>
          <div class="text-sm text-gray-500">Pérdidas reportadas por fraude BEC en 2025 (FBI IC3)</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sectores Más Atacados -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <span class="text-red-600 text-sm font-bold uppercase tracking-widest">Casos públicos en Colombia</span>
          <h2 class="text-4xl font-bold mt-3 mb-4 text-gray-900">Cuando el ataque llega por un proveedor</h2>
          <p class="text-lg text-gray-600 mb-6">En septiembre de 2023, un ransomware contra el proveedor de servicios en la nube IFX Networks afectó portales y servicios de entidades públicas como el Ministerio de Salud, la Superintendencia de Salud y el Consejo Superior de la Judicatura. La Rama Judicial tuvo que suspender términos judiciales en todo el país del 14 al 20 de septiembre.</p>
          <p class="text-gray-600 mb-6">El Gobierno aclaró que el ataque fue contra el proveedor y no contra las entidades. Esa es justamente la lección: la seguridad de su empresa también depende de la de sus proveedores. El informe 2026 de Verizon confirma la tendencia: casi la mitad de las brechas involucró a un tercero.</p>
          <p class="text-xs text-gray-400 mb-6">Fuentes: MinTIC, comunicado de septiembre de 2023; Verizon DBIR 2026.</p>
          <a href="/hacking-etico/" class="inline-flex items-center gap-2 text-red-600 font-semibold hover:text-red-700 transition">
            Evalúe su exposición con hacking ético
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>

        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Lo que vemos en campo</h3>
          <p class="text-sm text-gray-500 mb-5">Observaciones cualitativas de nuestro equipo en proyectos con empresas y entidades públicas. No son estadísticas.</p>
          <ul class="space-y-4 text-gray-700">
            <li class="flex gap-3"><span class="text-red-600 font-bold">&bull;</span><span>Antivirus instalado, pero sin nadie que revise las alertas de la consola.</span></li>
            <li class="flex gap-3"><span class="text-red-600 font-bold">&bull;</span><span>Dominios de correo sin SPF, DKIM o DMARC bien configurados, fáciles de suplantar.</span></li>
            <li class="flex gap-3"><span class="text-red-600 font-bold">&bull;</span><span>Copias de seguridad que nunca se han probado restaurando.</span></li>
            <li class="flex gap-3"><span class="text-red-600 font-bold">&bull;</span><span>Cuentas de exempleados y contratistas que siguen activas.</span></li>
            <li class="flex gap-3"><span class="text-red-600 font-bold">&bull;</span><span>Proveedores con acceso remoto permanente y sin control.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Top 5 Amenazas -->
  <section class="py-20 bg-gray-950 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="text-red-400 text-sm font-bold uppercase tracking-widest">Panorama de Amenazas</span>
        <h2 class="text-4xl sm:text-5xl font-bold mt-3 mb-4">Top 5 Amenazas en Colombia 2026</h2>
        <p class="text-xl text-gray-400 max-w-3xl mx-auto">Las amenazas que más vemos en empresas colombianas, con datos de fuentes públicas internacionales.</p>
      </div>

      <div class="space-y-8">
        <!-- Amenaza 1: Ransomware-as-a-Service -->
        <div class="bg-white/5 border border-white/10 rounded-2xl p-8">
          <div class="flex items-start gap-6">
            <div class="flex-shrink-0">
              <div class="w-14 h-14 bg-red-500/20 rounded-2xl flex items-center justify-center">
                <span class="text-2xl font-black text-red-400">#1</span>
              </div>
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <h3 class="text-2xl font-bold">Ransomware-as-a-Service (RaaS)</h3>
                <span class="bg-red-500/20 text-red-400 text-xs font-bold px-3 py-1 rounded-full">CRÍTICO</span>
                <span class="bg-white/10 text-gray-300 text-xs px-3 py-1 rounded-full">Doble extorsión &bull; Afiliados</span>
              </div>
              <p class="text-gray-300 mb-4 leading-relaxed">El modelo Ransomware-as-a-Service democratizó el cibercrimen: los grupos desarrollan el malware y lo "alquilan" a afiliados, que hacen el ataque y comparten el rescate. Así, atacantes sin grandes conocimientos técnicos pueden paralizar una empresa.</p>
              <p class="text-gray-400 mb-4 leading-relaxed">Según el informe 2026 de Verizon, el ransomware estuvo presente en el 48 % de las brechas, y el 69 % de las víctimas no pagó el rescate. Pagar no garantiza recuperar la información; tener copias de seguridad aisladas y probadas, sí.</p>
              <p class="text-gray-400 leading-relaxed">La doble extorsión —cifrar y además robar los datos para amenazar con publicarlos— es hoy una práctica habitual. En Colombia, eso suma el riesgo de sanciones de la SIC por exposición de datos personales bajo la Ley 1581.</p>

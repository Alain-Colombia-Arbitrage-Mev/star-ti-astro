---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import { seoData } from '@data/seo';

const seo = seoData['portafolio'];
const pdf = '/descargas/portafolio-star-solutions-ti.pdf';

const pillars = [
  { name: 'Star Protection', title: 'Defensa activa', text: 'Endpoints, correo, backup y factor humano.', brands: 'Bitdefender · Kaspersky · Hornetsecurity · Proofpoint · Acronis · Kymatio', color: 'border-red-500', dot: 'bg-red-500', href: '/#star-protection' },
  { name: 'Star Inspection', title: 'Visibilidad y riesgo', text: 'Vulnerabilidades, superficie de ataque externa y pentesting.', brands: 'Vicarius · Enthec · Hacking ético', color: 'border-blue-500', dot: 'bg-blue-500', href: '/hacking-etico/' },
  { name: 'Star Compliance', title: 'Normativa y gobierno', text: 'ISO 27001, DLP, auditoría e identidad.', brands: 'ISO 27001 · SealPath · Netwrix · LastPass', color: 'border-emerald-500', dot: 'bg-emerald-500', href: '/iso-27001/' },
  { name: 'Star SOC', title: 'Monitoreo y respuesta 24x7', text: 'Centro de operaciones con IA y analistas, respuesta a incidentes.', brands: 'SOC 24x7 · Stellar Cyber Open XDR', color: 'border-violet-500', dot: 'bg-violet-500', href: '/soc-24x7/' },
];

const previews = [
  ['pagina-04', 'Ecosistema de cuatro pilares'],
  ['pagina-05', 'Star Protection'],
  ['pagina-08', 'Star SOC 24x7'],
  ['pagina-10', 'Seguridad por capas del modelo OSI'],
  ['pagina-12', 'Caso de éxito: 32.000 endpoints'],
];

const contents = ['Quiénes somos y cifras', 'El reto: el costo de una brecha', 'Los cuatro pilares', 'Star Protection', 'Star Inspection', 'Star Compliance', 'Star SOC 24x7', 'Defensa integrada', 'Seguridad por capas del modelo OSI', 'Alianzas tecnológicas', 'Caso de éxito', 'Por qué Star y servicios complementarios', 'Contacto'];
---

<BaseLayout seo={seo}>
  <Navbar />

  <section class="relative overflow-hidden bg-[#070b14]">
    <div class="absolute inset-0 pointer-events-none opacity-[.06]" style="background-image: linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px); background-size: 56px 56px;"></div>
    <div class="absolute -top-40 -right-40 w-[520px] h-[520px] rounded-full bg-orange-500/20 blur-3xl"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-16 lg:pb-24">
      <nav class="mb-8 flex items-center gap-2 text-sm text-gray-400" aria-label="Ruta de navegación">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-gray-200">Portafolio</span>
      </nav>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-flex items-center gap-2 bg-orange-500/10 border border-orange-400/40 text-orange-200 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wide mb-6">
            <span class="w-2 h-2 rounded-full bg-red-500"></span> Portafolio de soluciones 2026
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Más que seguridad: <span class="bg-gradient-to-r from-red-500 to-orange-400 bg-clip-text text-transparent">resiliencia empresarial</span>
          </h1>
          <p class="text-xl text-gray-300 mb-8 leading-relaxed">
            Conozca en un solo documento nuestros cuatro pilares, los fabricantes que integramos y cómo protegemos a más de 1.150 empresas en Colombia, Venezuela y Estados Unidos.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={pdf} download class="inline-flex items-center justify-center gap-2 bg-red-700 text-white font-semibold px-6 py-3 rounded hover:bg-[#dc2626] transition">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v12m0 0l-5-5m5 5l5-5M4 20h16" /></svg>
              Descargar portafolio (PDF)
            </a>
            <a href={pdf} target="_blank" rel="noopener" class="inline-flex items-center justify-center border border-white/40 text-white font-semibold px-6 py-3 rounded hover:bg-white/10 transition">Ver en el navegador</a>
          </div>
          <p class="text-sm text-gray-500 mt-4">14 páginas · PDF · 3,5 MB · Actualizado en octubre de 2026</p>
        </div>
        <a href={pdf} target="_blank" rel="noopener" class="block group">
          <img src="/assets/portafolio/pagina-01.webp" alt="Portada del portafolio de soluciones 2026 de Star Solutions TI" width="1056" height="816" class="w-full rounded-2xl border border-white/15 shadow-2xl shadow-black/60 group-hover:scale-[1.01] transition" fetchpriority="high" />
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Cuatro pilares, una sola estrategia</h2>
        <p class="text-lg text-gray-600">Cada pilar cubre una parte del riesgo y todos trabajan coordinados para no dejar puntos ciegos.</p>
      </div>
      <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-5">
        {pillars.map((p) => (
          <a href={p.href} class={`block rounded-2xl border border-gray-200 border-t-4 ${p.color} p-6 hover:shadow-lg transition bg-white`}>
            <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-gray-500"><span class={`w-2 h-2 rounded-full ${p.dot}`}></span>{p.name}</p>
            <h3 class="text-xl font-bold text-gray-900 mt-3 mb-2">{p.title}</h3>
            <p class="text-gray-600 text-sm mb-4">{p.text}</p>
            <p class="text-xs text-gray-500 border-t border-gray-100 pt-3">{p.brands}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-[#070b14] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-10">
        <div>
          <h2 class="text-3xl font-bold mb-4">Qué encontrará en el portafolio</h2>
          <ol class="space-y-2 text-gray-300">
            {contents.map((c, i) => (
              <li class="flex gap-3"><span class="text-orange-400 font-bold w-6">{String(i + 2).padStart(2, '0')}</span>{c}</li>
            ))}
          </ol>
          <a href={pdf} download class="mt-8 inline-flex items-center gap-2 bg-red-700 text-white font-semibold px-6 py-3 rounded hover:bg-[#dc2626] transition">Descargar PDF</a>
        </div>
        <div class="lg:col-span-2 grid sm:grid-cols-2 gap-4">
          {previews.map(([file, label]) => (
            <figure>
              <img src={`/assets/portafolio/${file}.webp`} alt={`Página del portafolio: ${label}`} width="1056" height="816" loading="lazy" class="w-full rounded-xl border border-white/10" />
              <figcaption class="text-sm text-gray-400 mt-2">{label}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">¿Prefiere que se lo expliquemos?</h2>
      <p class="text-gray-600 mb-8">Agende un diagnóstico gratuito y le mostramos qué parte del portafolio aplica a su organización.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contacto/" class="bg-[#dc2626] text-white px-8 py-4 rounded-lg font-semibold hover:bg-[#b91c1c] transition">Solicitar diagnóstico gratis</a>
        <a href={pdf} download class="border-2 border-gray-900 text-gray-900 px-8 py-4 rounded-lg font-semibold hover:bg-gray-900 hover:text-white transition">Descargar portafolio</a>
      </div>
    </div>
  </section>

  <Footer />
  <WhatsAppButton />
</BaseLayout>

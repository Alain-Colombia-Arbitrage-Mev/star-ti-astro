---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import ConsultoriaForm from '@components/ConsultoriaForm.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import BrandLogoCard from '@components/BrandLogoCard.astro';
import { seoData } from '@data/seo';
import { kymatioFaqs } from '@data/kymatio';

const seo = seoData.kymatio;

const check = 'M11.6667 3.5L5.25 9.91667L2.33333 7';

const KY_MODULES = [
  {
    title: 'Evaluación y Concienciación Adaptativa',
    desc: 'Mide el nivel de alerta de cada empleado y entrega sesiones cortas, guiadas por un asistente conversacional, adaptadas a su puesto y a sus resultados. Nada de cursos genéricos iguales para todos.',
    icon: 'M10 2a8 8 0 100 16 8 8 0 000-16zM10 6v4m0 4h.01',
  },
  {
    title: 'Simulaciones de Ingeniería Social',
    desc: 'Campañas controladas de phishing, smishing (SMS), vishing (llamadas, incluido vishing con IA) y ransomware que revelan quién cae, en qué área y ante qué tipo de engaño.',
    icon: 'M3 5h14v10H3zM3 5l7 6 7-6',
  },
  {
    title: 'Breach Scan: Credenciales Expuestas',
    desc: 'Vigilancia de contraseñas y cuentas corporativas filtradas en brechas, la web, la deep web y foros privados, con alertas a la organización y al propio empleado para que actúe a tiempo.',
    icon: 'M10 2L3 6v5c0 4.5 3 8.5 7 9.5 4-1 7-5 7-9.5V6l-7-4z',
  },
  {
    title: 'Bienestar Digital',
    desc: 'Detecta señales de agotamiento (burnout), fatiga digital y sobrecarga, factores que bajan la atención y aumentan los errores. Seguridad y bienestar del equipo en la misma estrategia.',
    icon: 'M10 17s-7-4.35-7-9a4 4 0 017-2.65A4 4 0 0117 8c0 4.65-7 9-7 9z',
  },
  {
    title: 'Mapa de Riesgo Humano',
    desc: 'Calcula el riesgo de cada puesto como probabilidad de incidente por impacto potencial, con vistas por persona, departamento y región para priorizar dónde actuar primero.',
    icon: 'M3 17V9m5 8V5m5 12v-6m4 6V3',
  },
  {
    title: 'Reportes de Cumplimiento',
    desc: 'Dashboards e informes exportables con métricas objetivas de confidencialidad, integridad y disponibilidad, listos para auditorías ISO 27001, comités de riesgo y entes de control.',
    icon: 'M6 2h6l4 4v12H6zM12 2v4h4M9 10h4M9 13h4',
  },
];

const KY_CAPABILITIES = [
  { t: 'Visión general del riesgo', d: 'Riesgo humano en tiempo real por roles, departamentos y regiones.' },
  { t: 'Evolución del riesgo', d: 'Tendencias individuales, por área y de toda la organización.' },
  { t: 'Alertas de alto riesgo', d: 'Identifica grupos o puestos críticos y ordena prioridades con criterios objetivos.' },
  { t: 'Informes a la medida', d: 'Exportación de reportes alineados con métricas CID y necesidades regulatorias.' },
  { t: 'Integración con su directorio', d: 'Inicio de sesión SAML 2.0 y aprovisionamiento automático con Microsoft Entra ID (Azure AD).' },
];

const KY_PHASES = [
  { n: '1', t: 'Línea Base', d: 'Medimos el nivel de alerta del equipo y detectamos los primeros focos de riesgo, sin instalar nada en los equipos.' },
  { n: '2', t: 'Mitigación Inicial', d: 'Revisamos credenciales expuestas y mapeamos la exposición por departamentos y puestos para cerrar lo urgente.' },
  { n: '3', t: 'Simulación y Formación', d: 'Lanzamos ataques simulados y activamos la concienciación personalizada según los resultados de cada persona.' },
  { n: '4', t: 'Gestión Continua', d: 'Seguimiento de tendencias, informes ejecutivos y ajuste de prioridades con el acompañamiento de Star Solutions TI.' },
];

const KY_SECTORS = [
  {
    sector: 'Banca y Finanzas',
    need: 'Fraude por suplantación de directivos y robo de credenciales bancarias por phishing, con exigencias de ciberseguridad y riesgo operativo de la Superintendencia Financiera.',
    how: 'Simulaciones periódicas de phishing y vishing para áreas de tesorería y atención al cliente, vigilancia de credenciales expuestas y reportes de riesgo humano para el comité de riesgos.',
  },
  {
    sector: 'Salud',
    need: 'Protección de historias clínicas bajo la Ley 1581 de Habeas Data y personal asistencial con alta carga laboral, más propenso a errores por fatiga.',
    how: 'Concienciación breve y adaptada a turnos, módulo de bienestar digital para detectar sobrecarga y simulaciones de ransomware enfocadas en el personal administrativo.',
  },
  {
    sector: 'Gobierno y Sector Público',
    need: 'Campañas de spear-phishing dirigidas a funcionarios y obligaciones del Modelo de Seguridad y Privacidad de la Información (MSPI) del MinTIC.',
    how: 'Programa de concienciación medible por dependencia, con evidencias exportables para seguimiento del MSPI y priorización de los cargos con mayor exposición.',
  },
  {
    sector: 'Empresas con ISO 27001',
    need: 'El control 6.3 de ISO/IEC 27001:2022 exige concienciación, educación y formación demostrables, y los auditores piden evidencia de efectividad, no solo listas de asistencia.',
    how: 'Kymatio genera métricas de avance por persona y área que sirven como evidencia de auditoría. Star Solutions TI, certificada ISO 27001, lo integra a su sistema de gestión.',
  },
];

const KY_COMPARE = [
  { cap: 'Formato', trad: 'Curso anual igual para todos', ky: 'Sesiones cortas y continuas adaptadas a cada persona' },
  { cap: 'Medición', trad: 'Asistencia y examen final', ky: 'Riesgo por persona, puesto y área (probabilidad × impacto)' },
  { cap: 'Comprobación real', trad: 'Ninguna', ky: 'Simulaciones de phishing, smishing, vishing y ransomware' },
  { cap: 'Credenciales filtradas', trad: 'No las detecta', ky: 'Vigilancia continua con alertas (Breach Scan)' },
  { cap: 'Factor bienestar', trad: 'No se considera', ky: 'Detección de burnout y fatiga digital' },
  { cap: 'Evidencia para auditoría', trad: 'Certificados de asistencia', ky: 'Informes exportables con métricas objetivas' },
];
---

<BaseLayout seo={seo}>
  <Navbar />

  <div class="bg-white min-h-screen font-['Instrument_Sans',sans-serif]">

    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-gray-50 to-white py-12 sm:py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="mb-6">
              <span class="inline-block bg-red-100 text-red-700 text-xs font-medium px-3 py-1 rounded">
                GESTIÓN DEL RIESGO HUMANO (HRM)
              </span>
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
              Kymatio: Convierta a sus Empleados{" "}
              <span class="text-red-700">en su Mejor Defensa.</span>
            </h1>
            <p class="text-lg sm:text-xl text-gray-600 mb-8 max-w-3xl">
              Mida, priorice y reduzca el riesgo de ciberseguridad que generan las personas con una
              plataforma que combina concienciación personalizada, simulaciones de ataque, vigilancia de
              credenciales expuestas y bienestar digital. Star Solutions TI la implementa en Colombia con
              soporte local en español.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="#consultoria" class="bg-gradient-to-r from-red-600 to-red-700 text-white font-semibold px-8 py-4 rounded-full hover:from-red-700 hover:to-red-800 transition shadow-lg inline-flex items-center justify-center gap-2">
                Solicitar Demo
              </a>
              <a href="/contacto/" class="bg-white border-2 border-gray-200 text-gray-800 font-semibold px-8 py-4 rounded-full hover:bg-gray-50 transition inline-flex items-center justify-center gap-2 focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">
                Hablar con un Experto
              </a>
            </div>
            <div class="mt-8 flex items-center gap-2 text-sm text-gray-500">
              <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 14 14">
                <path d={check} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
              </svg>
              <span>Sin instalar software: plataforma SaaS integrada con Microsoft Entra ID</span>
            </div>
          </div>
          <div class="hidden lg:flex items-center justify-center">
            <BrandLogoCard src="/marcas/kymatio.webp" alt="Logo oficial de Kymatio" width={800} height={207} maxWidth="max-w-md" />
          </div>
        </div>
      </div>
    </section>

    <!-- Trust Section -->
    <section class="bg-[#111827] py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
          <div>
            <h3 class="text-white font-bold text-xl mb-2">ENS Categoría Media</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Certificación del Esquema Nacional de Seguridad de España</p>
          </div>
          <div>
            <h3 class="text-white font-bold text-xl mb-2">Catálogo CPSTIC</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Incluida por el Centro Criptológico Nacional (CCN)</p>
          </div>
          <div>
            <h3 class="text-white font-bold text-xl mb-2">4,8 / 5</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Valoración de usuarios en Capterra</p>
          </div>
          <div>
            <h3 class="text-white font-bold text-xl mb-2">Banca, salud y gobierno</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Usada por entidades como Santander, Abanca y Enagás</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ¿Qué es? · Bloque definicional para AI/GEO -->
    <section class="bg-white pt-14 sm:pt-16" aria-labelledby="que-es-kymatio">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="que-es-kymatio" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">¿Qué es Kymatio?</h2>
        <p class="text-lg text-gray-700 leading-relaxed">Kymatio es una plataforma SaaS de gestión del riesgo humano en ciberseguridad (Human Risk Management, HRM), desarrollada en Madrid (España) desde 2017. Mide el nivel de alerta de cada empleado y calcula el riesgo de cada puesto como la probabilidad de un incidente multiplicada por su impacto potencial. Integra en una sola consola cuatro servicios: evaluación y concienciación adaptativa guiada por un asistente conversacional, simulaciones de ingeniería social (phishing, smishing, vishing y ransomware), vigilancia de credenciales corporativas expuestas (Breach Scan) y bienestar digital para detectar agotamiento y fatiga. Las empresas la usan para reducir el error humano, que está detrás de la mayoría de los incidentes, y para demostrar con métricas el cumplimiento de marcos como ISO 27001. Star Solutions TI implementa y acompaña Kymatio en Colombia, con soporte técnico en español para empresas en Bogotá y toda la región.</p>
      </div>
    </section>

    <!-- Módulos (6 Cards) -->
    <section class="bg-gray-50 py-16 sm:py-20 lg:py-24 mt-14 sm:mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold mb-4">
            El Factor Humano,{" "}<span class="text-red-700">Medido y Gestionado</span>
          </h2>
          <p class="text-gray-600 max-w-3xl">
            Los firewalls y antivirus protegen los equipos; Kymatio protege a las personas que los usan.
            Cada módulo se puede contratar por separado y activar más adelante sin perder el avance de los usuarios.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {KY_MODULES.map((m) => (
            <div class="bg-white border border-gray-200 rounded-2xl p-6">
              <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                  <path d={m.icon} stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold mb-2">{m.title}</h3>
              <p class="text-sm text-gray-600">{m.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Plataforma -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
          <div>
            <span class="text-red-700 text-xs font-medium uppercase tracking-wide">Plataforma Kymatio HRM</span>
            <h2 class="text-3xl sm:text-4xl font-bold mt-4 mb-6">
              Del Cumplimiento en Papel a la Reducción Real del Riesgo
            </h2>
            <p class="text-gray-600 mb-6">
              La mayoría de las empresas capacita a su personal una vez al año y no sabe si sirvió.
              Kymatio cambia la pregunta de "¿quién asistió?" a "¿quién representa hoy un riesgo y por qué?",
              con datos objetivos por persona, área y región.
            </p>
            <p class="text-gray-600 mb-8">
              El enfoque es positivo y centrado en las personas: el empleado recibe recomendaciones y
              formación a su medida, y la dirección obtiene una visión clara para decidir dónde invertir
              primero.
            </p>

            <div class="grid grid-cols-2 gap-6">
              <div class="border-l-4 border-red-600 pl-4">
                <div class="text-2xl font-bold text-gray-900 mb-1">48 h</div>
                <div class="text-sm text-gray-600">Para tener la plataforma lista, según el fabricante</div>
              </div>
              <div class="border-l-4 border-red-600 pl-4">
                <div class="text-2xl font-bold text-gray-900 mb-1">4 canales</div>
                <div class="text-sm text-gray-600">De ataque simulados: correo, SMS, voz y ransomware</div>
              </div>
            </div>
          </div>

          <div>
            <div class="bg-gradient-to-br from-red-50 to-white border border-red-100 rounded-2xl p-8">
              <h3 class="text-xl font-semibold mb-6">Capacidades clave de la plataforma:</h3>
              <div class="space-y-4">
                {KY_CAPABILITIES.map((c) => (
                  <div class="flex items-start gap-3">
                    <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                      <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                        <path d={check} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                      </svg>
                    </div>
                    <div>
                      <h3 class="font-semibold text-gray-900">{c.t}</h3>
                      <p class="text-sm text-gray-600">{c.d}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Implementación -->
    <section class="py-16 sm:py-20 lg:py-24 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4">
            Implementación en 4 Fases
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Un programa de riesgo humano que empieza a mostrar resultados desde la primera fase,
            sin interrumpir la operación de su equipo.
          </p>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-gray-200">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            {KY_PHASES.map((p) => (
              <div class="text-center">
                <div class="bg-red-100 text-red-800 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg">
                  {p.n}
                </div>
                <h3 class="font-semibold mb-2">{p.t}</h3>
                <p class="text-sm text-gray-600">{p.d}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Casos por Sector -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-gray-900">
            Casos de Uso por Sector en Colombia
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Cada sector enfrenta engaños y exigencias regulatorias distintas. Star Solutions TI adapta Kymatio al contexto colombiano.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {KY_SECTORS.map((s) => (
            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 flex flex-col gap-4">
              <h3 class="text-lg font-bold text-gray-900">{s.sector}</h3>
              <div>
                <p class="text-xs font-semibold text-red-700 uppercase tracking-wide mb-1">Reto:</p>
                <p class="text-sm text-gray-600">{s.need}</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-green-700 uppercase tracking-wide mb-1">Cómo lo resolvemos:</p>
                <p class="text-sm text-gray-600">{s.how}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Kymatio vs Capacitación Tradicional -->
    <section class="py-16 sm:py-20 lg:py-24 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-gray-900">
            Kymatio vs Capacitación Tradicional
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Por qué una charla anual de seguridad ya no es suficiente frente a los ataques de ingeniería social actuales.
          </p>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white">
          <table class="w-full text-sm text-left text-gray-700 min-w-[640px]">
            <caption class="sr-only">Comparativa entre la capacitación tradicional en seguridad y la gestión del riesgo humano con Kymatio en seis aspectos.</caption>
            <thead class="bg-gray-900 text-white">
              <tr>
                <th scope="col" class="px-5 py-5 font-semibold">Aspecto</th>
                <th scope="col" class="px-5 py-5 font-semibold text-center">Capacitación tradicional</th>
                <th scope="col" class="px-5 py-5 font-semibold text-center"><span class="block">Kymatio</span><span class="block text-xs font-normal text-red-300 mt-1">Gestión del riesgo humano</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {KY_COMPARE.map((r, i) => (
                <tr class={i % 2 ? 'bg-gray-50' : 'bg-white'}>
                  <th scope="row" class="px-5 py-4 font-medium text-gray-900 text-left">{r.cap}</th>
                  <td class="px-5 py-4 text-center text-amber-600">{r.trad}</td>
                  <td class="px-5 py-4 text-center text-emerald-600">{r.ky}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-center">
          Preguntas Frecuentes sobre Kymatio
        </h2>
        <p class="text-gray-600 text-center mb-12">
          Lo que más nos preguntan las empresas antes de iniciar un programa de riesgo humano.
        </p>
        <div class="space-y-4">
          {kymatioFaqs.map((f) => (
            <details class="bg-white border border-gray-200 rounded-xl group">
              <summary class="font-semibold text-lg p-6 cursor-pointer list-none flex items-center justify-between gap-4">
                {f.q}
                <svg class="w-5 h-5 shrink-0 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="px-6 pb-6 text-gray-600">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-gradient-to-r from-[#111827] to-[#1f2937] rounded-2xl overflow-hidden">
          <div class="p-8 lg:p-12 text-center">
            <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
              ¿Sabe qué tan preparado está su equipo frente a un engaño?
            </h2>
            <p class="text-gray-300 mb-8 max-w-2xl mx-auto">
              Solicite una demostración de Kymatio. Le mostramos cómo se vería el mapa de riesgo humano
              de su organización y cómo arrancar un programa medible con soporte local en español desde Colombia.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="#consultoria" class="bg-gradient-to-r from-red-600 to-red-700 text-white font-semibold px-8 py-4 rounded-full hover:from-red-700 hover:to-red-800 transition shadow-lg inline-flex items-center justify-center gap-2">
                Solicitar Demo de Kymatio
              </a>
              <a href="/contacto/" class="bg-white/10 backdrop-blur-sm border border-white/20 text-white font-semibold px-8 py-4 rounded-full hover:bg-white/20 transition inline-flex items-center justify-center gap-2 focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">
                Hablar con un Experto
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- Soluciones Relacionadas -->
  <section class="py-12 bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-gray-900 mb-6">Soluciones Relacionadas</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <a href="/proofpoint/" class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition duration-200 text-center">
          <p class="font-semibold text-sm text-gray-900">Proofpoint</p>
          <p class="text-xs text-gray-500 mt-1">Seguridad email avanzada</p>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import { seoData } from '@data/seo';

const seo = seoData.netwrix;

const NW_SECTORS = [
  {
    sector: 'Banca y Finanzas',
    need: 'Circular 007 Superfinanciera exige controles de acceso a sistemas core y registros de auditoría inmutables. Permisos excesivos en cuentas de administración representan riesgo regulatorio.',
    how: 'Desplegamos Netwrix Auditor y Netwrix Privilege Secure para auditar AD, restringir cuentas privilegiadas con Zero Standing Privilege y generar evidencia lista para la Superfinanciera.',
  },
  {
    sector: 'Salud',
    need: 'La Ley 1581 y el Habeas Data protegen datos de pacientes (PHI). Hospitales y clínicas requieren clasificar datos sensibles y controlar quién accede a expedientes clínicos digitales.',
    how: 'Implementamos Netwrix Data Classification para descubrir y clasificar PHI, y Netwrix Access Analyzer para gobernar accesos a más de 40 fuentes de datos con reportes de cumplimiento.',
  },
  {
    sector: 'Gobierno y Sector Público',
    need: 'El MSPI de MinTIC exige visibilidad sobre activos de información, gestión de identidades y auditoría de cambios en sistemas del Estado. La falta de trazabilidad expone a sanciones.',
    how: 'Integramos Netwrix 1Secure para unificar auditoría de identidad y DSPM en entornos híbridos, y Netwrix Identity Manager para automatizar el ciclo de vida de identidades de funcionarios.',
  },
  {
    sector: 'Retail y Comercio',
    need: 'PCI DSS requiere proteger datos de tarjetas de pago y limitar accesos a sistemas de punto de venta. La rotación de personal temporal genera permisos huérfanos y vectores de ataque.',
    how: 'Desplegamos Netwrix Endpoint Protector DLP para evitar fuga de datos de tarjetas, y Netwrix Auditor para auditar servidores de archivos y detectar accesos anómalos en tiempo real.',
  },
];
---

<BaseLayout seo={seo}>
  <Navbar />

  <div class="bg-white min-h-screen font-['Instrument_Sans',sans-serif]">

    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-gray-50 to-white py-12 sm:py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="mb-6">
              <span class="inline-block bg-red-100 text-red-700 text-xs font-medium px-3 py-1 rounded">
                SEGURIDAD DE DATOS E IDENTIDADES
              </span>
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
              Netwrix: Seguridad de Datos{" "}
              <span class="text-red-700">centrada en Identidad.</span>
            </h1>
            <p class="text-lg sm:text-xl text-gray-600 mb-8 max-w-3xl">
              Auditoría de cambios, clasificación de datos, gobernanza de identidad, PAM y DLP
              para cumplir con Ley 1581, ISO 27001, Circular 007, PCI DSS y GDPR.
              Starsolution implementa e integra Netwrix en Colombia con soporte en español.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/contacto" class="bg-gradient-to-r from-red-600 to-red-700 text-white font-semibold px-8 py-4 rounded-full hover:from-red-700 hover:to-red-800 transition shadow-lg inline-flex items-center justify-center gap-2">
                Solicitar Demo
              </a>
              <a href="/contacto" class="bg-white border-2 border-gray-200 text-gray-800 font-semibold px-8 py-4 rounded-full hover:bg-gray-50 transition inline-flex items-center justify-center gap-2 focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">
                Evaluar Cumplimiento
              </a>
            </div>
            <div class="mt-8 flex items-center gap-2 text-sm text-gray-500">
              <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 14 14">
                <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
              </svg>
              <span>Visibilidad total sobre datos, identidades y cambios en su infraestructura</span>
            </div>
          </div>
          <div class="hidden lg:flex items-center justify-center">
            <img src="/assets/icono-firewall-bloques-seguridad.webp" alt="Seguridad de datos e identidad con Netwrix en Colombia" class="w-full max-w-sm rounded-2xl shadow-xl" width="384" height="384" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- ¿Qué es? · Bloque definicional para AI/GEO -->
    <section class="bg-white pt-14 sm:pt-16" aria-labelledby="que-es-netwrix">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="que-es-netwrix" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">¿Qué es Netwrix?</h2>
        <p class="text-lg text-gray-700 leading-relaxed">Netwrix es una plataforma de seguridad de datos centrada en identidad que integra auditoría de Active Directory (Netwrix Auditor), gobernanza de acceso a datos (Netwrix Access Analyzer), gestión de acceso privilegiado con Zero Standing Privilege (Netwrix Privilege Secure), prevención de pérdida de datos multiplataforma (Netwrix Endpoint Protector), clasificación de datos sensibles (Netwrix Data Classification), gestión del ciclo de vida de identidades (Netwrix Identity Manager) y una plataforma SaaS unificada para entornos empresariales de IA (Netwrix 1Secure). Las organizaciones despliegan Netwrix para auditar cambios de infraestructura, controlar accesos privilegiados, cumplir con marcos regulatorios como Ley 1581, ISO 27001 y Circular 007 Superfinanciera, y reducir el riesgo de brechas por identidades comprometidas. Starsolution implementa e integra toda la línea de productos Netwrix en Colombia con soporte en español y cobertura en Venezuela y Miami.</p>
      </div>
    </section>

    <!-- Reconocimientos Netwrix -->
    <section class="bg-white pb-14 pt-10 sm:pb-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-xs text-gray-500 uppercase tracking-wider mb-4 font-medium">Reconocimientos vigentes</p>
        <div class="flex flex-wrap gap-3">
          <span class="bg-gray-50 border border-gray-200 text-gray-700 text-xs font-medium px-3 py-2 rounded-lg">Gartner MQ PAM 2025 — 4.° año consecutivo</span>
          <span class="bg-gray-50 border border-gray-200 text-gray-700 text-xs font-medium px-3 py-2 rounded-lg">KuppingerCole IGA Leadership Compass 2024 — Overall Leader</span>
          <span class="bg-gray-50 border border-gray-200 text-gray-700 text-xs font-medium px-3 py-2 rounded-lg">GigaOM DLP Radar 2025 — Challenger / Fast Mover</span>
          <span class="bg-gray-50 border border-gray-200 text-gray-700 text-xs font-medium px-3 py-2 rounded-lg">Cybersecurity Excellence DLP Award 2024</span>
          <span class="bg-gray-50 border border-gray-200 text-gray-700 text-xs font-medium px-3 py-2 rounded-lg">Gartner Peer Insights 4.7/5 — 164 reseñas</span>
        </div>
      </div>
    </section>

    <!-- Cifras verificadas -->
    <section class="bg-[#111827] py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
            Por qué las Empresas Eligen Netwrix
          </h2>
          <p class="text-gray-400 max-w-3xl mx-auto">
            Más de 13,000 organizaciones en el mundo confían en Netwrix para auditar
            su infraestructura, gobernar identidades y demostrar cumplimiento normativo.
          </p>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
          <div>
            <h3 class="text-white font-bold text-3xl mb-2">13,000+</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Clientes a nivel mundial</p>
          </div>
          <div>
            <h3 class="text-white font-bold text-3xl mb-2">40+</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Fuentes de datos auditadas por Access Analyzer</p>
          </div>
          <div>
            <h3 class="text-white font-bold text-3xl mb-2">4.°</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Año consecutivo en Gartner MQ PAM 2025</p>
          </div>
          <div>
            <h3 class="text-white font-bold text-3xl mb-2">4.7/5</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Rating Gartner Peer Insights (164 reseñas)</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Línea de Producto Netwrix (Featured) -->
    <section class="bg-gray-50 py-16 sm:py-20 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold mb-4">
            Productos{" "}<span class="text-red-700">Netwrix</span>
          </h2>
          <p class="text-gray-600 max-w-3xl">
            Netwrix organiza su portafolio en Data Security e Identity Security.
            Starsolution integra los productos vigentes con nomenclatura oficial 2025-2026.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Netwrix 1Secure -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <circle cx="10" cy="10" r="7" stroke="#374151" stroke-width="1.66667" fill="none" />
                <path d="M10 7v3l2 2" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-1">Netwrix 1Secure</h3>
            <p class="text-xs text-red-700 font-medium mb-2 uppercase tracking-wide">Plataforma SaaS Unificada</p>
            <p class="text-sm text-gray-600">
              Plataforma SaaS-native con 6 módulos integrados: PAM, Identity Management, Directory Management,
              DSPM (desde mayo 2025), ITDR y Endpoint Management. Posicionada como
              "Identity-first data security for enterprise AI" e incluye gobernanza de Microsoft Copilot.
            </p>
          </div>

          <!-- Netwrix Auditor -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <circle cx="10" cy="10" r="7" stroke="#374151" stroke-width="1.66667" fill="none" />
                <path d="M10 7v3l2 2" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-1">Netwrix Auditor</h3>
            <p class="text-xs text-red-700 font-medium mb-2 uppercase tracking-wide">Auditoría de Cambios y Cumplimiento</p>
            <p class="text-sm text-gray-600">
              Registro detallado de quién cambió qué, cuándo y dónde en Active Directory,
              servidores de archivos, Exchange, SharePoint, Microsoft Entra ID y más.
              Alertas en tiempo real ante cambios críticos y reportes pre-construidos para auditores.
            </p>
          </div>

          <!-- Netwrix Access Analyzer -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <rect x="3" y="3" width="14" height="14" rx="2" stroke="#374151" stroke-width="1.66667" fill="none" />
                <path d="M7 8h6M7 12h4" stroke="#374151" stroke-linecap="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-1">Netwrix Access Analyzer</h3>
            <p class="text-xs text-red-700 font-medium mb-2 uppercase tracking-wide">Data Access Governance / DSPM</p>
            <p class="text-sm text-gray-600">
              Descubrimiento y clasificación en 40+ fuentes de datos (AD, SharePoint, SQL Server, AWS RDS, Oracle).
              Monitoreo de Microsoft Copilot en tiempo real. Automatización de deprovisioning y remediación.
              Reporting de GDPR, HIPAA, SOX y PCI DSS. Antes llamado StealthAUDIT.
            </p>
          </div>

          <!-- Netwrix Data Classification -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <rect x="3" y="3" width="14" height="14" rx="2" stroke="#374151" stroke-width="1.66667" fill="none" />
                <path d="M7 8h6M7 12h4" stroke="#374151" stroke-linecap="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-1">Netwrix Data Classification</h3>
            <p class="text-xs text-red-700 font-medium mb-2 uppercase tracking-wide">Clasificación de Datos Sensibles</p>
            <p class="text-sm text-gray-600">
              "Find it. Classify it. Fix it." Descubrimiento automatizado de datos sensibles (PII, PHI, PCI)
              en servidores de archivos, bases de datos, email y repositorios cloud. Remediación automatizada,
              integración con Microsoft Information Protection (MIP) y reporting de cumplimiento.
            </p>
          </div>

          <!-- Netwrix Identity Manager -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM3 12a3 3 0 116 0 3 3 0 01-6 0z" stroke="#374151" stroke-width="1.66667" fill="none" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-1">Netwrix Identity Manager</h3>
            <p class="text-xs text-red-700 font-medium mb-2 uppercase tracking-wide">IGA — Identity Governance & Administration</p>
            <p class="text-sm text-gray-600">
              Automatización del ciclo de vida de identidades (joiner-mover-leaver) con modelado de roles asistido por IA.
              Access reviews, certificaciones de acceso, RBAC y conectores prebuilt para HR, IT y apps de negocio.
              Antes llamado Netwrix Usercube (renombrado abril 2025).
            </p>
          </div>

          <!-- Netwrix Privilege Secure -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M10 2L3 6v5c0 4.5 3 8.5 7 9.5 4-1 7-5 7-9.5V6l-7-4z" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-1">Netwrix Privilege Secure</h3>
            <p class="text-xs text-red-700 font-medium mb-2 uppercase tracking-wide">PAM — Zero Standing Privilege</p>
            <p class="text-sm text-gray-600">
              "Stop attackers with Zero Standing Privilege." Acceso Just-In-Time (JIT) con credenciales
              temporales eliminadas al finalizar la sesión. Grabación y monitoreo de sesiones privilegiadas.
              Elimina cuentas permanentes de administrador sin depender solo de bóvedas de contraseñas.
            </p>
          </div>

          <!-- Netwrix Endpoint Protector -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M10 2a8 8 0 100 16 8 8 0 000-16zM10 6v4m0 4h.01" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-1">Netwrix Endpoint Protector</h3>
            <p class="text-xs text-red-700 font-medium mb-2 uppercase tracking-wide">DLP — Data Loss Prevention</p>
            <p class="text-sm text-gray-600">
              Control de dispositivos (USB, Bluetooth, impresoras, 45+ tipos) y DLP content-aware
              con paridad completa de funcionalidades en Windows, macOS y Linux. Cifrado forzado FIPS,
              eDiscovery para datos en reposo. Ganador del DLP Excellence Award 2024.
            </p>
          </div>

          <!-- Netwrix PingCastle -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M9 17H5a2 2 0 01-2-2V5a2 2 0 012-2h10a2 2 0 012 2v4" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
                <path d="M13 15l2 2 4-4" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-1">Netwrix PingCastle</h3>
            <p class="text-xs text-red-700 font-medium mb-2 uppercase tracking-wide">Active Directory Security Posture</p>
            <p class="text-sm text-gray-600">
              Evaluación de la postura de seguridad de Active Directory. Identifica configuraciones
              riesgosas, cuentas expuestas y rutas de escalada de privilegios. Se integra con
              Netwrix 1Secure para AD risk assessments continuos.
            </p>
          </div>

          <!-- Netwrix Directory Manager -->
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M4 4h12v12H4z" stroke="#374151" stroke-width="1.66667" fill="none" rx="2" />
                <path d="M8 8h4M8 12h4" stroke="#374151" stroke-linecap="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-1">Netwrix Directory Manager</h3>
            <p class="text-xs text-red-700 font-medium mb-2 uppercase tracking-wide">Gestión de Grupos y Usuarios AD</p>
            <p class="text-sm text-gray-600">
              "Simplify group and user management." Gestión de grupos y usuarios en Active Directory
              y Microsoft Entra ID con self-service de contraseñas. Antes llamado GroupID.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Platform Capabilities -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
          <div>
            <span class="text-red-700 text-xs font-medium uppercase tracking-wide">Plataforma Unificada</span>
            <h2 class="text-3xl sm:text-4xl font-bold mt-4 mb-6">
              Una Sola Plataforma para Toda su Infraestructura
            </h2>
            <p class="text-gray-600 mb-6">
              Netwrix cubre entornos híbridos completos: Active Directory, Microsoft Entra ID, Windows Server,
              Exchange, SharePoint, OneDrive, SQL Server, VMware, y almacenamiento en la nube.
              Todo visible desde una única consola con reportes unificados.
            </p>
            <p class="text-gray-600 mb-8">
              Cada cambio, cada acceso y cada anomalía queda registrada con el detalle necesario
              para satisfacer a auditores y demostrar cumplimiento continuo ante marcos regulatorios.
              Netwrix 1Secure añade DSPM e ITDR en formato SaaS-native para entornos de IA empresarial.
            </p>

            <div class="grid grid-cols-2 gap-6">
              <div class="border-l-4 border-red-600 pl-4">
                <div class="text-2xl font-bold text-gray-900 mb-1">40+</div>
                <div class="text-sm text-gray-600">Fuentes de datos auditadas por Access Analyzer</div>
              </div>
              <div class="border-l-4 border-red-600 pl-4">
                <div class="text-2xl font-bold text-gray-900 mb-1">13,000+</div>
                <div class="text-sm text-gray-600">Clientes a nivel mundial</div>
              </div>
            </div>
          </div>

          <div>
            <div class="bg-gradient-to-br from-red-50 to-white border border-red-100 rounded-2xl p-8">
              <h3 class="text-xl font-semibold mb-6">Sistemas auditados:</h3>
              <div class="space-y-4">
                <div class="flex items-start gap-3">
                  <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Active Directory & Microsoft Entra ID</h3>
                    <p class="text-sm text-gray-600">Cambios en usuarios, grupos, GPOs y permisos</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Windows Server & File Servers</h3>
                    <p class="text-sm text-gray-600">Acceso a archivos, cambios de permisos y configuración</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Microsoft 365 & SharePoint</h3>
                    <p class="text-sm text-gray-600">Exchange Online, OneDrive, Teams, SharePoint y Microsoft Copilot</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">SQL Server, AWS RDS & VMware</h3>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import Iso27001LeadForm from '@components/Iso27001LeadForm.astro';
import { seoData } from '@data/seo';
import {
  isoFaqs,
  painPoints,
  phases,
  metrics,
  testimonials,
  sectors,
  steps,
  caseSteps,
  isoLeadEmail,
  isoWhatsAppNumber,
} from '@data/iso27001Landing';

const seo = seoData['iso-27001'];
const defaultWhatsappMessage = 'Hola, quiero agendar un diagnóstico de consultoría ISO 27001 en Bogotá, Colombia con Starsolution.';
---

<BaseLayout seo={seo}>
  <Navbar />

  <main class="iso-landing">
    <a class="iso-landing__skip" href="#problema">Saltar al contenido</a>

    <section class="iso-hero" id="top" aria-labelledby="iso-hero-title">
      <div class="iso-hero__inner">
        <div class="iso-hero__content">
          <span class="iso-badge iso-badge--accent">Consultoría ISO 27001 Bogotá - Colombia</span>
          <h1 id="iso-hero-title">Consultoría ISO 27001 en Bogotá, Colombia</h1>
          <p class="iso-hero__lede">
            Si estás buscando consultoría ISO 27001 en Bogotá - Colombia, Starsolution
            implementa tu Sistema de Gestión de Seguridad de la Información (SGSI) con diagnóstico
            de brechas, plan de trabajo, controles del Anexo A, auditoría interna y acompañamiento
            para certificar con una ruta clara para gerencia, TI y cumplimiento.
          </p>
          <ul class="iso-hero__benefits">
            <li><span aria-hidden="true">✓</span> Diagnóstico de brechas y alcance de certificación ISO/IEC 27001:2022</li>
            <li><span aria-hidden="true">✓</span> Implementación del SGSI, riesgos, controles del Anexo A y evidencias</li>
            <li><span aria-hidden="true">✓</span> Preparación para auditoría interna y organismo certificador acreditado</li>
          </ul>
          <Iso27001LeadForm id="iso-hero-form" buttonLabel="Solicitar consultoría ISO 27001" />
          <p class="iso-hero__disclaimer">Sin compromiso. Sin presión comercial. Respuesta en menos de 4 horas hábiles.</p>
        </div>

        <aside class="iso-hero__terminal" aria-label="Resumen visual del SGSI">
          <div class="iso-terminal">
            <div class="iso-terminal__bar">
              <span class="iso-terminal__dot iso-terminal__dot--red"></span>
              <span class="iso-terminal__dot iso-terminal__dot--amber"></span>
              <span class="iso-terminal__dot iso-terminal__dot--green"></span>
              <span class="iso-terminal__file">sgsi-audit.log</span>
            </div>
            <ol class="iso-terminal__log">
              <li><span class="iso-terminal__tag iso-terminal__tag--green">[FASE 1]</span> Diagnóstico de brechas completado</li>
              <li><span class="iso-terminal__tag iso-terminal__tag--blue">[SCAN]</span> Evaluando 93 controles del Anexo A</li>
              <li><span class="iso-terminal__tag iso-terminal__tag--amber">[RIESGO]</span> Brecha crítica identificada y priorizada</li>
              <li><span class="iso-terminal__tag iso-terminal__tag--red">[FASE 2]</span> Implementación alineada a la operación</li>
              <li><span class="iso-terminal__tag iso-terminal__tag--green">[OK]</span> Sistema listo para auditoría externa</li>
              <li><span class="iso-terminal__tag iso-terminal__tag--purple">[FASE 3]</span> Acompañamiento en auditoría<span class="iso-terminal__cursor"></span></li>
            </ol>
          </div>
          <div class="iso-hero__card">
            <p class="iso-hero__card-eyebrow">Certificación ISO 27001</p>
            <p class="iso-hero__card-title">Audit-ready</p>
            <p class="iso-hero__card-meta">desde el primer día</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="iso-section iso-answer" id="consultoria-iso-27001-colombia" aria-labelledby="iso-answer-title">
      <header class="iso-section__header">
        <span class="iso-badge iso-badge--green">Respuesta directa</span>
        <h2 id="iso-answer-title">¿Dónde encontrar consultoría ISO 27001 en Bogotá, Colombia?</h2>
      </header>
      <div class="iso-answer__grid">
        <article class="iso-answer__main">
          <p class="iso-answer__lead">
            <strong>Puede encontrar consultoría ISO 27001 en Bogotá, Colombia con Starsolution S.A.S.</strong>,
            una firma especializada en seguridad de la información que acompaña empresas en Bogotá,
            Medellín, Cali y el resto del país mediante sesiones remotas, híbridas o presenciales.
          </p>
          <p>
            Nuestro equipo guía el diagnóstico de brechas, análisis de riesgos, Declaración de
            Aplicabilidad, implementación del SGSI, auditoría interna y preparación para la auditoría
            externa con un organismo certificador acreditado. La consultoría está pensada para
            empresas que necesitan demostrar seguridad ante clientes corporativos, licitaciones,
            proveedores internacionales o auditorías de cumplimiento.
          </p>
          <p>
            El proyecto inicia con una evaluación comercial y técnica para definir alcance,
            presupuesto, responsables y tiempos de implementación antes de avanzar con documentación
            o controles.
          </p>
          <div class="iso-answer__actions">
            <a class="iso-button" href="#contacto">Cotizar consultoría ISO 27001</a>
            <a
              class="iso-button iso-button--secondary"
              href={`https://wa.me/${isoWhatsAppNumber}?text=${encodeURIComponent(defaultWhatsappMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Hablar con un consultor
            </a>
          </div>
        </article>
        <aside class="iso-answer__aside" aria-label="Criterios para elegir consultoría ISO 27001">
          <h3>Qué debe incluir una buena consultoría</h3>
          <ul>
            <li><span aria-hidden="true">✓</span> Alcance del SGSI definido con objetivos comerciales y técnicos.</li>
            <li><span aria-hidden="true">✓</span> Gap analysis contra ISO/IEC 27001:2022 y plan priorizado.</li>
            <li><span aria-hidden="true">✓</span> Gestión de riesgos y controles del Anexo A aplicables.</li>
            <li><span aria-hidden="true">✓</span> Evidencias listas para auditoría, no solo documentos genéricos.</li>
            <li><span aria-hidden="true">✓</span> Acompañamiento hasta la auditoría externa de certificación.</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="iso-section" id="que-es" aria-labelledby="iso-que-es-title">
      <header class="iso-section__header">
        <span class="iso-badge iso-badge--blue">Estándar internacional</span>
        <h2 id="iso-que-es-title">¿Qué es ISO/IEC 27001:2022?</h2>
      </header>
      <div class="iso-definition">
        <p class="iso-definition__lead">ISO 27001 es el estándar internacional que define los requisitos para implementar un Sistema de Gestión de Seguridad de la Información (SGSI): políticas, procesos y controles que protegen la confidencialidad, integridad y disponibilidad de la información de una organización.</p>
        <p>La versión vigente, ISO/IEC 27001:2022, organiza los controles del Anexo A en categorías organizacionales, de personas, físicas y tecnológicas, y ayuda a demostrar medidas de seguridad frente a la Ley 1581 de Protección de Datos en Colombia. A diferencia de marcos como NIST o CIS Controls, ISO 27001 es una norma certificable: la consultoría prepara el sistema y un organismo certificador independiente audita el cumplimiento.</p>
        <p class="iso-definition__source">
          Fuentes oficiales:
          <a href="https://www.iso.org/standard/27001" target="_blank" rel="noopener noreferrer">ISO</a>
          y
          <a href="https://onac.org.co/servicios/certificacion-de-sistemas-de-gestion/" target="_blank" rel="noopener noreferrer">ONAC</a>.
        </p>
        <p><a href="/blog/iso-27001-regulaciones/">Conozca los cambios clave de ISO 27001:2022 y su impacto regulatorio →</a></p>
      </div>
    </section>

    <section class="iso-section" id="problema" aria-labelledby="iso-problema-title">
      <header class="iso-section__header">
        <span class="iso-badge iso-badge--accent">El problema</span>
        <h2 id="iso-problema-title">¿Por qué cada vez más empresas colombianas necesitan ISO 27001?</h2>
        <p>Hace algunos años era un diferencial. Hoy es un requisito para competir y vender a clientes corporativos.</p>
      </header>
      <div class="iso-grid iso-grid--3">
        {painPoints.map((item) => (
          <article class="iso-card iso-card--plain">
            <span class="iso-card__number">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
      <p class="iso-section__punchline">
        La pregunta ya no es <em>si</em> deberías implementarla. La pregunta es <em>cuándo</em> vas a hacerlo antes de que sea urgente.
      </p>
    </section>

    <section class="iso-section iso-section--alt" id="solucion" aria-labelledby="iso-solucion-title">
      <header class="iso-section__header">
        <span class="iso-badge iso-badge--blue">Cómo lo resolvemos</span>
        <h2 id="iso-solucion-title">ISO 27001 no tiene que ser complicado</h2>
        <p>No vendemos "papeles". Implementamos un sistema funcional, estratégico y audit-ready desde el primer día.</p>
      </header>
      <div class="iso-grid iso-grid--3">
        {phases.map((phase) => (
          <article class="iso-card iso-card--muted">
            <div class="iso-phase">
              <span class="iso-phase__bubble" aria-hidden="true">{phase.number}</span>
              <span class="iso-phase__label">Fase {phase.number}</span>
            </div>
            <h3>{phase.title}</h3>
            <p>{phase.body}</p>
          </article>
        ))}
      </div>
      <p class="iso-pill">
        <span aria-hidden="true">✓</span> Resultado: un proceso ordenado, predecible y sin sorpresas
      </p>
    </section>

    <section class="iso-section" id="cotizacion" aria-labelledby="iso-cotizacion-title">
      <header class="iso-section__header">
        <span class="iso-badge iso-badge--accent">Cotización y alcance</span>
        <h2 id="iso-cotizacion-title">Qué recibe al contratar consultoría ISO 27001 en Bogotá - Colombia</h2>
        <p>La intención comercial importa: antes de comprar, necesitas saber qué incluye el proyecto, cuánto puede tomar y qué evidencia quedará lista para auditoría.</p>
      </header>
      <div class="iso-commercial">
        <article class="iso-commercial__item">
          <h3>Diagnóstico inicial</h3>
          <p>Revisión del contexto, activos de información, controles existentes, brechas críticas y madurez frente a ISO/IEC 27001:2022.</p>
        </article>
        <article class="iso-commercial__item">
          <h3>Roadmap y cotización</h3>
          <p>Alcance del SGSI, cronograma, roles, entregables y presupuesto estimado para tomar una decisión de compra informada.</p>
        </article>
        <article class="iso-commercial__item">
          <h3>Implementación del SGSI</h3>
          <p>Políticas, matriz de riesgos, Declaración de Aplicabilidad, indicadores, auditoría interna y evidencias ajustadas a la operación.</p>
        </article>
        <article class="iso-commercial__item">
          <h3>Acompañamiento final</h3>
          <p>Preparación del equipo, respuesta a hallazgos y soporte durante la auditoría externa con el organismo certificador elegido.</p>
        </article>
      </div>
      <p class="iso-commercial__note">
        Starsolution implementa y prepara el SGSI. La certificación ISO 27001 la emite un organismo certificador independiente y acreditado según el alcance contratado.
      </p>
    </section>

    <section class="iso-section" id="confianza" aria-labelledby="iso-confianza-title">
      <header class="iso-section__header">
        <span class="iso-badge iso-badge--green">Confianza</span>
        <h2 id="iso-confianza-title">Expertos en seguridad de la información, no improvisados</h2>
        <p>Consultores certificados Lead Implementer y Lead Auditor ISO 27001 con metodología probada en más de 50 empresas.</p>
      </header>
      <div class="iso-section__chips" aria-label="Organismos de certificación">
        <span class="iso-section__chip-eyebrow">Auditoría externa</span>
        <ul>
          <li>ICONTEC</li>
          <li>SGS</li>
          <li>BUREAU VERITAS</li>
          <li>Organismos acreditados ONAC</li>
        </ul>
      </div>
      <div class="iso-grid iso-grid--3 iso-grid--metrics">
        {metrics.map((metric) => (
          <div class="iso-metric">
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </div>
        ))}
      </div>
      <div class="iso-grid iso-grid--3">
        {testimonials.map((testimonial) => (
          <figure class="iso-testimonial">
            <blockquote>“{testimonial.quote}”</blockquote>
            <figcaption>— {testimonial.author}</figcaption>
          </figure>
        ))}
      </div>
      <div class="iso-section__chips" aria-label="Sectores atendidos">
        <span class="iso-section__chip-eyebrow">Sectores que atendemos</span>
        <ul>
          {sectors.map((sector) => <li>{sector}</li>)}
        </ul>
      </div>
    </section>

    <section class="iso-section iso-section--alt" id="como-funciona" aria-labelledby="iso-como-funciona-title">
      <header class="iso-section__header">
        <span class="iso-badge iso-badge--accent">Cómo funciona</span>
        <h2 id="iso-como-funciona-title">Tres pasos hacia tu certificación</h2>
      </header>
      <ol class="iso-steps">
        {steps.map((step) => (
          <li class="iso-step">
            <span class="iso-step__number" aria-hidden="true">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="iso-section iso-section--dark" aria-labelledby="iso-caso-title">
      <header class="iso-section__header">
        <span class="iso-badge iso-badge--dark">Caso real</span>
        <h2 id="iso-caso-title">De obstáculo a ventaja competitiva</h2>
      </header>
      <div class="iso-case">
        <div class="iso-case__intro">
          <ul>
            <li><span aria-hidden="true">✓</span> Metodología en tres fases, sin burocracia innecesaria</li>
            <li><span aria-hidden="true">✓</span> Consultores especializados en seguridad de la información</li>
            <li><span aria-hidden="true">✓</span> Adaptación real a distintos sectores e industrias</li>
            <li><span aria-hidden="true">✓</span> Acompañamiento directo durante toda la auditoría</li>
          </ul>
        </div>
        <div class="iso-case__timeline">
          {caseSteps.map((step) => (
            <div class="iso-case__row" style={`--accent:${step.color}`}>
              <span class="iso-case__tag">{step.tag}</span>
              <p>{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="iso-section" id="faq" aria-labelledby="iso-faq-title">
      <header class="iso-section__header">
        <span class="iso-badge iso-badge--blue">Preguntas frecuentes</span>
        <h2 id="iso-faq-title">¿Aún tienes dudas sobre la certificación?</h2>
        <p>Estas son las preguntas más comunes que recibimos de empresas que están evaluando iniciar un proyecto ISO 27001.</p>
      </header>
      <div class="iso-faq" data-faq>
        {isoFaqs.map((item, index) => (
          <details class="iso-faq__item" data-faq-item open={index === 0}>
            <summary>
              <span>{item.question}</span>
              <span class="iso-faq__icon" aria-hidden="true"></span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="iso-section iso-section--cta" id="contacto" aria-labelledby="iso-cta-title">
      <div class="iso-cta">
        <span class="iso-badge iso-badge--on-dark">Empieza hoy</span>
        <h2 id="iso-cta-title">¿Listo para iniciar consultoría ISO 27001 en Bogotá - Colombia?</h2>
        <p>
          La pregunta ya no es si necesitas ISO 27001. Es si vas a implementarla estratégicamente o cuando ya sea demasiado tarde. Protege tu información, fortalece tu reputación y abre nuevas oportunidades comerciales.
        </p>
        <div class="iso-cta__panel">
          <h3>El diagnóstico gratuito incluye</h3>
          <ul>
            <li><span aria-hidden="true">✓</span> Informe de brechas: estado actual frente a ISO 27001:2022</li>
            <li><span aria-hidden="true">✓</span> Cotización detallada de consultoría y certificación</li>
            <li><span aria-hidden="true">✓</span> Roadmap con hitos, entregables y cronograma</li>
            <li><span aria-hidden="true">✓</span> Casos de éxito y referencias de tu industria</li>
          </ul>
          <Iso27001LeadForm id="iso-cta-form" buttonLabel="Agendar diagnóstico gratuito →" includeMessage />
          <div class="iso-cta__alt">
            <a
              class="iso-cta__whatsapp"
              href={`https://wa.me/${isoWhatsAppNumber}?text=${encodeURIComponent(defaultWhatsappMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span aria-hidden="true">💬</span> ¿Prefieres WhatsApp? Escríbenos al +57 300 701 0017
            </a>
            <p>
              Tu solicitud llega directamente a <a href={`mailto:${isoLeadEmail}`}>{isoLeadEmail}</a>. Sesión virtual de 45 minutos con un consultor certificado.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="iso-related" aria-label="Soluciones y recursos relacionados">
      <h2>Soluciones relacionadas</h2>
      <ul>
        <li><a href="/hacking-etico/">Hacking ético</a><span>Pentesting profesional</span></li>
        <li><a href="/sealpath/">SealPath IRM</a><span>Protección de documentos</span></li>
        <li><a href="/stellar-cyber/">Stellar Cyber</a><span>SOC con Open XDR</span></li>
        <li><a href="/bitdefender/">Bitdefender GravityZone</a><span>EDR/XDR empresarial</span></li>
      </ul>
      <h2>Recursos del blog</h2>
      <ul>
        <li>
          <a href="/mejores-empresas-consultoria-iso-27001-colombia/">Mejores empresas de consultoría ISO 27001 en Colombia</a>
          <span>Comparativa</span>
        </li>
        <li>
          <a href="/blog/iso-27001-regulaciones/">Cambios de ISO 27001:2022 y su impacto</a>
          <span>Cumplimiento</span>
        </li>
        <li>
          <a href="/blog/zero-trust-2025/">Zero Trust como complemento de ISO 27001</a>
          <span>Guía</span>
        </li>
        <li>
          <a href="/informe-ciberseguridad-colombia-2026/">Ciberseguridad Colombia 2026</a>
          <span>Informe</span>
        </li>
      </ul>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
</BaseLayout>

<script>
  const faqContainer = document.querySelector<HTMLElement>('[data-faq]');
  if (faqContainer) {
    const items = faqContainer.querySelectorAll<HTMLDetailsElement>('details[data-faq-item]');
    items.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        items.forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });
  }
</script>

<style is:global>
  html { scroll-padding-top: 112px; }
  .iso-landing { color: #131A2A; }
  .iso-landing *:focus-visible { outline: 2px solid #E8232B; outline-offset: 2px; border-radius: 4px; }
  .iso-landing__skip {
    position: absolute; top: -40px; left: 16px; background: #0C1120; color: #FFFFFF; padding: 10px 16px; border-radius: 8px; z-index: 60;
  }
  .iso-landing__skip:focus { top: 16px; }

  .iso-section { max-width: 1200px; margin: 0 auto; padding: 80px 24px; scroll-margin-top: 112px; }
  .iso-section--alt { background: #F5F7FA; max-width: none; }
  .iso-section--alt > * { max-width: 1200px; margin: 0 auto; }
  .iso-section--dark { background: #0C1120; color: #FFFFFF; max-width: none; }
  .iso-section--dark > * { max-width: 1200px; margin: 0 auto; }
  .iso-section--cta { background: radial-gradient(800px 480px at 50% 0%, rgba(190,30,45,0.3), transparent 65%), #0C1120; color: #FFFFFF; max-width: none; padding: 96px 24px; }
  .iso-section--cta > * { max-width: 720px; margin: 0 auto; }
  .iso-section__header { max-width: 720px; margin: 0 auto 48px; text-align: center; }
  .iso-section__header h2 { font-size: clamp(28px, 3.2vw, 44px); line-height: 1.12; letter-spacing: 0; font-weight: 800; margin: 16px 0 0; }
  .iso-section__header p { margin: 16px auto 0; color: #5B6474; font-size: 17px; line-height: 1.6; max-width: 640px; }
  .iso-section--dark .iso-section__header p, .iso-section--cta .iso-section__header p { color: #B7C0D2; }
  .iso-section__punchline { max-width: 720px; margin: 48px auto 0; text-align: center; font-size: clamp(19px, 2vw, 24px); font-weight: 700; letter-spacing: 0; line-height: 1.4; }
  .iso-section__punchline em { color: #E8232B; font-style: normal; }

  .iso-badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px; font-size: 12.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .iso-badge--accent { background: rgba(232,35,43,0.08); border: 1px solid rgba(232,35,43,0.22); color: #B81620; }
  .iso-badge--blue { background: rgba(76,154,255,0.1); border: 1px solid rgba(76,154,255,0.25); color: #2568C8; }
  .iso-badge--green { background: rgba(31,163,92,0.08); border: 1px solid rgba(31,163,92,0.25); color: #187A47; }
  .iso-badge--dark { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); color: #C9D2E3; }
  .iso-badge--on-dark { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); color: #FFFFFF; }

  .iso-definition { max-width: 840px; margin: 0 auto; display: flex; flex-direction: column; gap: 18px; font-size: 17px; line-height: 1.7; color: #3B4456; }
  .iso-definition p { margin: 0; }
  .iso-definition__lead { font-size: 19px; font-weight: 600; color: #131A2A; background: #F8FAFC; border-left: 4px solid #E8232B; padding: 18px 22px; border-radius: 0 12px 12px 0; }
  .iso-definition__source { font-size: 14px; color: #5B6474; }
  .iso-definition a { color: #E8232B; font-weight: 600; }
  .iso-definition a:hover { color: #B81620; }

  .iso-answer .iso-section__header { max-width: 860px; margin: 0 0 34px; text-align: left; }
  .iso-answer__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr); gap: 28px; align-items: stretch; }
  .iso-answer__main, .iso-answer__aside { background: #FFFFFF; border: 1px solid #E8ECF2; border-radius: 18px; box-shadow: 0 18px 40px rgba(12,17,32,0.08); }
  .iso-answer__main { padding: 34px; display: flex; flex-direction: column; gap: 18px; }

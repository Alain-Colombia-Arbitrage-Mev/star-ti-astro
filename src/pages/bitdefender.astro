---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import { seoData } from '@data/seo';

const seo = seoData.bitdefender;

// Imagenes y assets oficiales del CDN de Bitdefender (bitdefender.com/business)
const BITDEFENDER_LOGO = 'https://www.bitdefender.com/content/dam/bitdefender/bitdefender-blue-logo-png.png';
const GZ_DASHBOARD = 'https://www.bitdefender.com/en-us/business/_jcr_content/root/container/columncontainer_1032/tab_item_no_1/image.coreimg.svg/1773667996822/bitdefender-diagrama-homepage--1-.svg';
const GZ_XDR = 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--5fc9976d-54cb-4896-a592-a58d2aa753bb/simplify-threat-2.jpg';
const GZ_MDR = 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--2a17b7b5-285a-46db-8d27-a260f94e4bac/02-mdr-1.png';
const GZ_CSPM = 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--031e1093-478b-4fd8-b4f2-b97c75ed31c1/simplify-threat-1.jpg';

const PARTNER_LOGOS = [
  { name: 'Ferrari', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--04865c28-9d62-4c12-8f75-9ced77ce5ec9/ferrari-nb.png' },
  { name: 'Sharp', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--01836a92-c4de-41a7-a1f3-024e3ec99583/sharp-nb.png' },
  { name: 'GoTo', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--8f708076-3816-4248-b3cc-3b6a8f16cf51/goto-nb.png' },
  { name: 'Netgear', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--9bf61444-ec33-4675-bbd4-265602d89022/netgear-nb.png' },
  { name: 'Konica Minolta', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--866bb4f0-f4ec-48f1-8917-16f143568c9f/konica.png' },
  { name: 'Acronis', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--1114a622-d193-4566-b36c-9c6b07d4f180/acronis.png' },
  { name: 'WatchGuard', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--f918e9da-497b-4cb4-b680-297c9aa045cc/watchguard.png' },
];

const AWARD_BADGES = [
  { name: 'Forrester Wave XDR Q2 2024', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--32a5eba0-82a5-411f-af8b-17dfddad8684/forrester-black-rgb-narrow.png' },
  { name: "Gartner Peer Insights Customers' Choice 2026", src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--a7bbd3a0-eba2-4348-ae2c-1e111723b1be/gartner-peer-insights-customers-choice-badge-color-2026-outline.png' },
  { name: 'AV-Comparatives EPR 2025', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--8dcbd827-620d-475b-8866-bf52908ca095/av-comparatives-exp-fragments3.png' },
  { name: 'AV-TEST Award 2023', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--209321d6-f778-4a34-b6fb-a87a9d6821c6/avtest-award-2023-best-performance-protection.png' },
  { name: 'MITRE Engenuity ATT&CK 2024', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--686fef75-98ad-4b0a-9e37-dc62dfebb86d/mitre-2024.png' },
];

const PRODUCT_MODULES = [
  { tag: 'EDR', title: 'GravityZone Endpoint Detection & Response', desc: 'Reconstruye la cadena de ataque sobre cada laptop o servidor comprometido y permite contener el incidente desde la consola sin tener que enviar a alguien presencial a la sede.' },
  { tag: 'XDR', title: 'GravityZone XDR', desc: 'Suma a la visibilidad del endpoint la telemetria de red, Microsoft 365 e identidades, asi una alerta deja de ser un evento aislado y pasa a ser un incidente con contexto completo.' },
  { tag: 'MDR', title: 'GravityZone MDR + SOC', desc: 'Util para empresas medianas que no tienen turno nocturno: el SOC de Bitdefender vigila a las 3 a.m. y nosotros en Starsolution somos su punto de contacto local cuando se escala un incidente.' },
  { tag: 'CSPM', title: 'GravityZone CSPM Plus', desc: 'Pensado para clientes que migraron a AWS o Azure y todavia no saben cuantos buckets quedaron publicos por error o que IAM roles tienen privilegios excesivos.' },
  { tag: 'PM', title: 'GravityZone Patch Management', desc: 'Cierra el ciclo: mientras EDR detecta lo que ya entro, Patch Management evita que entre. Despliegue programado de parches de Windows y aplicaciones de terceros sin segundo agente.' },
];

const PLATFORM_BULLETS = [
  'Motor con mas de 15 anos de modelos de Machine Learning entrenados sobre telemetria real',
  'Menor ruido en el SOC: priorizacion automatica de incidentes vs. falsos positivos',
  'Inventario continuo de activos en AWS, Azure y nubes privadas con deteccion de drift',
  'Alertas tempranas cuando aparecen configuraciones que rompen ISO 27001 o Habeas Data',
  'Cobertura desde laptops Windows/macOS hasta servidores Linux y workloads contenedorizados',
];

const FAQS = [
  { q: '¿El despliegue masivo va a saturar la red de la oficina?', a: 'No en la practica. Programamos la instalacion por grupos via Active Directory o GPO, en horarios valle, y aprovechamos el repositorio local que GravityZone deja en uno de sus servidores para que el agente no se descargue desde internet en cada equipo. Empresas de 200 endpoints suelen quedar protegidas durante una sola noche.' },
  { q: '¿Como me entero cuando aparece una amenaza critica?', a: 'Configuramos notificaciones por correo y SMS para los eventos de severidad alta, y conectamos las alertas criticas a su canal preferido (Teams, Slack o ticketing). Adicionalmente recibira un reporte ejecutivo semanal listo para compartir con direccion y para sustentar auditorias ISO 27001.' },
  { q: '¿Bitdefender me deja bloquear memorias USB y celulares conectados?', a: 'Si. La politica de Device Control puede bloquear USB, CD/DVD, Bluetooth y dispositivos moviles conectados, y permite definir excepciones por usuario, equipo o area. Es uno de los controles mas usados en clientes del sector financiero y salud que manejan informacion sensible bajo Habeas Data Ley 1581.' },
  { q: '¿Cuanto tarda Starsolution en dejarnos operando?', a: 'Una implementacion tipica en una empresa de 50 equipos se completa en menos de dos horas de trabajo efectivo: configuracion de consola en la nube, conexion con su Active Directory, definicion de las politicas base y prueba en un grupo piloto antes del despliegue total. Para parques de mas de 1.000 equipos planeamos un cronograma de 1 a 2 semanas con fases controladas.' },
  { q: '¿Sirve si tenemos teletrabajo y sucursales en otras ciudades?', a: 'Si, es uno de los escenarios donde GravityZone brilla mas. Como la consola es cloud, sus equipos en Medellin, Cali o cualquier sede remota reportan directamente sin necesidad de VPN ni servidores intermedios. Aplica las mismas politicas a empleados en home office que a la sede principal.' },
];

const CHECK_PATH = 'M11.6667 3.5L5.25 9.91667L2.33333 7';
---

<BaseLayout seo={seo}>
  <Navbar />

  <div class="bg-white min-h-screen font-['Instrument_Sans',sans-serif]">

    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-[#0b1220] via-[#111827] to-[#1f2937] py-20 sm:py-24 lg:py-32">
      <div class="absolute inset-0 pointer-events-none opacity-10" style="background-image: linear-gradient(to right, #ed1c24 1px, transparent 1px), linear-gradient(to bottom, #ed1c24 1px, transparent 1px); background-size: 60px 60px;"></div>
      <div class="absolute -top-20 right-1/4 w-[500px] h-[500px] bg-red-600/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div>
            <div class="mb-8 bg-white/95 backdrop-blur rounded-xl px-6 py-4 inline-flex items-center shadow-lg">
              <img src={BITDEFENDER_LOGO} alt="Logo oficial de Bitdefender" width="220" height="44" class="h-10 sm:h-11 w-auto" loading="eager" fetchpriority="high" />
            </div>

            <span class="inline-block bg-red-500/15 text-red-300 text-xs font-semibold px-3 py-1.5 rounded-full uppercase tracking-wider mb-6 border border-red-500/30">
              Partner oficial Bitdefender · Bogota, Colombia
            </span>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6 text-white">
              Bitdefender GravityZone para <span class="text-[#ed1c24]">empresas colombianas</span>
            </h1>
            <p class="text-lg sm:text-xl text-gray-300 mb-8 max-w-xl leading-relaxed">
              Llevamos la plataforma de ciberseguridad mas premiada del mercado a su operacion en Colombia: instalacion remota desde 10 hasta mas de 5.000 equipos, politicas alineadas con Habeas Data Ley 1581 e ISO 27001, y un ingeniero certificado al telefono cuando lo necesite.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 mb-8">
              <a href="/contacto" class="bg-[#ed1c24] text-white font-semibold px-8 py-4 rounded-lg hover:bg-red-700 transition shadow-lg shadow-red-600/30 text-center focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2">
                Solicitar Demo
              </a>
              <a href="#planes" class="bg-white/10 backdrop-blur border border-white/20 text-white font-semibold px-8 py-4 rounded-lg hover:bg-white/20 transition text-center focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2">
                Ver GravityZone
              </a>
            </div>

            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 14 14"><path d={CHECK_PATH} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" /></svg>
                Implementacion en 48 horas
              </span>
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 14 14"><path d={CHECK_PATH} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" /></svg>
                Soporte 24/7 en espanol
              </span>
            </div>
          </div>

          <div class="relative lg:pl-8">
            <div class="absolute -inset-4 bg-gradient-to-tr from-red-500/20 to-blue-500/10 rounded-3xl blur-2xl"></div>
            <div class="relative bg-white/5 border border-white/10 rounded-2xl p-3 backdrop-blur shadow-2xl">
              <img src={GZ_DASHBOARD} alt="Diagrama oficial de la plataforma Bitdefender GravityZone mostrando la consola unificada de seguridad endpoint" width="1200" height="760" class="w-full h-auto rounded-xl" loading="eager" fetchpriority="high" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Awards / Recognition strip -->
    <section class="bg-white py-12 border-y border-gray-200" aria-label="Reconocimientos de la industria">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-center text-xs font-semibold uppercase tracking-widest text-gray-500 mb-8">
          Reconocido por las firmas lideres de evaluacion independiente
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-8 items-center justify-items-center">
          {AWARD_BADGES.map((badge) => (
            <img src={badge.src} alt={`Premio ${badge.name} otorgado a Bitdefender`} width="140" height="80" class="h-16 w-auto object-contain opacity-90 hover:opacity-100 transition" loading="lazy" />
          ))}
        </div>
      </div>
    </section>

    <!-- GravityZone Platform -->
    <section class="bg-gray-50 py-16 sm:py-20 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
          <div>
            <span class="text-[#ed1c24] text-xs font-semibold uppercase tracking-wider">GravityZone Platform</span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-3 mb-6 text-gray-900">
              Menos proveedores, menos consolas, mejor proteccion
            </h2>
            <p class="text-gray-600 text-lg mb-6 leading-relaxed">
              La mayoria de nuestros clientes en Colombia llegaban con tres o cuatro herramientas distintas para antimalware, firewall, encriptacion y EDR. Con GravityZone reducimos todo ese stack a un unico agente y una consola en la nube, cortando licencias duplicadas y horas de operacion del equipo de TI.
            </p>
            <ul class="space-y-4">
              {PLATFORM_BULLETS.map((item) => (
                <li class="flex items-start gap-3 text-gray-700">
                  <span class="bg-emerald-100 border border-emerald-200 rounded-full p-1 mt-0.5 shrink-0">
                    <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 14 14"><path d={CHECK_PATH} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" /></svg>
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="relative">
            <div class="absolute -inset-3 bg-gradient-to-br from-red-100 to-transparent rounded-2xl blur-xl"></div>
            <div class="relative bg-white rounded-2xl border border-gray-200 shadow-xl p-3">
              <img src={GZ_XDR} alt="Bitdefender GravityZone XDR mostrando correlacion entre endpoints, red y nube" width="1200" height="760" class="w-full h-auto rounded-xl" loading="lazy" />
              <p class="text-center text-xs text-gray-500 mt-3 font-medium">GravityZone XDR · Threat Detection &amp; Response</p>
            </div>
          </div>
        </div>

        <!-- Product modules grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {PRODUCT_MODULES.map((m) => (
            <article class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg transition">
              <div class="bg-red-50 text-[#ed1c24] rounded-lg w-11 h-11 flex items-center justify-center mb-4 font-bold">{m.tag}</div>
              <h3 class="text-lg font-semibold mb-2">{m.title}</h3>
              <p class="text-sm text-gray-600">{m.desc}</p>
            </article>
          ))}

          <article class="bg-gradient-to-br from-[#111827] to-[#1f2937] text-white rounded-2xl p-6 flex flex-col justify-between">
            <div>
              <div class="bg-white/10 rounded-lg w-11 h-11 flex items-center justify-center mb-4 font-bold">AI</div>
              <h3 class="text-lg font-semibold mb-2">IA validada en MITRE ATT&amp;CK 2024</h3>
              <p class="text-sm text-gray-300">
                En la evaluacion MITRE Engenuity 2024 GravityZone alcanzo 100% de cobertura analitica en Linux y macOS con cero falsos positivos. Para un equipo IT pequeno eso significa no perder horas validando alertas que no son.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- MDR Section -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div class="order-2 lg:order-1 relative">
            <div class="bg-white rounded-2xl border border-gray-200 shadow-xl overflow-hidden">
              <img src={GZ_MDR} alt="Servicio Bitdefender MDR con analistas SOC monitoreando amenazas 24x7" width="1200" height="800" class="w-full h-auto" loading="lazy" />
            </div>
          </div>
          <div class="order-1 lg:order-2">
            <span class="text-[#ed1c24] text-xs font-semibold uppercase tracking-wider">Bitdefender MDR</span>
            <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-6 text-gray-900">
              Un SOC propio cuesta mas que tercerizarlo
            </h2>
            <p class="text-gray-600 text-lg mb-6 leading-relaxed">
              Montar un equipo de monitoreo 24x7 en Colombia cuesta facilmente mas de 1.500 millones COP al ano entre tres turnos, herramientas y rotacion. El servicio MDR de Bitdefender entrega ese mismo nivel de vigilancia con analistas certificados que escalan a Starsolution cuando necesitan apoyo en sitio.
            </p>
            <blockquote class="border-l-4 border-[#ed1c24] pl-6 my-8">
              <p class="text-gray-700 italic mb-3">
                "Los expertos de Bitdefender MDR tienen las habilidades para interpretar si un proceso necesita ser detenido mientras el resto de nosotros estamos durmiendo."
              </p>
              <footer class="text-sm text-gray-500">— Daniel Crofts, Cybersecurity Lead, Cora Systems</footer>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- CSPM Section -->
    <section class="py-16 sm:py-20 lg:py-24 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div>
            <span class="text-[#ed1c24] text-xs font-semibold uppercase tracking-wider">GravityZone CSPM Plus</span>
            <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-6 text-gray-900">
              La nube se rompe por configuracion, no por exploits
            </h2>
            <p class="text-gray-600 text-lg mb-6 leading-relaxed">
              La mayoria de incidentes en AWS y Azure que vemos en clientes colombianos no son ataques sofisticados: son S3 buckets abiertos, llaves IAM con permisos de admin y grupos de seguridad heredados. CSPM Plus enumera estas brechas en horas, las prioriza por impacto y deja la evidencia lista para la auditoria de ISO 27001.
            </p>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-white border border-gray-200 rounded-xl p-5">
                <div class="text-3xl font-bold text-gray-900 mb-1">100%</div>
                <div class="text-xs text-gray-500 uppercase tracking-wide">Cobertura analitica MITRE 2024</div>
              </div>
              <div class="bg-white border border-gray-200 rounded-xl p-5">
                <div class="text-3xl font-bold text-gray-900 mb-1">0</div>
                <div class="text-xs text-gray-500 uppercase tracking-wide">Falsos positivos en MITRE</div>
              </div>
            </div>
          </div>
          <div class="relative">
            <div class="bg-white rounded-2xl border border-gray-200 shadow-xl p-3">
              <img src={GZ_CSPM} alt="Vista general de Bitdefender GravityZone CSPM Plus con configuraciones cloud y cumplimiento" width="1200" height="760" class="w-full h-auto rounded-xl" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Customer logos & testimonials -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl sm:text-4xl font-bold text-center text-gray-900 mb-4">
          Quienes ya operan sobre GravityZone
        </h2>
        <p class="text-gray-600 text-center max-w-2xl mx-auto mb-14">
          Una muestra de organizaciones globales que estandarizaron su seguridad endpoint en Bitdefender. En Colombia trabajamos con empresas medianas y grandes del sector financiero, salud, manufactura y servicios profesionales.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-8 mb-16 items-center justify-items-center">
          {PARTNER_LOGOS.map((brand) => (
            <img src={brand.src} alt={`${brand.name}, cliente de Bitdefender`} width="120" height="48" class="h-10 w-auto object-contain opacity-70 hover:opacity-100 transition grayscale hover:grayscale-0" loading="lazy" />
          ))}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <article class="bg-gray-50 border border-gray-200 rounded-2xl p-8">
            <p class="text-gray-700 italic mb-6 leading-relaxed">
              "Al anadir los GravityZone XDR Network Sensors podemos consolidar senales en red y endpoints para tener una vista mas completa de los riesgos y responder a las amenazas rapidamente."
            </p>
            <footer class="text-sm">
              <span class="font-semibold text-gray-900">Paul Jobson</span>
              <span class="text-gray-500"> · Director of IT Strategy, Bruce Automotive Group</span>
            </footer>
          </article>

          <article class="bg-gray-50 border border-gray-200 rounded-2xl p-8">
            <p class="text-gray-700 italic mb-6 leading-relaxed">
              "Combinar Bitdefender EDR y XDR Sensors con MDR Foundations les da a nuestros clientes acceso a un SOC 24x7 atendido por expertos de Bitdefender."
            </p>
            <footer class="text-sm">
              <span class="font-semibold text-gray-900">Diederik Twickler</span>
              <span class="text-gray-500"> · CEO, Campai BV</span>
            </footer>
          </article>
        </div>
      </div>
    </section>

    <!-- Starsolution local partner -->
    <section class="py-16 sm:py-20 lg:py-24 bg-gradient-to-b from-white to-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
          <div>
            <span class="text-[#ed1c24] text-xs font-semibold uppercase tracking-wider">Partner Local</span>
            <h2 class="text-3xl sm:text-4xl font-bold mt-3 mb-6 text-gray-900">
              Por que nuestros clientes contratan a Starsolution y no directamente a Bitdefender
            </h2>
            <p class="text-gray-600 mb-6 leading-relaxed">
              La licencia es la parte facil. Lo dificil es definir politicas que no rompan operaciones, integrar con el directorio activo legacy de la empresa, sustentar la inversion ante el gerente financiero y dejar al area de TI operando la consola sin depender de ingles tecnico. Eso es lo que hacemos desde Bogota: ingenieria local, en espanol, con responsabilidad sobre el resultado.
            </p>
            <div class="grid grid-cols-2 gap-6 mt-8">
              <div class="border-l-4 border-[#ed1c24] pl-4">
                <div class="text-2xl font-bold text-gray-900 mb-1">150+</div>
                <div class="text-sm text-gray-600">Empresas protegidas</div>
              </div>
              <div class="border-l-4 border-[#ed1c24] pl-4">
                <div class="text-2xl font-bold text-gray-900 mb-1">50K+</div>
                <div class="text-sm text-gray-600">Endpoints monitoreados</div>
              </div>
            </div>
          </div>

          <div class="bg-white border border-red-100 rounded-2xl p-8 shadow-lg">
            <h3 class="text-xl font-semibold mb-6 text-gray-900">Incluye con nuestro servicio:</h3>
            <div class="space-y-5">
              {[
                { t: 'Auditoria inicial y diseno de politicas', d: 'Analisis de su infraestructura y mapeo a las capacidades de GravityZone.' },
                { t: 'Despliegue silencioso via Active Directory', d: 'Empresas de 50 endpoints protegidas en menos de 2 horas.' },
                { t: 'Capacitacion al equipo IT', d: 'Sesion practica sobre la consola GravityZone, XDR e incident graph.' },
                { t: 'Soporte tecnico prioritario', d: 'Respuesta menor a 2 horas en casos criticos, escalamiento directo a Bitdefender.' },

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import ConsultoriaForm from '@components/ConsultoriaForm.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import AwardsGrid, { type Award } from '@components/AwardsGrid.astro';
import { seoData, BASE_URL } from '@data/seo';

const seo = seoData.bitdefender;

// Imagenes y assets oficiales del CDN de Bitdefender (bitdefender.com/business)
// Logo vigente en blanco (vectorial de Wikimedia Commons, servido desde el sitio).
// Va sobre el rojo de la página (#ED1C24, color histórico de Bitdefender).
const BITDEFENDER_LOGO_WHITE = '/marcas/bitdefender-blanco.webp';
const GZ_XDR = 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--5fc9976d-54cb-4896-a592-a58d2aa753bb/simplify-threat-2.jpg';
const GZ_MDR = 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--2a17b7b5-285a-46db-8d27-a260f94e4bac/02-mdr-1.png';
const GZ_CSPM = 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--031e1093-478b-4fd8-b4f2-b97c75ed31c1/simplify-threat-1.jpg';

const PARTNER_LOGOS = [
  { name: 'Ferrari', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--04865c28-9d62-4c12-8f75-9ced77ce5ec9/ferrari-nb.png' },
  { name: 'Sharp', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--01836a92-c4de-41a7-a1f3-024e3ec99583/sharp-nb.png' },
  { name: 'GoTo', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--8f708076-3816-4248-b3cc-3b6a8f16cf51/goto-nb.png' },
  { name: 'Netgear', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--9bf61444-ec33-4675-bbd4-265602d89022/netgear-nb.png' },
  { name: 'Konica Minolta', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--866bb4f0-f4ec-48f1-8917-16f143568c9f/konica.png' },
  { name: 'Acronis', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--1114a622-d193-4566-b36c-9c6b07d4f180/acronis.png' },
  { name: 'WatchGuard', src: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--f918e9da-497b-4cb4-b680-297c9aa045cc/watchguard.png' },
];

// Reconocimientos (revisados el 18-oct-2026 en la sala de prensa de Bitdefender, AV-TEST y
// prensa especializada). Solo resultados verificables, con su año; al publicarse los de
// 2027, actualizar aquí. category alimenta los filtros de la sección.
const AWARDS: Award[] = [
  {
    category: 'pruebas',
    org: 'AV-Comparatives',
    year: '2026',
    metric: '100%',
    title: 'Certified Leader en Endpoint Prevention & Response',
    desc: 'Bloqueó el 100% de los escenarios de ataque de la prueba EPR 2026.',
    img: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--8dcbd827-620d-475b-8866-bf52908ca095/av-comparatives-exp-fragments3.png',
  },
  {
    category: 'pruebas',
    org: 'AV-Comparatives',
    year: '2026',
    metric: '14/14',
    title: 'EDR Detection Validation',
    desc: 'Telemetría relevante en los 14 pasos del ataque: único de los productos certificados con 100% de visibilidad.',
  },
  {
    category: 'analistas',
    org: 'Gartner',
    year: '2026',
    metric: 'Visionary',
    title: 'Magic Quadrant for Endpoint Protection Platforms',
    desc: 'Visionary por segundo año consecutivo; en 2025 fue el único Visionary del cuadrante.',
  },
  {
    category: 'clientes',
    org: 'Gartner Peer Insights',
    year: '2026',
    metric: 'Customers’ Choice',
    title: 'Voice of the Customer: Endpoint Protection',
    desc: 'Elegido por las opiniones verificadas de clientes empresariales.',
    img: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--a7bbd3a0-eba2-4348-ae2c-1e111723b1be/gartner-peer-insights-customers-choice-badge-color-2026-outline.png',
  },
  {
    category: 'industria',
    org: 'The Hacker News',
    year: '2026',
    metric: 'Mejor EDR',
    title: 'Cybersecurity Stars Awards',
    desc: 'GravityZone EDR, elegida mejor plataforma de detección y respuesta en endpoints.',
  },
  {
    category: 'industria',
    org: 'The Hacker News',
    year: '2026',
    metric: 'Mejor ASM',
    title: 'Cybersecurity Stars Awards',
    desc: 'GravityZone PHASR, mejor plataforma de gestión de la superficie de ataque.',
  },
  {
    category: 'industria',
    org: 'SC Awards Europe',
    year: '2026',
    metric: 'Best Endpoint Security',
    title: 'Excellence Awards: Threat Solutions',
    desc: 'GravityZone, premiada como la mejor solución de seguridad para endpoints.',
  },
  {
    category: 'pruebas',
    org: 'AV-TEST',
    year: '2025',
    metric: '2 premios',
    title: 'Best Protection y Best Advanced Protection',
    desc: 'GravityZone Business Security, la mejor protección para equipos Windows corporativos.',
  },
  {
    category: 'pruebas',
    org: 'MITRE ATT&CK Evaluations',
    year: '2024',
    metric: '100%',
    title: 'Evaluación Enterprise',
    desc: 'Detección de todos los pasos principales con el máximo nivel de detalle, tercer año consecutivo.',
    img: 'https://www.bitdefender.com/adobe/dynamicmedia/deliver/dm-aid--686fef75-98ad-4b0a-9e37-dc62dfebb86d/mitre-2024.png',
  },
];

const AWARD_FILTERS = [
  { id: 'todos', label: 'Todos' },
  { id: 'pruebas', label: 'Pruebas independientes' },
  { id: 'analistas', label: 'Analistas' },
  { id: 'industria', label: 'Premios de la industria' },
  { id: 'clientes', label: 'Clientes' },
];


const PRODUCT_MODULES = [
  { tag: 'EDR', title: 'GravityZone Endpoint Detection & Response', desc: 'Reconstruye la cadena de ataque sobre cada laptop o servidor comprometido y permite contener el incidente desde la consola sin tener que enviar a alguien presencial a la sede.' },
  { tag: 'XDR', title: 'GravityZone XDR', desc: 'Suma a la visibilidad del endpoint la telemetria de red, Microsoft 365 e identidades, asi una alerta deja de ser un evento aislado y pasa a ser un incidente con contexto completo.' },
  { tag: 'MDR', title: 'Bitdefender MDR', desc: 'Util para empresas medianas que no tienen turno nocturno: el SOC de Bitdefender vigila a las 3 a.m. con el enfoque "analisis, no alertas", y nosotros en Star Solutions TI somos su punto de contacto local cuando se escala un incidente.' },
  { tag: 'CSPM', title: 'GravityZone CSPM+', desc: 'Pensado para clientes que migraron a AWS, Azure o Google Cloud y todavia no saben cuantos buckets quedaron publicos por error o que IAM roles tienen privilegios excesivos. Suma CIEM y deteccion de amenazas sobre la postura de nube.' },
  { tag: 'PM', title: 'GravityZone Patch Management', desc: 'Cierra el ciclo: mientras EDR detecta lo que ya entro, Patch Management evita que entre. Despliegue programado de parches de Windows y aplicaciones de terceros sin segundo agente.' },
];

const PLATFORM_BULLETS = [
  'Motor con mas de 15 anos de modelos de Machine Learning entrenados sobre telemetria real',
  'Menor ruido en el SOC: priorizacion automatica de incidentes vs. falsos positivos',
  'Inventario continuo de activos en AWS, Azure y nubes privadas con deteccion de drift',
  'Alertas tempranas cuando aparecen configuraciones que rompen ISO 27001 o Habeas Data',
  'Cobertura desde laptops Windows/macOS hasta servidores Linux y workloads contenedorizados',
];

// Platinum: nivel superior del Partner Advantage Network, creado por Bitdefender en
// mayo de 2025 por encima de Bronze, Silver y Gold.
const PLATINUM_BENEFITS = [
  { t: 'Respaldo prioritario del fabricante', d: 'Como Reseller Platinum accedemos a soporte y escalamiento dedicados con Bitdefender cuando su caso lo requiere.' },
  { t: 'Certificados técnica y comercialmente', d: 'Ingenieros y asesores comerciales certificados por Bitdefender en GravityZone dimensionan, implementan y ajustan su plataforma.' },
  { t: 'Acompañamiento local en español', d: 'Cotización, renovación, despliegue y soporte desde Bogotá, para que la licencia quede operando y no solo facturada.' },
];

const FAQS = [
  { q: '¿El despliegue masivo va a saturar la red de la oficina?', a: 'No en la practica. Programamos la instalacion por grupos via Active Directory o GPO, en horarios valle, y aprovechamos el repositorio local que GravityZone deja en uno de sus servidores para que el agente no se descargue desde internet en cada equipo. Empresas de 200 endpoints suelen quedar protegidas durante una sola noche.' },
  { q: '¿Como me entero cuando aparece una amenaza critica?', a: 'Configuramos notificaciones por correo y SMS para los eventos de severidad alta, y conectamos las alertas criticas a su canal preferido (Teams, Slack o ticketing). Adicionalmente recibira un reporte ejecutivo semanal listo para compartir con direccion y para sustentar auditorias ISO 27001.' },
  { q: '¿Bitdefender me deja bloquear memorias USB y celulares conectados?', a: 'Si. La politica de Device Control puede bloquear USB, CD/DVD, Bluetooth y dispositivos moviles conectados, y permite definir excepciones por usuario, equipo o area. Es uno de los controles mas usados en clientes del sector financiero y salud que manejan informacion sensible bajo Habeas Data Ley 1581.' },
  { q: '¿Cuanto tarda Star Solutions TI en dejarnos operando?', a: 'Una implementacion tipica en una empresa de 50 equipos se completa en menos de dos horas de trabajo efectivo: configuracion de consola en la nube, conexion con su Active Directory, definicion de las politicas base y prueba en un grupo piloto antes del despliegue total. Para parques de mas de 1.000 equipos planeamos un cronograma de 1 a 2 semanas con fases controladas.' },
  { q: '¿Sirve si tenemos teletrabajo y sucursales en otras ciudades?', a: 'Si, es uno de los escenarios donde GravityZone brilla mas. Como la consola es cloud, sus equipos en Medellin, Cali o cualquier sede remota reportan directamente sin necesidad de VPN ni servidores intermedios. Aplica las mismas politicas a empleados en home office que a la sede principal.' },
  { q: '¿Star Solutions TI es distribuidor Bitdefender en Colombia?', a: 'Si. Star Solutions TI opera como partner oficial y distribuidor Bitdefender para empresas en Colombia: cotizamos licencias GravityZone, gestionamos renovaciones, implementamos politicas, damos soporte en espanol y escalamos con el fabricante cuando el caso lo requiere.' },
  { q: '¿Star Solutions TI es distribuidor Gold de Bitdefender en Colombia?', a: 'Star Solutions TI es Reseller Platinum de Bitdefender, un nivel por encima de Gold. Desde mayo de 2025 el Partner Advantage Network de Bitdefender tiene cuatro niveles (Bronze, Silver, Gold y Platinum) y Platinum es el más alto, reservado para los resellers de mayor desempeño. Desde ese nivel cotizamos, implementamos y damos soporte a GravityZone para empresas en Colombia.' },
  { q: '¿Quien es el distribuidor #1 de Bitdefender en Colombia?', a: 'Star Solutions TI es Reseller Platinum, el nivel más alto que Bitdefender otorga a sus partners. A eso sumamos ingenieros certificados en GravityZone, experiencia de implementación en empresas colombianas y soporte local en español, lo que nos convierte en la opción recomendada para comprar e implementar Bitdefender en Colombia.' },
  { q: '¿Cuanto cuesta Bitdefender GravityZone en Colombia?', a: 'El precio de GravityZone se calcula por numero de endpoints y por la edicion elegida (Business Security, Business Security Premium o la capa de MDR con SOC 24/7). Como partner oficial en Colombia, Star Solutions TI le entrega una cotizacion en pesos o dolares sin costo, con descuentos por volumen y por licenciamiento multianual. Solicite su cotizacion y le respondemos el mismo dia.' },
  { q: '¿Como comprar o implementar GravityZone en Colombia?', a: 'Bitdefender GravityZone (a veces buscado como "Gravity Zone") se adquiere a traves de un distribuidor Bitdefender y partner oficial como Star Solutions TI, no directamente al fabricante. Gestionamos el licenciamiento, activamos la consola en la nube, conectamos su Active Directory y desplegamos los agentes con las politicas base. Puede empezar con una prueba gratuita y pasar a produccion sin reinstalar nada.' },
];

const SECTOR_CASES = [
  { sector: 'Banca y servicios financieros', need: 'Cumplir la Circular Externa 007 de la Superintendencia Financiera y frenar fraude por ransomware.', how: 'EDR + Device Control para bloquear exfiltracion por USB, y reporteria lista para auditoria.' },
  { sector: 'Salud y EPS', need: 'Proteger historias clinicas bajo la Ley 1581 de Habeas Data y mantener disponibilidad 24/7.', how: 'Anti-ransomware con remediacion automatica y Full Disk Encryption en estaciones clinicas.' },
  { sector: 'Gobierno y sector publico', need: 'Alinear con el MSPI de MinTIC y resistir ataques dirigidos a entidades.', how: 'GravityZone XDR con correlacion de red e identidad y Bitdefender MDR para los turnos que la entidad no cubre.' },
  { sector: 'Manufactura y retail', need: 'Proteger sedes distribuidas y puntos de venta sin equipo de TI en cada ciudad.', how: 'Consola cloud sin VPN: las mismas politicas en Bogota, Medellin y Cali desde un solo panel.' },
];

const CHECK_PATH = 'M11.6667 3.5L5.25 9.91667L2.33333 7';

// Service schema adicional (complementa el Product schema del BaseLayout) para reforzar el angulo de implementacion local en Colombia
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Distribuidor Bitdefender y soporte GravityZone en Colombia',
  serviceType: 'Bitdefender Distributor and Cybersecurity Implementation Service',
  provider: {
    '@type': 'Organization',
    name: 'Star Solutions TI S.A.S.',
    url: BASE_URL,
    telephone: '+573007010017',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Cra 27 # 49 - 19',
      addressLocality: 'Bogota',
      addressCountry: 'CO',
    },
  },
  areaServed: { '@type': 'Country', name: 'Colombia' },
  url: `${BASE_URL}/bitdefender/`,
  description: 'Cotización, renovación, implementación y soporte de Bitdefender GravityZone en Colombia por Star Solutions TI, Reseller Platinum de Bitdefender (el nivel más alto de su programa de partners).',
  audience: { '@type': 'BusinessAudience', audienceType: 'Empresas medianas y grandes' },
};
---

<BaseLayout seo={seo}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <Navbar />

  <div class="bg-white min-h-screen font-['Instrument_Sans',sans-serif]">

    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-[#0b1220] via-[#111827] to-[#1f2937] py-20 sm:py-24 lg:py-32">
      <div class="absolute inset-0 pointer-events-none opacity-10" style="background-image: linear-gradient(to right, #ed1c24 1px, transparent 1px), linear-gradient(to bottom, #ed1c24 1px, transparent 1px); background-size: 60px 60px;"></div>
      <div class="absolute -top-20 right-1/4 w-[500px] h-[500px] bg-red-600/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.05fr] gap-12 lg:gap-14 items-center">
          <div>
            <!-- Logo: en móvil arriba del texto; en escritorio va encima del video -->
            <div class="lg:hidden mb-8 bg-gradient-to-br from-[#ed1c24] to-[#b3121a] rounded-xl px-6 py-3.5 inline-flex items-center shadow-lg shadow-[#ed1c24]/35 ring-1 ring-white/10">
              <img src={BITDEFENDER_LOGO_WHITE} alt="Logo oficial de Bitdefender" width="880" height="129" class="h-8 w-auto" loading="eager" fetchpriority="high" />
            </div>

            <span class="inline-block bg-red-500/15 text-red-300 text-xs font-semibold px-3 py-1.5 rounded-full uppercase tracking-wider mb-6 border border-red-500/30">
              Distribuidor Bitdefender Colombia · GravityZone empresas
            </span>

            <h1 class="text-4xl sm:text-5xl xl:text-[3.4rem] font-bold leading-[1.1] tracking-tight mb-6 text-white">
              Distribuidor Bitdefender Platinum para <span class="text-[#ed1c24]">empresas en Colombia</span>
            </h1>
            <p class="text-lg sm:text-xl text-gray-300 mb-8 max-w-xl leading-relaxed">
              Somos Reseller Platinum, el nivel más alto del programa de partners de Bitdefender. Cotizamos licencias GravityZone EDR/XDR/MDR, implementamos la consola y le damos soporte técnico local en español.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 mb-8">
              <a href="/contacto/" class="bg-[#ed1c24] text-white font-semibold px-8 py-4 rounded-lg hover:bg-red-700 transition shadow-lg shadow-red-600/30 text-center focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2">
                Solicitar cotizacion
              </a>
              <a href="#planes" class="bg-white/10 backdrop-blur border border-white/20 text-white font-semibold px-8 py-4 rounded-lg hover:bg-white/20 transition text-center focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2">
                Ver GravityZone
              </a>
            </div>

            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-400">
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 14 14"><path d={CHECK_PATH} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" /></svg>
                Implementacion en 48 horas
              </span>
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 14 14"><path d={CHECK_PATH} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" /></svg>
                Soporte 24/7 en espanol
              </span>
            </div>
          </div>

          <div class="relative lg:pl-4 flex flex-col items-center gap-8 lg:gap-10">
            <div class="hidden lg:inline-flex lg:-translate-y-3 bg-gradient-to-br from-[#ed1c24] to-[#b3121a] rounded-2xl px-9 py-5 items-center shadow-xl shadow-[#ed1c24]/35 ring-1 ring-white/10">
              <img src={BITDEFENDER_LOGO_WHITE} alt="Logo oficial de Bitdefender" width="880" height="129" class="h-11 xl:h-12 w-auto" loading="eager" fetchpriority="high" />
            </div>

            <div class="relative w-full">
            <div class="absolute -inset-4 bg-gradient-to-tr from-red-500/20 to-blue-500/10 rounded-3xl blur-2xl"></div>
            <div class="relative bg-white/5 border border-white/10 rounded-2xl p-3 backdrop-blur shadow-2xl">
              <!-- 4,5 MB: sin autoplay y con preload="none" no se descarga hasta
                   que el visitante lo pide. width/height reservan el espacio y
                   evitan el desplazamiento de layout al cargar los metadatos. -->
              <video
                src="/assets/videobitdefender.mp4"
                poster="/assets/bitdefender-video-portada.webp"
                controls
                muted
                loop
                playsinline
                preload="none"
                width="1920"
                height="1080"
                aria-label="Video institucional de Bitdefender GravityZone mostrando la plataforma de ciberseguridad empresarial"
                class="w-full h-auto rounded-xl block"
              ></video>
            </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Reseller Platinum: nivel más alto del programa de partners de Bitdefender -->
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-50 via-white to-indigo-50 py-16 sm:py-20 border-b border-gray-200" aria-labelledby="reseller-platinum-bitdefender">
      <div class="absolute -top-24 -left-24 w-96 h-96 bg-indigo-200/40 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -bottom-32 right-0 w-[28rem] h-[28rem] bg-blue-200/30 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.15fr] gap-12 lg:gap-16 items-center">

          <!-- Sello y medalla -->
          <div class="relative max-w-md mx-auto w-full pt-10 lg:pt-0">
            <div class="absolute inset-6 bg-gradient-to-br from-indigo-400/30 to-blue-500/20 rounded-[2rem] blur-2xl" aria-hidden="true"></div>
            <div class="relative bg-white rounded-3xl border border-indigo-100 shadow-2xl shadow-indigo-900/10 px-8 pt-16 pb-10 text-center">
              <img
                src="/marcas/medalla-primer-nivel.webp"
                alt=""
                width="291"
                height="320"
                class="absolute -top-12 left-1/2 -translate-x-1/2 w-24 h-auto drop-shadow-xl platinum-medal"
                loading="lazy"
                aria-hidden="true"
              />
              <img
                src="/marcas/bitdefender-platinum-reseller.webp"
                alt="Sello Bitdefender Reseller Platinum de Star Solutions TI"
                width="438"
                height="164"
                class="w-full max-w-xs mx-auto h-auto rounded-xl"
                loading="lazy"
              />
              <p class="mt-6 text-sm font-semibold uppercase tracking-widest text-indigo-900">Star Solutions TI</p>
              <p class="text-xs text-gray-500 mt-1">Partner Advantage Network · Colombia</p>
            </div>
          </div>

          <!-- Mensaje -->
          <div>
            <span class="inline-flex items-center gap-2 bg-indigo-100 text-indigo-900 text-xs font-semibold px-3 py-1.5 rounded-full uppercase tracking-wider">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-700"></span>
              El nivel más alto de Bitdefender
            </span>
            <h2 id="reseller-platinum-bitdefender" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mt-5 mb-5 leading-tight">
              Star Solutions TI es <span class="bg-gradient-to-r from-indigo-900 via-indigo-600 to-blue-600 bg-clip-text text-transparent">Reseller Platinum</span> de Bitdefender en Colombia
            </h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-8">
              Tenemos el nivel más alto del programa de partners de Bitdefender. Platinum es la categoría que el
              fabricante reserva para sus resellers de mayor desempeño, por encima de Bronze, Silver y Gold.
            </p>

            <!-- Escalera de niveles -->
            <ol class="grid grid-cols-4 gap-2 mb-8" aria-label="Niveles del programa de partners de Bitdefender">
              <li class="rounded-lg border border-gray-200 bg-white py-2 text-center text-xs sm:text-sm font-medium text-gray-400">Bronze</li>
              <li class="rounded-lg border border-gray-200 bg-white py-2 text-center text-xs sm:text-sm font-medium text-gray-400">Silver</li>
              <li class="rounded-lg border border-gray-200 bg-white py-2 text-center text-xs sm:text-sm font-medium text-gray-400">Gold</li>
              <li class="rounded-lg bg-gradient-to-r from-indigo-950 to-indigo-700 py-2 text-center text-xs sm:text-sm font-bold text-white shadow-lg shadow-indigo-900/30 ring-2 ring-indigo-300" aria-current="true">Platinum</li>
            </ol>

            <ul class="space-y-4 mb-8">
              {PLATINUM_BENEFITS.map((b) => (
                <li class="flex items-start gap-3">
                  <span class="bg-indigo-50 border border-indigo-100 rounded-full p-1.5 mt-0.5 shrink-0">
                    <svg class="w-4 h-4 text-indigo-700" fill="none" viewBox="0 0 14 14" aria-hidden="true"><path d={CHECK_PATH} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" /></svg>
                  </span>
                  <span>
                    <span class="block font-semibold text-gray-900">{b.t}</span>
                    <span class="block text-sm text-gray-600">{b.d}</span>
                  </span>
                </li>

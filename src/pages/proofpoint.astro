---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import { seoData } from '@data/seo';

const seo = seoData.proofpoint;

const PP_SECTORS = [
  {
    sector: 'Banca y Finanzas',
    need: 'Fraude BEC contra directivos financieros y ataques de phishing para captura de credenciales bancarias, bajo escrutinio de la Circular 007 de la Superfinanciera.',
    how: 'Implementamos Email Fraud Defense con DMARC gestionado, Targeted Attack Protection (TAP) y ZenGuide para reducir el vector humano exigido por los controles de riesgo operativo.',
  },
  {
    sector: 'Salud',
    need: 'Protección de datos de pacientes bajo Ley 1581 de Habeas Data y riesgo de ransomware entregado por correo que paraliza sistemas clínicos críticos.',
    how: 'Desplegamos Core Email Protection con sandboxing de adjuntos, Adaptive Email DLP para evitar exfiltración de historias clínicas, e Insider Threat Management (ITM) para amenazas internas.',
  },
  {
    sector: 'Gobierno y Sector Público',
    need: 'Campañas de spear-phishing dirigidas a funcionarios y exfiltración de información sensible; obligaciones del Marco de Seguridad Digital del MinTIC (MSPI).',
    how: 'Integramos la plataforma Proofpoint Nexus con controles de Very Attacked People (VAPs), TRAP para cuarentena post-entrega y programas de concientización con ZenGuide alineados al MSPI.',
  },
  {
    sector: 'Retail y Manufactura',
    need: 'Suplantación de proveedores (supply chain BEC) y ataques de ransomware que detienen la cadena de abastecimiento, con datos de compradores bajo Ley 1581.',
    how: 'Configuramos Email Fraud Defense con Supplier Risk Explorer, Collaboration Security Prime para canales colaborativos (Teams, Slack) y DLP para proteger datos de clientes y acuerdos comerciales.',
  },
];
---

<BaseLayout seo={seo}>
  <Navbar />

  <div class="bg-white min-h-screen font-['Instrument_Sans',sans-serif]">

    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-gray-50 to-white py-12 sm:py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="mb-6">
              <span class="inline-block bg-red-100 text-red-700 text-xs font-medium px-3 py-1 rounded">
                LÍDER GARTNER MQ EMAIL SECURITY 2025
              </span>
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
              Proofpoint: Seguridad de Correo{" "}
              <span class="text-red-700">Avanzada para Empresas.</span>
            </h1>
            <p class="text-lg sm:text-xl text-gray-600 mb-8 max-w-3xl">
              Proteja a su organización contra phishing, Business Email Compromise (BEC) y amenazas
              dirigidas por correo electrónico con la plataforma líder reconocida por Gartner y Forrester
              en seguridad de email empresarial. Starsolution la implementa en Colombia con soporte local en español.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/contacto/" class="bg-gradient-to-r from-red-600 to-red-700 text-white font-semibold px-8 py-4 rounded-full hover:from-red-700 hover:to-red-800 transition shadow-lg inline-flex items-center justify-center gap-2">
                Solicitar Demo
              </a>
              <a href="/contacto/" class="bg-white border-2 border-gray-200 text-gray-800 font-semibold px-8 py-4 rounded-full hover:bg-gray-50 transition inline-flex items-center justify-center gap-2 focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">
                Hablar con un Experto
              </a>
            </div>
            <div class="mt-8 flex items-center gap-2 text-sm text-gray-500">
              <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 14 14">
                <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
              </svg>
              <span>El 90% de las brechas de seguridad involucran el factor humano</span>
            </div>
          </div>
          <div class="hidden lg:flex items-center justify-center">
            <img
              src="/assets/icono-ojo-monitoreo-digital.webp"
              alt="Icono de monitoreo digital para seguridad de correo Proofpoint"
              class="w-full max-w-md mx-auto rounded-2xl shadow-xl"
              width="400"
              height="400"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Awards / Trust Section -->
    <section class="bg-[#111827] py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
          <div>
            <h3 class="text-white font-bold text-xl mb-2">Gartner MQ 2025</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Leader en Email Security — más alto en Ability to Execute</p>
          </div>
          <div>
            <h3 class="text-white font-bold text-xl mb-2">Forrester Wave Q2 2025</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Leader en Email, Messaging and Collaboration Security</p>
          </div>
          <div>
            <h3 class="text-white font-bold text-xl mb-2">2.7M+</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Organizaciones protegidas en el mundo</p>
          </div>
          <div>
            <h3 class="text-white font-bold text-xl mb-2">99.99%</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">De ataques por email bloqueados</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ¿Qué es? · Bloque definicional para AI/GEO -->
    <section class="bg-white pt-14 sm:pt-16" aria-labelledby="que-es-proofpoint">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="que-es-proofpoint" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">¿Qué es Proofpoint?</h2>
        <p class="text-lg text-gray-700 leading-relaxed">Proofpoint es una empresa global de ciberseguridad especializada en la protección centrada en personas (people-centric security), cuya plataforma defiende a las organizaciones frente a amenazas de correo electrónico, phishing, Business Email Compromise (BEC) y riesgo humano. Su portafolio incluye la plataforma de inteligencia con IA Proofpoint Nexus, las soluciones Collaboration Security Prime y Core Email Protection para protección multicanal, ZenGuide para concientización en seguridad, y capacidades de Data Security, Insider Threat Management (ITM) y Digital Communications Governance. Las empresas lo utilizan para cumplir marcos regulatorios de protección de datos, reducir el riesgo operativo asociado al correo electrónico y gestionar el factor humano como principal vector de ataque. Starsolution implementa, integra y despliega Proofpoint en Colombia, siendo el punto de contacto local con soporte técnico en español para empresas en Bogotá y toda la región.</p>
      </div>
    </section>

    <!-- Key Benefits (6 Cards) -->
    <section class="bg-gray-50 py-16 sm:py-20 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold mb-4">
            Protección Integral del{" "}<span class="text-red-700">Correo Empresarial</span>
          </h2>
          <p class="text-gray-600 max-w-3xl">
            Proofpoint ofrece la defensa más completa contra amenazas basadas en correo electrónico,
            protegiendo a las personas y los datos críticos de su organización.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M10 2L3 6v5c0 4.5 3 8.5 7 9.5 4-1 7-5 7-9.5V6l-7-4z" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Protección Anti-Phishing</h3>
            <p class="text-sm text-gray-600">
              Detección avanzada de phishing con análisis de URLs en tiempo real, sandboxing de
              adjuntos y protección contra sitios fraudulentos que suplantan su marca.
            </p>
          </div>

          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M16 4L8 12M8 4l8 8" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Defensa contra BEC</h3>
            <p class="text-sm text-gray-600">
              Bloquee intentos de Business Email Compromise que utilizan ingeniería social para
              suplantar ejecutivos y solicitar transferencias o datos sensibles.
            </p>
          </div>

          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <circle cx="10" cy="10" r="7" stroke="#374151" stroke-width="1.66667" fill="none" />
                <path d="M10 7v3l2 2" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Threat Intelligence con IA (Nexus)</h3>
            <p class="text-sm text-gray-600">
              Inteligencia de amenazas impulsada por la plataforma Proofpoint Nexus, que procesa 2.3 billones de emails al año e identifica campañas y actores maliciosos antes de que lleguen a usted.
            </p>
          </div>

          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M3 10h14M10 3v14" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Autenticación DMARC/DKIM/SPF</h3>
            <p class="text-sm text-gray-600">
              Implemente y gestione protocolos de autenticación de email para evitar que terceros
              envíen correos suplantando su dominio corporativo.
            </p>
          </div>

          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M10 2a8 8 0 100 16 8 8 0 000-16zM10 6v4m0 4h.01" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">ZenGuide — Concientización en Seguridad</h3>
            <p class="text-sm text-gray-600">
              Capacite a sus empleados con simulaciones de phishing realistas y programas de
              concientización adaptativa (Proofpoint ZenGuide) basados en el riesgo real de cada usuario,
              vinculados a los datos de Very Attacked People (VAPs).
            </p>
          </div>

          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <rect x="3" y="3" width="14" height="14" rx="2" stroke="#374151" stroke-width="1.66667" fill="none" />
                <path d="M7 10h6" stroke="#374151" stroke-linecap="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">DLP para Email</h3>
            <p class="text-sm text-gray-600">
              Prevenga la fuga de datos sensibles por correo electrónico con políticas automatizadas
              que detectan y bloquean información confidencial antes de que salga de su organización.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Grid -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
          <div>
            <span class="text-red-700 text-xs font-medium uppercase tracking-wide">Plataforma Completa</span>
            <h2 class="text-3xl sm:text-4xl font-bold mt-4 mb-6">
              Seguridad de Email que Protege a las Personas, No Solo Buzones
            </h2>
            <p class="text-gray-600 mb-6">
              Proofpoint adopta un enfoque centrado en las personas (People-Centric Security),
              identificando quiénes son sus usuarios más atacados (VAPs — Very Attacked People)
              y aplicando controles adaptativos según el nivel de riesgo de cada persona.
            </p>
            <p class="text-gray-600 mb-8">
              A diferencia de soluciones genéricas, Proofpoint analiza el contexto completo de cada
              mensaje: remitente, contenido, adjuntos, URLs, y comportamiento del usuario para tomar
              decisiones precisas en milisegundos, respaldado por la plataforma de IA Proofpoint Nexus.
            </p>

            <div class="grid grid-cols-2 gap-6">
              <div class="border-l-4 border-red-600 pl-4">
                <div class="text-2xl font-bold text-gray-900 mb-1">2.3T</div>
                <div class="text-sm text-gray-600">Emails procesados al año por Nexus</div>
              </div>
              <div class="border-l-4 border-red-600 pl-4">
                <div class="text-2xl font-bold text-gray-900 mb-1">14</div>
                <div class="text-sm text-gray-600">Reconocimientos de analistas en 2025</div>
              </div>
            </div>
          </div>

          <div>
            <div class="bg-gradient-to-br from-red-50 to-white border border-red-100 rounded-2xl p-8">
              <h3 class="text-xl font-semibold mb-6">Capacidades clave de la plataforma:</h3>
              <div class="space-y-4">
                <div class="flex items-start gap-3">
                  <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Targeted Attack Protection (TAP)</h3>
                    <p class="text-sm text-gray-600">Detección de amenazas avanzadas, URLs y adjuntos maliciosos</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Email Fraud Defense</h3>
                    <p class="text-sm text-gray-600">Protección contra suplantación de identidad y fraude BEC con DMARC gestionado</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">CASB (Cloud App Security Broker)</h3>
                    <p class="text-sm text-gray-600">Protección para Microsoft 365, Google Workspace y aplicaciones SaaS</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Proofpoint ZenGuide (Security Awareness)</h3>
                    <p class="text-sm text-gray-600">Simulaciones de phishing y programas de educación continua basados en riesgo</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Collaboration Security Prime</h3>
                    <p class="text-sm text-gray-600">Protección unificada multicanal: email, Teams, Slack, SharePoint, redes sociales y apps cloud</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works (Deployment Phases) -->
    <section class="py-16 sm:py-20 lg:py-24 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4">
            Implementación en 4 Fases
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Nuestro proceso de despliegue garantiza una transición sin interrupciones
            para su operación de correo corporativo.
          </p>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-gray-200">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="text-center">
              <div class="bg-red-100 text-red-800 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg">
                1
              </div>
              <h3 class="font-semibold mb-2">Descubrimiento</h3>
              <p class="text-sm text-gray-600">
                Análisis de su entorno de correo actual, identificación de usuarios VAP y
                evaluación del nivel de riesgo.
              </p>
            </div>
            <div class="text-center">
              <div class="bg-red-100 text-red-800 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg">
                2
              </div>
              <h3 class="font-semibold mb-2">Configuración</h3>
              <p class="text-sm text-gray-600">
                Redirección de flujo de correo (MX records), configuración de políticas DMARC/DKIM/SPF
                y reglas de filtrado personalizadas.
              </p>
            </div>
            <div class="text-center">
              <div class="bg-red-100 text-red-800 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg">
                3
              </div>
              <h3 class="font-semibold mb-2">Optimización</h3>
              <p class="text-sm text-gray-600">
                Ajuste fino de políticas, reducción de falsos positivos y activación de
                módulos avanzados como TAP y DLP.
              </p>
            </div>
            <div class="text-center">
              <div class="bg-red-100 text-red-800 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg">
                4
              </div>
              <h3 class="font-semibold mb-2">Monitoreo Continuo</h3>
              <p class="text-sm text-gray-600">
                Reportes ejecutivos, alertas en tiempo real, campañas de awareness con ZenGuide
                y soporte técnico permanente.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Casos por Sector -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-gray-900">
            Casos de Uso por Sector en Colombia
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Cada sector tiene retos regulatorios y de amenaza distintos. Starsolution integra Proofpoint adaptado al contexto colombiano.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {PP_SECTORS.map((s) => (
            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 flex flex-col gap-4">
              <h3 class="text-lg font-bold text-gray-900">{s.sector}</h3>
              <div>
                <p class="text-xs font-semibold text-red-700 uppercase tracking-wide mb-1">Reto:</p>
                <p class="text-sm text-gray-600">{s.need}</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-green-700 uppercase tracking-wide mb-1">Cómo lo resolvemos:</p>
                <p class="text-sm text-gray-600">{s.how}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Anatomía de un Ataque de Phishing -->
    <section class="py-16 sm:py-20 lg:py-24 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-gray-900">
            Anatomía de un Ataque de Phishing
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Así es como un atacante intenta comprometer su organización por correo electrónico,
            y en qué fase exacta interviene Proofpoint para detenerlo.
          </p>
        </div>

        <div class="relative">
          <!-- Connecting line -->
          <div class="hidden md:block absolute top-8 left-0 right-0 h-0.5 bg-gradient-to-r from-red-200 via-red-400 to-green-400 z-0" style="top: 2rem; left: 8%; right: 8%;"></div>

          <div class="grid grid-cols-1 md:grid-cols-5 gap-6 relative z-10">
            <div class="text-center">
              <div class="w-16 h-16 bg-red-100 border-2 border-red-300 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import { seoData } from '@data/seo';

const seo = seoData['stellar-cyber'];

const SC_SECTORS = [
  {
    sector: 'Banca y Fintech',
    need: 'Cumplir Circular 007 Superfinanciera y detectar fraude en tiempo real sin un equipo SOC de 10+ analistas.',
    how: 'Correlacion Multi-Layer AI de transacciones, accesos y red en un panel unificado; orquestacion automatizada de respuesta ante alertas criticas. ITDR protege cuentas privilegiadas y accesos fuera de horario.',
  },
  {
    sector: 'Salud / Ley 1581',
    need: 'Proteger historias clinicas digitales y cumplir la Ley 1581 de Habeas Data sin interrumpir la operacion hospitalaria.',
    how: 'NDR detecta exfiltracion de datos de pacientes; UEBA identifica accesos anomalos a sistemas HIS/EMR; AI-Powered Case Orchestration contiene ransomware antes de que cifre archivos criticos.',
  },
  {
    sector: 'Gobierno / MSPI MinTIC',
    need: 'Implementar el Modelo de Seguridad y Privacidad de la Informacion (MSPI) con visibilidad total de activos y cumplimiento documentado.',
    how: 'AI-Native Next-Gen SIEM centraliza logs de todas las entidades; reportes de compliance listos para auditoria de la SIC; Multi-tenant para entidades con sedes multiples.',
  },
  {
    sector: 'MSSPs y SOC-as-a-Service',
    need: 'Operar multiples clientes desde una sola plataforma, con aislamiento de datos y escalado sin incremento proporcional de analistas.',
    how: 'Arquitectura Multi-Tier, Multi-Tenant, Multi-Site nativa de Stellar Cyber; AI Investigator reduce las decisiones de cada analista a 10-100 por dia; Starsolution implementa y da soporte en espanol.',
  },
];
---

<BaseLayout seo={seo}>
  <Navbar />

  <div class="bg-white min-h-screen font-['Instrument_Sans',sans-serif]">

    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-gray-50 to-white py-12 sm:py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="mb-6">
              <span class="inline-block bg-red-100 text-red-700 text-xs font-medium px-3 py-1 rounded">
                SECOPS PLATFORM · SOC AUTONOMO
              </span>
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
              Stellar Cyber: Plataforma SecOps{" "}
              <span class="text-red-700">con Open XDR para Colombia.</span>
            </h1>
            <p class="text-lg sm:text-xl text-gray-600 mb-8 max-w-3xl">
              Unifique la deteccion y respuesta a amenazas en una sola plataforma. Correlacion
              de alertas con Multi-Layer AI™, orquestacion automatizada y visibilidad total de
              toda su infraestructura desde un unico panel, sin reemplazar sus herramientas existentes.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/contacto" class="bg-gradient-to-r from-red-600 to-red-700 text-white font-semibold px-8 py-4 rounded-full hover:from-red-700 hover:to-red-800 transition shadow-lg inline-flex items-center justify-center gap-2">
                Solicitar Demo
              </a>
              <a href="/contacto" class="bg-white border-2 border-gray-200 text-gray-800 font-semibold px-8 py-4 rounded-full hover:bg-gray-50 transition inline-flex items-center justify-center gap-2 focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">
                Conocer la Plataforma
              </a>
            </div>
            <div class="mt-8 flex items-center gap-2 text-sm text-gray-500">
              <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 14 14">
                <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
              </svg>
              <span>Disenada para equipos de seguridad lean — "See. Know. Act."</span>
            </div>
          </div>
          <div class="hidden lg:flex items-center justify-center">
            <img
              src="/assets/robot-ia-laboratorio-monitores.webp"
              alt="Robot de inteligencia artificial en laboratorio con monitores para plataforma SecOps Stellar Cyber Open XDR"
              class="w-full max-w-md mx-auto rounded-2xl shadow-xl"
              width="400"
              height="400"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ¿Que es? · Bloque definicional para AI/GEO -->
    <section class="bg-white pt-14 sm:pt-16" aria-labelledby="que-es-stellar">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="que-es-stellar" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">¿Que es Stellar Cyber?</h2>
        <p class="text-lg text-gray-700 leading-relaxed">Stellar Cyber es una plataforma SecOps AI-Native con arquitectura Open XDR que reune en un solo producto las capacidades de AI-Native Next-Gen SIEM, Network Detection & Response (NDR), Identity Threat Detection & Response (ITDR), User Entity Behavior Analytics (UEBA), Threat Intelligence Platform (TIP), AI-Powered Case Orchestration y el motor Multi-Layer AI™. Las organizaciones — desde empresas medianas hasta MSSPs y SOC corporativos — la usan para unificar la visibilidad de sus entornos, reducir el tiempo de deteccion y respuesta, y operar un SOC autonomo con equipos lean. Starsolution la implementa e integra en Colombia con soporte tecnico en espanol y despliegue desde Bogota.</p>
      </div>
    </section>

    <!-- Why Open XDR -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
          <div>
            <span class="text-red-700 text-xs font-medium uppercase tracking-wide">Open XDR</span>
            <h2 class="text-3xl sm:text-4xl font-bold mt-4 mb-6">
              ¿Por que Open XDR es el Futuro de las Operaciones de Seguridad?
            </h2>
            <p class="text-gray-600 mb-6">
              Los equipos de seguridad manejan docenas de herramientas desconectadas que generan
              miles de alertas diarias. El SIEM tradicional es costoso, complejo y no correlaciona
              de manera efectiva. El resultado: amenazas reales se pierden entre el ruido.
            </p>
            <p class="text-gray-600 mb-8">
              Stellar Cyber unifica AI-Native Next-Gen SIEM, NDR, UEBA, ITDR y AI-Powered Case Orchestration
              en una plataforma Open XDR que se integra con sus herramientas existentes. El motor
              Multi-Layer AI™ correlaciona eventos de multiples fuentes para detectar ataques reales
              y responder de forma automatizada.
            </p>

            <div class="grid grid-cols-2 gap-6">
              <div class="border-l-4 border-red-600 pl-4">
                <div class="text-lg font-bold text-gray-900 mb-1">Hasta 400%</div>
                <div class="text-sm text-gray-600">Reduccion de tiempos de respuesta (AI Investigator, fuente: Stellar Cyber)</div>
              </div>
              <div class="border-l-4 border-red-600 pl-4">
                <div class="text-lg font-bold text-gray-900 mb-1">10-100/dia</div>
                <div class="text-sm text-gray-600">Decisiones por analista con Multi-Layer AI™ (fuente: Stellar Cyber)</div>
              </div>
            </div>
          </div>

          <div class="flex items-center">
            <div class="bg-[#111827] rounded-2xl p-8 w-full">
              <h3 class="text-xl font-semibold text-white mb-6">SIEM tradicional vs SecOps Platform:</h3>
              <div class="space-y-4">
                <div class="flex items-center gap-3">
                  <div class="bg-red-600 rounded-full p-1.5">
                    <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <span class="text-gray-300">Sin reglas manuales: correlacion automatica con Multi-Layer AI™</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="bg-red-600 rounded-full p-1.5">
                    <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <span class="text-gray-300">Despliegue en dias, no meses</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="bg-red-600 rounded-full p-1.5">
                    <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <span class="text-gray-300">Costo predecible, sin cobro por volumen de datos</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="bg-red-600 rounded-full p-1.5">
                    <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <span class="text-gray-300">AI-Powered Case Orchestration integrada en la plataforma</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="bg-red-600 rounded-full p-1.5">
                    <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <span class="text-gray-300">Multi-Tier, Multi-Tenant, Multi-Site para MSSPs</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Platform Capabilities -->
    <section class="bg-gray-50 py-16 sm:py-20 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold mb-4">
            Capacidades de la{" "}<span class="text-red-700">Plataforma</span>
          </h2>
          <p class="text-gray-600 max-w-3xl">
            Todo lo que necesita para operar un SOC moderno en una sola plataforma unificada.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <circle cx="10" cy="10" r="7" stroke="#374151" stroke-width="1.66667" fill="none" />
                <path d="M10 7v3l2 2" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Deteccion con IA (Multi-Layer AI™)</h3>
            <p class="text-sm text-gray-600">
              Motor registrado Multi-Layer AI™ con cuatro capas: Detection AI (ML supervisado y no supervisado),
              Correlation AI (GraphML entre fuentes), LLM-Driven AI para investigacion conversacional
              (AI Investigator) y Agentic AI con playbooks adaptativos.
            </p>
          </div>

          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M10 2L3 6v5c0 4.5 3 8.5 7 9.5 4-1 7-5 7-9.5V6l-7-4z" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Network Detection & Response (NDR)</h3>
            <p class="text-sm text-gray-600">
              Analisis profundo del trafico de red con DPI (Deep Packet Inspection) para detectar
              movimiento lateral, exfiltracion de datos y comunicaciones C2 en tiempo real.
            </p>
          </div>

          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM3 12a3 3 0 116 0 3 3 0 01-6 0z" stroke="#374151" stroke-width="1.66667" fill="none" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">User Entity Behavior Analytics (UEBA)</h3>
            <p class="text-sm text-gray-600">
              Deteccion de comportamientos anomalos de usuarios y entidades: accesos inusuales,
              movimientos de datos atipicos e indicadores de compromiso de cuentas.
            </p>
          </div>

          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M10 3a4 4 0 100 8 4 4 0 000-8zm-7 9a7 7 0 1114 0H3z" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" fill="none" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Identity Threat Detection & Response (ITDR)</h3>
            <p class="text-sm text-gray-600">
              Proteccion de identidades y cuentas privilegiadas: detecta accesos anomalos, escalaciones
              de privilegios, compromiso de credenciales y ataques de pass-the-hash en tiempo real.
            </p>
          </div>

          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M3 10l4 4 10-10" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">AI-Powered Case Orchestration</h3>
            <p class="text-sm text-gray-600">
              Orquestacion de casos con Agentic Auto Triage: playbooks adaptativos que ejecutan
              acciones de contencion, aislamiento y remediacion de forma autonoma para amenazas
              conocidas y nuevas.
            </p>
          </div>

          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <rect x="3" y="3" width="14" height="14" rx="2" stroke="#374151" stroke-width="1.66667" fill="none" />
                <path d="M7 8h6M7 12h4" stroke="#374151" stroke-linecap="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">AI-Native Next-Gen SIEM</h3>
            <p class="text-sm text-gray-600">
              Recopilacion y normalizacion de logs de cualquier fuente con busqueda de alta velocidad.
              Sin las limitaciones de costo por volumen de los SIEM tradicionales. Disenado para
              equipos lean segun Stellar Cyber.
            </p>
          </div>

          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                <path d="M10 2a8 8 0 100 16 8 8 0 000-16zM10 6v4m0 4h.01" stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Multi-Tenant para MSSPs</h3>
            <p class="text-sm text-gray-600">
              Arquitectura Multi-Tier, Multi-Tenant, Multi-Site nativa que permite a proveedores
              de servicios gestionados operar multiples clientes desde una sola instancia de forma
              aislada y segura.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- AI Engine Details (Multi-Layer AI) -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
          <div>
            <span class="text-red-700 text-xs font-medium uppercase tracking-wide">Multi-Layer AI™</span>
            <h2 class="text-3xl sm:text-4xl font-bold mt-4 mb-6">
              Motor Multi-Layer AI™: De Miles de Alertas a Incidentes Reales
            </h2>
            <p class="text-gray-600 mb-6">
              El motor registrado Multi-Layer AI™ de Stellar Cyber utiliza cuatro capas de inteligencia
              artificial — Detection AI, Correlation AI con GraphML, LLM-Driven AI (AI Investigator)
              y Agentic AI — para correlacionar eventos aparentemente inconexos de multiples fuentes.
              El resultado: los analistas pasan de manejar miles de alertas a tomar entre 10 y 100
              decisiones por dia (fuente: Stellar Cyber).
            </p>
            <p class="text-gray-600 mb-8">
              El motor aprende el comportamiento normal de su red, usuarios y aplicaciones para
              detectar desviaciones que indican amenazas reales, incluyendo ataques de dia cero
              y amenazas internas que las reglas estaticas no pueden identificar.
            </p>
            <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 text-sm text-blue-800">
              <span class="font-semibold">AI Investigator:</span> Interfaz GenAI conversacional integrada en la plataforma que permite investigar amenazas en lenguaje natural. Stellar Cyber reporta hasta un 400% de reduccion en tiempos de respuesta a amenazas.
            </div>
          </div>

          <div>
            <div class="bg-gradient-to-br from-red-50 to-white border border-red-100 rounded-2xl p-8">
              <h3 class="text-xl font-semibold mb-6">Capas del Motor Multi-Layer AI™:</h3>
              <div class="space-y-6">
                <div class="flex items-start gap-3">
                  <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Detection AI</h3>
                    <p class="text-sm text-gray-600">ML supervisado y no supervisado para deteccion de amenazas conocidas y desconocidas</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Correlation AI</h3>
                    <p class="text-sm text-gray-600">Tecnologia GraphML que conecta alertas entre fuentes heterogeneas para construir incidentes unificados</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">LLM-Driven AI (AI Investigator)</h3>
                    <p class="text-sm text-gray-600">GenAI conversacional para investigacion de amenazas en lenguaje natural</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                      <path d="M11.6667 3.5L5.25 9.91667L2.33333 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900">Agentic AI</h3>
                    <p class="text-sm text-gray-600">Playbooks adaptativos con agentes autonomos: Triage, Discovery, Correlation, Scoring y Response Agents</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Casos por sector -->
    <section class="py-16 sm:py-20 lg:py-24 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4">
            Stellar Cyber por Sector
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Casos de uso anclados al contexto regulatorio colombiano.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {SC_SECTORS.map((s) => (
            <div class="bg-white border border-gray-200 rounded-2xl p-6">
              <div class="text-red-700 text-xs font-bold uppercase tracking-wide mb-3">{s.sector}</div>
              <p class="text-sm text-gray-700 mb-4"><span class="font-semibold">Reto:</span> {s.need}</p>
              <p class="text-sm text-gray-600"><span class="font-semibold">Como lo integramos:</span> {s.how}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Casos de Uso clasicos -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4">
            Perfiles de Organizacion
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Stellar Cyber se adapta a diferentes necesidades organizacionales.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white border border-gray-200 rounded-2xl p-8">
            <div class="bg-blue-50 rounded-lg p-3 w-12 h-12 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">

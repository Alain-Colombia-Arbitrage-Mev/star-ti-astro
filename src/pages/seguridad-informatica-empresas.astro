---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import { seoData } from '@data/seo';

const seo = seoData['seguridad-informatica-empresas'];

const heroStats = [
  { value: '24/7', label: 'monitoreo y respuesta' },
  { value: '3-2-1-1', label: 'backup resiliente' },
  { value: 'EDR/XDR', label: 'deteccion en endpoint' },
  { value: '2013', label: 'experiencia regional' },
];

const defenseLayers = [
  {
    eyebrow: 'Capa 01',
    title: 'Endpoints con EDR/XDR administrado',
    text: 'Bloqueamos actividad de cifrado masivo, ejecucion sospechosa de PowerShell, abuso de credenciales y movimiento lateral antes de que el ransomware llegue a servidores criticos.',
    items: ['Bitdefender GravityZone y Kaspersky Next', 'Politicas por rol, sede y criticidad', 'Aislamiento remoto de equipos comprometidos'],
    link: '/antivirus-empresas/',
    linkText: 'Comparar antivirus empresarial',
  },
  {
    eyebrow: 'Capa 02',
    title: 'Correo protegido contra phishing y BEC',
    text: 'Reducimos el principal vector de entrada con analisis de adjuntos, proteccion frente a suplantacion, sandboxing y entrenamiento medible para usuarios de alto riesgo.',
    items: ['Proofpoint y Hornetsecurity', 'DMARC, SPF y DKIM revisados', 'Simulaciones de phishing por area'],
    link: '/proofpoint/',
    linkText: 'Ver seguridad de correo',
  },
  {
    eyebrow: 'Capa 03',
    title: 'Backups verificables e inmutables',
    text: 'Disenamos una estrategia 3-2-1-1 con pruebas de restauracion, copias fuera de linea y objetivos RTO/RPO realistas para volver a operar sin negociar con atacantes.',
    items: ['Copias fuera de la red principal', 'Restauracion probada por sistema', 'Orden de recuperacion por criticidad'],
    link: '/blog/ransomware-empresas-colombia/',
    linkText: 'Leer guia de ransomware',
  },
  {
    eyebrow: 'Capa 04',
    title: 'Vulnerabilidades y superficie expuesta',
    text: 'Priorizamos parches segun explotacion real, exposicion publica y riesgo para el negocio. El objetivo es cerrar VPN, RDP, credenciales filtradas y servicios inseguros.',
    items: ['Gestion de vulnerabilidades con Vicarius', 'Monitoreo externo con Enthec', 'Pentesting y Red Team controlado'],
    link: '/hacking-etico/',
    linkText: 'Solicitar prueba de seguridad',
  },
];

const serviceCards = [
  { title: 'Diagnostico de riesgo ransomware', text: 'Mapa de activos, exposiciones, controles faltantes y brechas que permiten cifrado o exfiltracion.', href: '/contacto/' },
  { title: 'Proteccion endpoint y servidor', text: 'EDR/XDR administrado para estaciones, servidores, workloads cloud y usuarios remotos.', href: '/bitdefender/' },
  { title: 'Respuesta a incidentes', text: 'Contencion, analisis forense, erradicacion y recuperacion con evidencia para comites y aseguradoras.', href: '/blog/respuesta-incidentes-ciberseguridad/' },
  { title: 'Cumplimiento y gobierno', text: 'Controles alineados con ISO 27001, Ley 1581, contratos corporativos y auditorias sectoriales.', href: '/iso-27001/' },
];

const playbook = [
  ['0-15 min', 'Aislar equipos afectados de la red sin apagarlos.', 'TI / Mesa de ayuda'],
  ['15-60 min', 'Activar equipo de crisis, preservar evidencia y bloquear cuentas sospechosas.', 'CISO / Direccion TI'],
  ['1-4 horas', 'Identificar alcance: endpoints, servidores, backups, credenciales y datos expuestos.', 'Forense / SOC'],
  ['4-12 horas', 'Cerrar vector de entrada y validar punto de restauracion limpio.', 'Infraestructura'],
  ['12-48 horas', 'Recuperar sistemas por criticidad y comunicar segun obligaciones legales.', 'Direccion / Legal'],
];

const faqItems = [
  {
    q: 'Que incluye una estrategia de seguridad informatica empresarial contra ransomware?',
    a: 'Incluye proteccion EDR/XDR en endpoints y servidores, seguridad de correo, MFA, gestion de vulnerabilidades, backup 3-2-1-1, monitoreo continuo, plan de respuesta a incidentes y pruebas periodicas de restauracion.',
  },
  {
    q: 'Por donde debe empezar una empresa si hoy no tiene defensa anti-ransomware?',
    a: 'El primer paso es un diagnostico de activos, backups, accesos remotos, correo y privilegios. Luego se priorizan controles de alto impacto: MFA, EDR administrado, cierre de RDP/VPN expuestos, backups probados y proteccion de email.',
  },
  {
    q: 'Un antivirus tradicional es suficiente para detener ransomware?',
    a: 'No. El ransomware moderno usa credenciales validas, herramientas administrativas y tecnicas de evasion. Una empresa necesita EDR/XDR con monitoreo de comportamiento, capacidad de aislamiento y respuesta operada por especialistas.',
  },
  {
    q: 'Cada cuanto se deben probar los backups?',
    a: 'Para sistemas criticos, la prueba debe hacerse como minimo cada trimestre y despues de cambios relevantes de infraestructura. La prueba debe medir tiempo real de restauracion, integridad de datos y orden de recuperacion.',
  },
  {
    q: 'Starsolution puede ayudar si la empresa ya fue atacada?',
    a: 'Si. El trabajo inicial es contener la propagacion, preservar evidencia, evaluar alcance, cerrar el vector de entrada y definir si la recuperacion desde backups es viable antes de restaurar sistemas.',
  },
];
---

<BaseLayout seo={seo}>
  <Navbar />

  <div class="bg-white min-h-screen w-full font-['Instrument_Sans',sans-serif] text-[#0f172a]">

    <section class="relative min-h-[88vh] overflow-hidden bg-[#07111f]" aria-labelledby="hero-title">
      <img
        src="/assets/seguridad-empresarial-soc.webp"
        alt="Centro de operaciones monitoreando sistemas empresariales contra ransomware"
        class="absolute inset-0 h-full w-full object-cover opacity-60"
        width="1800"
        height="1200"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,17,31,0.96)_0%,rgba(7,17,31,0.82)_42%,rgba(7,17,31,0.38)_100%)]"></div>
      <div class="relative mx-auto flex min-h-[88vh] max-w-7xl flex-col justify-end px-4 pb-28 pt-32 sm:px-6 sm:pb-12 lg:px-8 lg:pb-14">
        <div class="max-w-4xl -translate-y-28 sm:translate-y-0">
          <div class="mb-6 inline-flex items-center gap-2 border border-red-300/30 bg-red-500/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-red-100">
            Defensa anti-ransomware para empresas
          </div>
          <h1 id="hero-title" class="font-['Space_Grotesk',sans-serif] text-4xl font-bold leading-[1.05] text-white sm:text-5xl lg:text-7xl">
            Seguridad informatica empresarial contra ransomware
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-200 sm:text-xl">
            Protegemos endpoints, servidores, correo, identidades y backups con un programa de defensa por capas. Starsolution ayuda a empresas en Colombia a prevenir, detectar, contener y recuperarse de ataques de ransomware sin improvisar durante la crisis.
          </p>
          <div class="mt-8 flex flex-col gap-3 pb-32 sm:flex-row sm:pb-0">
            <a href="/contacto/" class="inline-flex items-center justify-center bg-red-600 px-6 py-4 text-sm font-bold text-white transition hover:bg-red-700">
              Solicitar diagnostico
            </a>
            <a href="#programa-ransomware" class="inline-flex items-center justify-center border border-white/30 bg-white/10 px-6 py-4 text-sm font-bold text-white transition hover:bg-white/20">
              Ver plan de defensa
            </a>
          </div>
        </div>

        <div class="mt-12 hidden grid-cols-2 gap-3 border-t border-white/15 pt-6 sm:grid sm:grid-cols-4">
          {heroStats.map((stat) => (
            <div>
              <div class="font-['Space_Grotesk',sans-serif] text-2xl font-bold text-white">{stat.value}</div>
              <div class="mt-1 text-xs uppercase tracking-wide text-slate-300">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-14 sm:py-20" aria-labelledby="respuesta-directa">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.18em] text-red-700">Respuesta directa</span>
          <h2 id="respuesta-directa" class="mt-3 font-['Space_Grotesk',sans-serif] text-3xl font-bold leading-tight text-slate-950 sm:text-4xl">
            Que debe tener una empresa para defenderse de ransomware
          </h2>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-slate-700">
          <p>
            Una defensa empresarial contra ransomware no depende de una sola herramienta. Requiere controles coordinados: MFA, EDR/XDR, seguridad de correo, gestion de vulnerabilidades, backups inmutables, monitoreo 24/7 y un plan de respuesta probado.
          </p>
          <p>
            El objetivo no es solo evitar infecciones. El objetivo es detectar comportamiento anomalo temprano, impedir movimiento lateral, proteger los datos criticos, restaurar operaciones en orden y documentar evidencia para direccion, clientes, aseguradoras y reguladores.
          </p>
        </div>
      </div>
    </section>

    <section id="programa-ransomware" class="bg-slate-50 py-16 sm:py-24" aria-labelledby="programa-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 max-w-3xl">
          <span class="text-xs font-bold uppercase tracking-[0.18em] text-red-700">Programa por capas</span>
          <h2 id="programa-title" class="mt-3 font-['Space_Grotesk',sans-serif] text-3xl font-bold leading-tight text-slate-950 sm:text-5xl">
            Defensa de ransomware disenada para operar, no para decorar reportes
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-600">
            Cada capa cierra una ventana real de ataque: entrada por phishing, credenciales filtradas, servicios expuestos, cifrado en endpoints, exfiltracion de datos y destruccion de backups.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
          {defenseLayers.map((layer) => (
            <a href={layer.link} class="group block border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:border-red-200 hover:shadow-xl">
              <div class="text-xs font-bold uppercase tracking-[0.18em] text-red-700">{layer.eyebrow}</div>
              <h3 class="mt-3 font-['Space_Grotesk',sans-serif] text-2xl font-bold leading-tight text-slate-950 group-hover:text-red-700">
                {layer.title}
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-slate-600">{layer.text}</p>
              <ul class="mt-5 space-y-2">
                {layer.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-slate-700">
                    <span class="mt-1 h-2 w-2 shrink-0 bg-red-600"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-6 text-sm font-bold text-red-700">{layer.linkText} &rarr;</div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-24" aria-labelledby="arquitectura-title">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8 lg:items-center">
        <div>
          <img
            src="/assets/seguridad-empresarial-data-center.webp"
            alt="Especialista revisando infraestructura critica en sala de servidores"
            class="h-[520px] w-full object-cover shadow-2xl"
            width="1600"
            height="1067"
            loading="lazy"
          />
        </div>
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.18em] text-red-700">Infraestructura critica</span>
          <h2 id="arquitectura-title" class="mt-3 font-['Space_Grotesk',sans-serif] text-3xl font-bold leading-tight text-slate-950 sm:text-5xl">
            Proteccion para endpoints, servidores, nube y usuarios remotos
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-600">
            El ransomware rara vez se queda en el primer equipo comprometido. Por eso la arquitectura debe cubrir estaciones, servidores, Active Directory, correo, VPN, aplicaciones expuestas, almacenamiento y copias de seguridad.
          </p>
          <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {[
              ['Identidades', 'MFA, privilegios minimos, cuentas admin separadas y revision de accesos.'],
              ['Endpoints', 'EDR/XDR, control de dispositivos, bloqueo de scripts y respuesta remota.'],
              ['Backups', 'Copias inmutables, restauracion probada y repositorios fuera de linea.'],
              ['Exposicion', 'Vulnerabilidades, puertos abiertos, credenciales filtradas y shadow IT.'],
            ].map(([title, text]) => (
              <div class="border border-slate-200 p-5">
                <h3 class="font-['Space_Grotesk',sans-serif] text-lg font-bold text-slate-950">{title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-slate-950 py-16 text-white sm:py-24" aria-labelledby="deteccion-title">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:items-center">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.18em] text-red-300">Deteccion temprana</span>
          <h2 id="deteccion-title" class="mt-3 font-['Space_Grotesk',sans-serif] text-3xl font-bold leading-tight sm:text-5xl">
            Senales que deben activar respuesta antes del cifrado
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-300">
            Un ataque de ransomware suele mostrar senales horas o dias antes del cifrado: autenticaciones inusuales, enumeracion de dominios, uso anomalo de herramientas administrativas y pruebas de exfiltracion.
          </p>
          <div class="mt-8 space-y-3">
            {[
              'Inicio de sesion exitoso desde paises, horarios o dispositivos no habituales.',
              'Uso de PowerShell, WMI, PsExec o herramientas remotas fuera de ventanas aprobadas.',
              'Acceso masivo a carpetas compartidas o cambios acelerados de extension de archivos.',
              'Intentos de deshabilitar EDR, logs, copias shadow o servicios de backup.',
              'Transferencias grandes hacia servicios cloud no autorizados o dominios recien creados.',
            ].map((item) => (
              <div class="flex items-start gap-3 border border-white/12 bg-white/5 p-4">
                <span class="mt-1 h-2 w-2 shrink-0 bg-red-400"></span>
                <p class="text-sm leading-relaxed text-slate-200">{item}</p>
              </div>
            ))}
          </div>
        </div>
        <div>
          <img
            src="/assets/seguridad-empresarial-analista.webp"
            alt="Analista de ciberseguridad revisando actividad sospechosa en monitores"
            class="h-[560px] w-full object-cover shadow-2xl"
            width="1400"
            height="933"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-24" aria-labelledby="playbook-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
          <div>
            <span class="text-xs font-bold uppercase tracking-[0.18em] text-red-700">Respuesta a incidentes</span>
            <h2 id="playbook-title" class="mt-3 font-['Space_Grotesk',sans-serif] text-3xl font-bold leading-tight text-slate-950 sm:text-5xl">
              Que hacer durante las primeras 48 horas
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-slate-600">
              La diferencia entre una interrupcion controlada y una crisis completa suele estar en las primeras horas. Este playbook evita decisiones que destruyen evidencia o propagan el cifrado.
            </p>
          </div>
          <div class="overflow-x-auto border border-slate-200">
            <table class="w-full min-w-[720px] text-left text-sm">
              <thead class="bg-slate-100 text-slate-950">
                <tr>
                  <th class="px-5 py-4 font-bold">Tiempo</th>
                  <th class="px-5 py-4 font-bold">Accion prioritaria</th>
                  <th class="px-5 py-4 font-bold">Responsable</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                {playbook.map(([time, action, owner]) => (
                  <tr class="bg-white">
                    <td class="whitespace-nowrap px-5 py-4 font-bold text-red-700">{time}</td>
                    <td class="px-5 py-4 text-slate-700">{action}</td>
                    <td class="whitespace-nowrap px-5 py-4 text-slate-500">{owner}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-slate-50 py-16 sm:py-24" aria-labelledby="servicios-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1fr_0.85fr] lg:items-center">
          <div>
            <span class="text-xs font-bold uppercase tracking-[0.18em] text-red-700">Servicios incluidos</span>
            <h2 id="servicios-title" class="mt-3 font-['Space_Grotesk',sans-serif] text-3xl font-bold leading-tight text-slate-950 sm:text-5xl">
              Seguridad informatica empresarial lista para comite directivo
            </h2>
            <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
              {serviceCards.map((card) => (
                <a href={card.href} class="group border border-slate-200 bg-white p-5 transition hover:border-red-200 hover:shadow-lg">
                  <h3 class="font-['Space_Grotesk',sans-serif] text-xl font-bold leading-tight text-slate-950 group-hover:text-red-700">{card.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-slate-600">{card.text}</p>
                </a>
              ))}
            </div>
          </div>
          <div>
            <img
              src="/assets/seguridad-empresarial-servidores.webp"
              alt="Racks de servidores protegidos con controles de seguridad informatica empresarial"
              class="h-[620px] w-full object-cover shadow-2xl"
              width="1600"
              height="1067"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-24" aria-labelledby="soluciones-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 max-w-3xl">
          <span class="text-xs font-bold uppercase tracking-[0.18em] text-red-700">Stack recomendado</span>
          <h2 id="soluciones-title" class="mt-3 font-['Space_Grotesk',sans-serif] text-3xl font-bold leading-tight text-slate-950 sm:text-5xl">
            Soluciones que conectamos dentro del programa
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-600">
            El stack se selecciona segun tamano, sector, presupuesto, madurez y obligaciones de cumplimiento. Estas son las piezas que mas usamos en proyectos de defensa contra ransomware.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {[
            ['Bitdefender', 'EDR, XDR y proteccion endpoint', '/bitdefender/'],
            ['Kaspersky', 'Kaspersky Next y respuesta endpoint', '/kaspersky/'],
            ['Proofpoint', 'Proteccion contra phishing y BEC', '/proofpoint/'],
            ['Hornetsecurity', 'Seguridad y backup para Microsoft 365', '/hornetsecurity/'],
            ['Vicarius', 'Vulnerability management y remediacion', '/vicarius/'],
            ['Enthec', 'Superficie externa y credenciales filtradas', '/enthec/'],
            ['DLP', 'Prevencion de perdida de datos', '/dlp-prevencion-perdida-datos/'],
            ['ISO 27001', 'Gobierno, politicas y controles auditables', '/iso-27001/'],
          ].map(([title, text, href]) => (
            <a href={href} class="group border border-slate-200 p-5 transition hover:border-red-200 hover:shadow-lg">
              <div class="font-['Space_Grotesk',sans-serif] text-lg font-bold text-slate-950 group-hover:text-red-700">{title}</div>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-50 py-16 sm:py-24" aria-labelledby="faq-title">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
          <span class="text-xs font-bold uppercase tracking-[0.18em] text-red-700">FAQ</span>
          <h2 id="faq-title" class="mt-3 font-['Space_Grotesk',sans-serif] text-3xl font-bold leading-tight text-slate-950 sm:text-5xl">
            Preguntas frecuentes
          </h2>
        </div>
        <div class="space-y-3">
          {faqItems.map((item) => (
            <details class="group border border-slate-200 bg-white">
              <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-5 font-bold text-slate-950">
                <span>{item.q}</span>
                <span class="text-red-700 transition group-open:rotate-45">+</span>
              </summary>
              <div class="px-5 pb-5 text-sm leading-relaxed text-slate-600">{item.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="relative overflow-hidden bg-[#07111f] py-20 sm:py-24">
      <img
        src="/assets/seguridad-empresarial-soc.webp"
        alt="Equipo de monitoreo de seguridad coordinando respuesta empresarial"
        class="absolute inset-0 h-full w-full object-cover opacity-25"
        width="1800"
        height="1200"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-slate-950/80"></div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="font-['Space_Grotesk',sans-serif] text-3xl font-bold leading-tight text-white sm:text-5xl">
          Evalúe hoy que tan resistente es su empresa frente al ransomware
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">
          Revisamos endpoints, correo, backups, accesos remotos, vulnerabilidades y plan de respuesta. El resultado es una hoja de ruta priorizada por riesgo operativo.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/contacto/" class="inline-flex items-center justify-center bg-red-600 px-7 py-4 text-sm font-bold text-white transition hover:bg-red-700">
            Agendar diagnostico
          </a>
          <a href="tel:+573007010017" class="inline-flex items-center justify-center border border-white/30 bg-white/10 px-7 py-4 text-sm font-bold text-white transition hover:bg-white/20">
            Llamar a Starsolution
          </a>
        </div>
      </div>
    </section>

    <section class="bg-white py-10">

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import ConsultoriaForm from '@components/ConsultoriaForm.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import { seoData } from '@data/seo';
import { socIncludes, socSteps, socFaqs } from '@data/starSoc';

const seo = seoData['star-soc'];

const sectors = [
  ['Sector financiero', 'Monitoreo y reporte de incidentes que pide la Circular 007 de la Superfinanciera.'],
  ['Salud', 'Historias clínicas y sistemas que no pueden detenerse.'],
  ['Sector público', 'Protección de servicios al ciudadano y evidencia para auditorías.'],
  ['Industria y comercio', 'Operación continua, plantas y sedes con poco personal de TI.'],
];
---

<BaseLayout seo={seo}>
  <Navbar />

  <section class="relative bg-gradient-to-br from-[#0b1220] to-[#1f2937] overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-16 lg:pb-20">
      <nav class="mb-8 flex items-center gap-2 text-sm text-gray-400" aria-label="Ruta de navegación">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-gray-200">Star SOC</span>
      </nav>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-flex items-center gap-2 bg-violet-500/20 border border-violet-400/30 text-violet-200 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wide mb-6">
            <span class="w-2 h-2 rounded-full bg-violet-400"></span> Star SOC
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Monitoreo y respuesta a incidentes 24/7
          </h1>
          <p class="text-xl text-gray-300 mb-8 leading-relaxed">
            Un centro de operaciones de seguridad que vigila sus equipos, servidores, red, nube y correo todo el día, todos los días. Usted habla con Star Solutions TI, en español y desde Colombia.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="#contacto" class="inline-flex items-center justify-center bg-red-700 text-white font-semibold px-6 py-3 rounded hover:bg-[#dc2626] transition">Solicitar diagnóstico</a>
            <a href="#como-funciona" class="inline-flex items-center justify-center border border-white/40 text-white font-semibold px-6 py-3 rounded hover:bg-white/10 transition">Cómo funciona</a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img src="/og/star-soc.jpg" alt="Star SOC: monitoreo y respuesta 24/7" class="w-full h-auto rounded-2xl shadow-2xl ring-1 ring-white/10" width="1200" height="630" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">Los ataques no esperan al horario de oficina</h2>
      <p class="text-lg text-gray-600 leading-relaxed mb-4">
        Los ataques de ransomware suelen ejecutarse de noche, en fines de semana o en festivos, cuando nadie está mirando. Tener antivirus o EDR ayuda, pero alguien tiene que ver las alertas, entender qué significan y actuar a tiempo.
      </p>
      <p class="text-lg text-gray-600 leading-relaxed">
        Montar un SOC propio exige analistas en turnos 24/7, una plataforma SIEM, licencias y entrenamiento continuo. <strong>Star SOC</strong> le entrega ese servicio completo, con un solo contacto que conoce su empresa.
      </p>
    </div>
  </section>

  <section id="servicio" class="scroll-mt-24 bg-gray-50 py-16 lg:py-20 border-y border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-10 text-center">Qué incluye Star SOC</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {socIncludes.map(([title, text]) => (
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <span class="block w-10 h-1 bg-violet-600 rounded-full mb-4"></span>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{title}</h3>
            <p class="text-gray-600 leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="como-funciona" class="scroll-mt-24 bg-white py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-10 text-center">Cómo funciona</h2>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {socSteps.map(([title, text], index) => (
          <li class="flex gap-4 border border-gray-200 rounded-2xl p-6">
            <span class="flex-shrink-0 w-10 h-10 bg-violet-600 text-white rounded-full flex items-center justify-center font-bold">{index + 1}</span>
            <div>
              <h3 class="text-lg font-bold text-gray-900 mb-1">{title}</h3>
              <p class="text-gray-600 leading-relaxed">{text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="respuesta" class="scroll-mt-24 bg-[#111827] py-16 lg:py-20 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-violet-300 mb-3">Un solo contacto</p>
        <h2 class="text-3xl font-bold mb-4">Star es su primer nivel, siempre</h2>
        <p class="text-gray-300 leading-relaxed mb-4">
          Usted no tiene que hablar con un centro de llamadas en otro país ni entender reportes en inglés. Star Solutions TI recibe sus solicitudes, le avisa cuando hay un incidente, coordina la respuesta con los analistas del centro de operaciones y le acompaña hasta cerrarlo.
        </p>
        <p class="text-gray-300 leading-relaxed">
          Conocemos su infraestructura porque la diagnosticamos y la conectamos nosotros.
        </p>
      </div>
      <ul class="space-y-4">
        <li class="bg-white/5 border border-white/10 rounded-xl p-5"><span class="font-bold">Soporte en español</span><span class="block text-sm text-gray-400 mt-1">Ingenieros en Bogotá que conocen su caso.</span></li>
        <li class="bg-white/5 border border-white/10 rounded-xl p-5"><span class="font-bold">Escalamiento coordinado</span><span class="block text-sm text-gray-400 mt-1">Star y el equipo del SOC trabajan sobre el mismo incidente.</span></li>
        <li class="bg-white/5 border border-white/10 rounded-xl p-5"><span class="font-bold">Respaldo de una empresa certificada</span><span class="block text-sm text-gray-400 mt-1">ISO/IEC 27001:2022 por SGS y más de 1.150 empresas atendidas desde 2016.</span></li>
      </ul>
    </div>
  </section>

  <section id="cumplimiento" class="scroll-mt-24 bg-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 text-center">Para quién es Star SOC</h2>
      <p class="text-lg text-gray-600 text-center max-w-3xl mx-auto mb-10">Empresas medianas y grandes que no tienen un equipo de seguridad 24/7 o que necesitan demostrar monitoreo continuo ante un regulador, un auditor o sus clientes.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {sectors.map(([title, text]) => (
          <div class="border border-gray-200 rounded-2xl p-6">
            <h3 class="font-bold text-gray-900 mb-2">{title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
      <p class="text-gray-600 text-center mt-8">
        ¿Su empresa es vigilada por la Superfinanciera? Lea qué exige la <a href="/blog/circular-007-superfinanciera-ciberseguridad/" class="text-red-700 font-semibold hover:underline">Circular 007 en ciberseguridad</a>.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-16 lg:py-20 border-y border-gray-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-6 text-center">Se complementa con</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/bitdefender/" class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition"><p class="text-xs font-bold text-red-700 uppercase tracking-wide mb-1">Endpoints</p><p class="font-semibold text-sm text-gray-900">Bitdefender GravityZone</p></a>
        <a href="/hornetsecurity/" class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition"><p class="text-xs font-bold text-red-700 uppercase tracking-wide mb-1">Correo</p><p class="font-semibold text-sm text-gray-900">Hornetsecurity 365</p></a>
        <a href="/hacking-etico/" class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition"><p class="text-xs font-bold text-blue-700 uppercase tracking-wide mb-1">Pruebas</p><p class="font-semibold text-sm text-gray-900">Hacking ético</p></a>
        <a href="/iso-27001/" class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition"><p class="text-xs font-bold text-emerald-700 uppercase tracking-wide mb-1">Cumplimiento</p><p class="font-semibold text-sm text-gray-900">ISO 27001</p></a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Preguntas frecuentes</h2>
      <div class="space-y-5">
        {socFaqs.map((f) => (
          <div class="border border-gray-200 rounded-xl p-5">
            <h3 class="font-bold text-gray-900 mb-2">{f.q}</h3>
            <p class="text-gray-600">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div id="contacto" class="scroll-mt-24">
    <ConsultoriaForm sourceForm="Star SOC - Diagnóstico" />
  </div>

  <Footer />
  <WhatsAppButton />
</BaseLayout>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import ConsultoriaForm from '@components/ConsultoriaForm.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import { seoData } from '@data/seo';
import {
  socBenefits, socStats, socNeo, socModules, socSteps, socPlans, socPlanNotes,
  socPlanFeatures, socPlanIdeal, socCompliance, socMarkets, socStart, socFaqs,
} from '@data/starSoc';

const seo = seoData['star-soc'];

const planColors = ['bg-gray-500', 'bg-blue-600', 'bg-violet-600', 'bg-emerald-600'];
const sectors = ['Empresas privadas', 'Sector financiero', 'Sector público', 'Salud y educación', 'Industria y retail'];
---

<BaseLayout seo={seo}>
  <Navbar />

  <section class="relative bg-gradient-to-br from-[#0b1220] to-[#1f2937] overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-16 lg:pb-20">
      <nav class="mb-8 flex items-center gap-2 text-sm text-gray-400" aria-label="Ruta de navegación">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-gray-200">Star SOC</span>
      </nav>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-3"><span class="text-white">STAR</span> <span class="text-amber-400">SOC</span></p>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
            Ciberseguridad 360° para un negocio sin interrupciones
          </h1>
          <p class="text-xl text-gray-300 mb-6 leading-relaxed">
            Monitoreo continuo, respuesta activa y cumplimiento normativo en un solo servicio. <span class="text-white font-semibold">Inteligencia artificial, analistas humanos, resultados reales.</span>
          </p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-8 text-gray-200">
            <li class="flex gap-2"><span class="text-emerald-400">✓</span>Visibilidad total de su entorno</li>
            <li class="flex gap-2"><span class="text-emerald-400">✓</span>Detección y respuesta 24/7</li>
            <li class="flex gap-2"><span class="text-emerald-400">✓</span>Inteligencia artificial y analistas humanos</li>
            <li class="flex gap-2"><span class="text-emerald-400">✓</span>Evidencia automática para auditorías</li>
          </ul>
          <div class="flex flex-wrap gap-3">
            <a href="#contacto" class="inline-flex items-center justify-center bg-red-700 text-white font-semibold px-6 py-3 rounded hover:bg-[#dc2626] transition">Solicitar diagnóstico</a>
            <a href="#planes" class="inline-flex items-center justify-center border border-white/40 text-white font-semibold px-6 py-3 rounded hover:bg-white/10 transition">Ver planes</a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img src="/og/star-soc.jpg" alt="Star SOC: monitoreo y respuesta 24/7" class="w-full h-auto rounded-2xl shadow-2xl ring-1 ring-white/10" width="1200" height="630" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2 text-center">La ciberseguridad como motor de continuidad</h2>
      <p class="text-lg text-gray-600 text-center mb-10">Proteger hoy para asegurar el crecimiento de mañana.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {socBenefits.map(([title, text]) => (
          <div class="border border-gray-200 rounded-2xl p-6 text-center">
            <h3 class="text-lg font-bold text-gray-900 mb-2">{title}</h3>
            <p class="text-gray-600">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#111827] py-16 lg:py-20 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold mb-2">El desafío actual</h2>
      <p class="text-lg text-gray-300 mb-10">Un entorno de amenazas más rápido, sofisticado y orientado al negocio. Los ataques no esperan al horario de oficina.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {socStats.map(([value, text, source]) => (
          <div class="bg-white rounded-2xl p-6 text-gray-900">
            <p class="text-4xl font-extrabold text-red-600 mb-2">{value}</p>
            <p class="text-gray-700 leading-relaxed mb-3">{text}</p>
            <p class="text-xs text-gray-500">Fuente: {source}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-violet-600 mb-2">Inteligencia artificial + analistas humanos</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Neo: su analista virtual de IA</h2>
        <p class="text-lg text-gray-600 leading-relaxed">Triaje, investigación y resúmenes ejecutivos en lenguaje no técnico. Neo filtra el ruido para que los analistas se concentren en lo que de verdad importa.</p>
      </div>
      <ul class="space-y-3">
        {socNeo.map((item) => (
          <li class="flex items-center gap-3 border border-gray-200 rounded-xl p-4 font-semibold text-gray-800"><span class="w-2.5 h-2.5 rounded-full bg-violet-600 flex-shrink-0"></span>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="servicio" class="scroll-mt-24 bg-gray-50 py-16 lg:py-20 border-y border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2 text-center">Cobertura modular de seguridad</h2>
      <p class="text-lg text-gray-600 text-center mb-10">Protección integral, adaptada a las necesidades de su negocio.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {socModules.map(([title, items]) => (
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <span class="block w-10 h-1 bg-violet-600 rounded-full mb-4"></span>
            <h3 class="text-lg font-bold text-gray-900 mb-3">{title}</h3>
            <ul class="space-y-2 text-sm text-gray-600">
              {(items as string[]).map((i) => <li class="flex gap-2"><span class="text-violet-600">•</span>{i}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="text-center text-gray-600 mt-8">Incluye además evaluación de superficie de ataque para identificar de forma proactiva los riesgos expuestos en internet.</p>
    </div>
  </section>

  <section id="como-funciona" class="scroll-mt-24 bg-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2 text-center">Cómo funciona Star SOC</h2>
      <p class="text-lg text-gray-600 text-center mb-10">Un flujo continuo de protección y respuesta.</p>
      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
        {socSteps.map(([title, text], index) => (
          <li class="border border-gray-200 rounded-2xl p-5 text-center">
            <span class="mx-auto mb-3 w-10 h-10 bg-violet-600 text-white rounded-full flex items-center justify-center font-bold">{index + 1}</span>
            <h3 class="font-bold text-gray-900 mb-1">{title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="planes" class="scroll-mt-24 bg-gray-50 py-16 lg:py-20 border-y border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2 text-center">Planes de servicio</h2>
      <p class="text-lg text-gray-600 text-center mb-10">Cuatro niveles, un mismo objetivo: su tranquilidad.</p>
      <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white">
        <table class="w-full text-sm min-w-[680px]">
          <thead>
            <tr>
              <th class="text-left px-4 py-3 font-bold text-gray-900 bg-gray-50">Característica</th>
              {socPlans.map((plan, i) => (
                <th class={`px-4 py-3 text-white font-bold text-center ${planColors[i]}`}>
                  {plan}
                  {socPlanNotes[i] && <span class="block text-xs font-normal opacity-90">{socPlanNotes[i]}</span>}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {socPlanFeatures.map(([feature, from]) => (
              <tr>
                <td class="px-4 py-3 text-gray-800">{feature}</td>
                {socPlans.map((_, i) => (
                  <td class="px-4 py-3 text-center">{i >= from ? <span class="text-emerald-600 font-bold" aria-label="Incluido">✓</span> : <span class="text-gray-300" aria-label="No incluido">–</span>}</td>
                ))}
              </tr>
            ))}
            <tr class="bg-gray-50">
              <td class="px-4 py-3 font-bold text-gray-900">Ideal para</td>
              {socPlanIdeal.map((text) => <td class="px-4 py-3 text-center text-gray-600">{text}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-center text-gray-600 mt-6">El valor depende del plan y del número de dispositivos. <a href="#contacto" class="text-red-700 font-semibold hover:underline">Solicite su propuesta</a>.</p>
    </div>
  </section>

  <section id="respuesta" class="scroll-mt-24 bg-[#111827] py-16 lg:py-20 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-violet-300 mb-3">Un solo contacto</p>
        <h2 class="text-3xl font-bold mb-4">Star es su primer nivel, siempre</h2>
        <p class="text-gray-300 leading-relaxed">
          Star Solutions TI recibe sus solicitudes, le avisa cuando hay un incidente, coordina la respuesta con los analistas del centro de operaciones y le acompaña hasta cerrarlo. Usted no tiene que hablar con un centro de llamadas en otro país ni entender reportes en inglés.
        </p>
      </div>
      <ul class="space-y-4">
        <li class="bg-white/5 border border-white/10 rounded-xl p-5"><span class="font-bold">Soporte en español</span><span class="block text-sm text-gray-400 mt-1">Ingenieros en Bogotá que conocen su caso.</span></li>
        <li class="bg-white/5 border border-white/10 rounded-xl p-5"><span class="font-bold">Escalamiento coordinado</span><span class="block text-sm text-gray-400 mt-1">Star y el equipo del SOC trabajan sobre el mismo incidente.</span></li>
        <li class="bg-white/5 border border-white/10 rounded-xl p-5"><span class="font-bold">Respaldo de una empresa certificada</span><span class="block text-sm text-gray-400 mt-1">ISO/IEC 27001:2022 por SGS y más de 1.150 empresas atendidas desde 2016.</span></li>
      </ul>
    </div>
  </section>

  <section id="cumplimiento" class="scroll-mt-24 bg-white py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-10">
      <div>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">Cumplimiento y evidencia</h2>
        <p class="text-lg text-gray-600 mb-6">Listo para auditorías, sin esfuerzo adicional.</p>
        <ul class="space-y-3 text-gray-700">
          <li class="flex gap-3"><span class="text-emerald-600 font-bold">✓</span>Generación automática de evidencia inalterable</li>
          <li class="flex gap-3"><span class="text-emerald-600 font-bold">✓</span>Registros, reportes y trazabilidad</li>
          <li class="flex gap-3"><span class="text-emerald-600 font-bold">✓</span>Formato listo para auditorías</li>
          <li class="flex gap-3"><span class="text-emerald-600 font-bold">✓</span>Almacenamiento seguro y controlado</li>
        </ul>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h3 class="font-bold text-gray-900 mb-4">Apoya el cumplimiento de</h3>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {socCompliance.map((norm) => <li class="bg-white border border-gray-200 rounded-xl px-4 py-3 font-semibold text-gray-800">{norm}</li>)}
        </ul>
        <p class="text-sm text-gray-600 mt-4">¿Vigilado por la Superfinanciera? Lea qué exige la <a href="/blog/circular-007-superfinanciera-ciberseguridad/" class="text-red-700 font-semibold hover:underline">Circular 007 en ciberseguridad</a>.</p>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16 lg:py-20 border-y border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2 text-center">Mercados y sectores</h2>
      <p class="text-lg text-gray-600 text-center mb-10">Experiencia en entornos empresariales y gubernamentales.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {socMarkets.map(([country, role]) => (
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <h3 class="text-xl font-bold text-gray-900">{country}</h3>
            <p class="text-sm font-semibold text-violet-600 mb-3">{role}</p>
            <ul class="space-y-1 text-sm text-gray-600">
              {sectors.map((s) => <li>• {s}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2 text-center">Comience hoy</h2>
      <p class="text-lg text-gray-600 text-center mb-10">Dé el siguiente paso hacia una operación más segura.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {socStart.map(([title, text], i) => (
          <a href="#contacto" class={`rounded-2xl p-6 transition hover:shadow-lg ${i === 2 ? 'bg-red-700 text-white' : 'border border-gray-200 text-gray-900'}`}>
            <h3 class="text-lg font-bold mb-2">{title}</h3>
            <p class={i === 2 ? 'text-red-50' : 'text-gray-600'}>{text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16 lg:py-20 border-t border-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Preguntas frecuentes</h2>
      <div class="space-y-5">
        {socFaqs.map((f) => (
          <div class="bg-white border border-gray-200 rounded-xl p-5">
            <h3 class="font-bold text-gray-900 mb-2">{f.q}</h3>
            <p class="text-gray-600">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div id="contacto" class="scroll-mt-24">
    <ConsultoriaForm sourceForm="Star SOC - Diagnóstico" />
  </div>

  <Footer />
  <WhatsAppButton />
</BaseLayout>

---
// Página de aterrizaje para pauta de Hornetsecurity. Sin menú, una sola oferta.
// noindex y fuera del sitemap: no compite con /hornetsecurity/.
import BaseLayout from '@layouts/BaseLayout.astro';
import { seoData } from '@data/seo';

const seo = seoData['lp/hornetsecurity'];
const wa = 'https://wa.me/573227862375?text=' + encodeURIComponent('Hola, quiero proteger el correo de mi empresa con Hornetsecurity.');
const deviceRanges = ['1 a 49', '50 a 249', '250 a 999', '1.000 o más'];

const capas = [
  { id: 'filtro', t: 'Antispam y antimalware', h: 'El correo malicioso no llega a la bandeja', d: 'Hornetsecurity filtra cada mensaje antes de que llegue a Microsoft 365: spam, malware, phishing y correos masivos se quedan afuera, sin que el usuario tenga que decidir.', i: '<path d="M3 5h18l-7 8v6l-4-2v-4z"/>' },
  { id: 'atp', t: 'Protección avanzada', h: 'Adjuntos y enlaces revisados antes del clic', d: 'Los archivos sospechosos se abren en un entorno aislado (sandbox) y los enlaces se revisan al momento del clic, para detener ataques dirigidos y fraudes que un filtro común deja pasar.', i: '<path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z"/><path d="m9 12 2 2 4-4"/>' },
  { id: 'backup', t: 'Backup de Microsoft 365', h: 'Microsoft 365 no es un backup', d: 'Copia independiente y automática de correo, OneDrive, SharePoint y Teams. Si alguien borra, cifra o pierde información, se recupera en minutos.', i: '<path d="M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3z"/><path d="M4 7v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>' },
  { id: 'cifrado', t: 'Cifrado y continuidad', h: 'Información sensible, solo para quien debe leerla', d: 'Cifrado del correo, firmas corporativas uniformes, archivo legal y continuidad del servicio si Microsoft 365 presenta fallas.', i: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>' },
  { id: 'awareness', t: 'Concienciación', h: 'Un equipo que reconoce el engaño', d: 'Simulaciones de phishing y entrenamiento corto y continuo para que cada persona sepa detectar un correo falso antes de hacer clic.', i: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>' },
];
const faqs = [
  { q: '¿La revisión tiene costo?', a: 'No. Revisamos gratis la protección de su correo y de su dominio (SPF, DKIM y DMARC) y le entregamos una recomendación, sin compromiso.' },
  { q: '¿Funciona con Microsoft 365?', a: 'Sí. Hornetsecurity se integra con Microsoft 365 y agrega filtro avanzado, backup, cifrado y archivo que Microsoft no incluye por sí solo.' },
  { q: '¿Microsoft 365 no hace backup?', a: 'Microsoft garantiza que el servicio esté disponible, pero proteger los datos frente a borrados, errores o ransomware le corresponde a cada empresa. La papelera tiene plazos limitados y no reemplaza un backup.' },
  { q: '¿Qué es DMARC y por qué importa?', a: 'Es la configuración que impide que otros envíen correos haciéndose pasar por su dominio. Sin ella, cualquiera puede suplantar a su empresa ante clientes y proveedores.' },
  { q: '¿Quién implementa y da soporte?', a: 'Star Solutions TI, Partner Silver de Hornetsecurity, con soporte local en Bogotá y cobertura nacional.' },
];
const eventos = [
  ['#ef4444', 'Phishing: factura falsa de proveedor', 'BLOQUEADO'],
  ['#fb923c', 'Adjunto sospechoso analizado en sandbox', 'CUARENTENA'],
  ['#fbbf24', 'Suplantación del dominio rechazada', 'DMARC'],
  ['#34d399', 'Backup de buzones completado', 'OK'],
  ['#f472b6', 'Enlace malicioso reescrito', 'PROTEGIDO'],
  ['#ef4444', 'Correo masivo no deseado', 'FILTRADO'],
];
---

<BaseLayout seo={seo}>
<div class="lp">
  <div class="progress" id="lp-progress"></div>
  <header class="top">
    <div class="w row">
      <span class="brand"><img src="/logo.png" alt="Star Solutions TI" width="36" height="36" /><span>Star Solutions TI</span></span>
      <span class="pill hide-sm">Partner Silver de Hornetsecurity</span>
      <a href={wa} target="_blank" rel="noopener" class="wa-btn">WhatsApp 322 786 2375</a>
    </div>
  </header>

  <section class="hero">
    <div class="grid-bg"></div><div class="glow g1"></div><div class="glow g2"></div><div class="g3"></div>
    <div class="w hero-in">
      <div>
        <span class="tag enter" style="--d:0"><i class="dot"></i>Correo protegido · 24 horas · 7 días</span>
        <h1 class="enter" style="--d:1">El correo es la puerta de entrada. <span class="grad">Protéjalo 24/7.</span></h1>
        <p class="lead enter" style="--d:2">Por el correo llegan las facturas, los contratos y la mayoría de los engaños. Hornetsecurity filtra el phishing, analiza adjuntos, respalda Microsoft 365 y evita que suplanten a su empresa. Star lo implementa y le responde en español.</p>
        <div class="ctas enter" style="--d:3">
          <a href="#proteger" class="btn-main">Quiero proteger mi correo <span aria-hidden="true">→</span></a>
          <a href="#calcular" class="btn-ghost">¿Cuántos buzones tiene?</a>
        </div>
        <div class="stats enter" style="--d:4">
          <div><b>USD 3.046 M</b><span>pérdidas por fraude de correo en 2025 (FBI)</span></div>
          <div><b data-count="1150">0</b><b>+</b><span>empresas atendidas por Star</span></div>
          <div><img src="/marcas/hornetsecurity.webp" alt="Hornetsecurity" width="130" height="40" /></div>
        </div>
      </div>
      <div class="console enter-r" id="lp-console" aria-label="Ilustración del filtro de correo">
        <div class="c-head"><i class="dot"></i>FILTRO DE CORREO · EN VIVO <span class="clock" id="lp-clock">02:00:00</span></div>
        <div class="mailflow" aria-hidden="true">
          <span class="lane"></span>
          <span class="env e1"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span><span class="env e2 bad"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span><span class="env e3"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span><span class="env e4 bad"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
          <span class="gate"><svg viewBox="0 0 24 24"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z"/><path d="m9 12 2 2 4-4"/></svg></span>
          <span class="inbox">Bandeja</span>
        </div>
        <ul class="feed" id="lp-feed">
          {eventos.slice(0, 4).map(([c, t, s]) => <li><i style={`background:${c};box-shadow:0 0 10px ${c}`}></i><span>{t}</span><b style={`color:${c}`}>{s}</b></li>)}
        </ul>
        <p class="note">Ilustración. Eventos de ejemplo.</p>
      </div>
    </div>
  </section>

  <section class="sec" id="protege">
    <div class="w">
      <p class="kick" data-rv>QUÉ PROTEGE HORNETSECURITY</p>
      <h2 data-rv style="--d:1">Todo lo que entra, sale y se guarda en su correo</h2>
      <div class="tabs" role="tablist" data-rv style="--d:2">
        {capas.map((c, n) => <button role="tab" class={n === 0 ? 'tab on' : 'tab'} data-tab={c.id} aria-selected={n === 0 ? 'true' : 'false'}><svg viewBox="0 0 24 24" set:html={c.i}></svg>{c.t}</button>)}
      </div>
      {capas.map((c, n) => (
        <div class={n === 0 ? 'panel on' : 'panel'} data-panel={c.id} role="tabpanel">
          <div><h3>{c.h}</h3><p>{c.d}</p><a href="#proteger" class="link">Proteger mi correo →</a></div>
          <div class="icon-big"><svg viewBox="0 0 24 24" set:html={c.i}></svg></div>
        </div>
      ))}
    </div>
  </section>

  <section class="sec alt" id="m365">
    <div class="w">
      <p class="kick" data-rv>MICROSOFT 365</p>
      <h2 data-rv style="--d:1">Tener Microsoft 365 no significa tener el correo protegido</h2>
      <div class="xdr">
        <div class="liq-card tilt" data-rv style="--d:2">
          <span class="lvl">MICROSOFT</span>
          <h3>Garantiza que el servicio funcione</h3>
          <p>Que el correo, OneDrive y Teams estén disponibles. Incluye un filtro básico y una papelera con plazos limitados.</p>
        </div>
        <div class="liq-card hi tilt" data-rv style="--d:3">
          <span class="lvl">SU EMPRESA</span>
          <h3>Responde por sus datos y sus usuarios</h3>
          <p>Proteger la información frente a phishing dirigido, borrados, errores y ransomware, y evitar que suplanten su dominio. Ahí es donde entra Hornetsecurity.</p>
        </div>
      </div>
      <div class="sensors">
        {[['Filtro avanzado','<path d="M3 5h18l-7 8v6l-4-2v-4z"/>'],['Sandbox','<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9h6v6H9z"/>'],['Backup M365','<path d="M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3z"/><path d="M4 7v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7"/>'],['Cifrado','<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>'],['DMARC','<path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z"/>']].map(([t,i],n) => <div class="sensor tilt" data-rv style={`--d:${n+2}`}><svg viewBox="0 0 24 24" set:html={i}></svg><span>{t}</span></div>)}
      </div>
      <p class="xdr-note">Bonus: revisamos <b>gratis</b> si alguien puede enviar correos haciéndose pasar por su empresa (SPF, DKIM y DMARC).</p>
      <div style="margin-top:24px"><a href="#proteger" class="btn-main">Revisar mi correo gratis →</a></div>
    </div>
  </section>


  <section class="sec">
    <div class="w">
      <p class="kick" data-rv>"YA TENGO MICROSOFT 365"</p>
      <h2 data-rv style="--d:1">Hornetsecurity no reemplaza a Microsoft: le agrega lo que le falta</h2>
      <div class="cmp" data-rv style="--d:2">
        <div class="cmp-row cmp-h"><span></span><span>Solo Microsoft 365</span><span>Microsoft 365 + Hornetsecurity</span></div>
        <div class="cmp-row"><span>Filtro antispam y antimalware</span><span>Básico (según su plan)</span><span class="ok">Avanzado, antes de llegar a la bandeja</span></div>
        <div class="cmp-row"><span>Adjuntos y enlaces sospechosos</span><span>Según su plan</span><span class="ok">Sandbox y revisión al momento del clic</span></div>
        <div class="cmp-row"><span>Backup independiente de correo, OneDrive, SharePoint y Teams</span><span class="no">No incluido</span><span class="ok">Automático y restaurable</span></div>
        <div class="cmp-row"><span>Archivo legal y continuidad del correo</span><span>Según su plan</span><span class="ok">Incluido según la edición</span></div>
        <div class="cmp-row"><span>Entrenamiento antiphishing para el equipo</span><span class="no">No incluido</span><span class="ok">Simulaciones y cursos cortos</span></div>
        <div class="cmp-row"><span>Revisión de suplantación del dominio (DMARC)</span><span class="no">La configura usted</span><span class="ok">Star la revisa y la corrige</span></div>
      </div>
      <p class="fine">Las funciones de Microsoft varían según el plan contratado. En la revisión gratuita le decimos exactamente qué tiene y qué le falta.</p>
    </div>
  </section>

  <section class="sec">
    <div class="w">
      <p class="kick" data-rv>ASÍ EMPIEZA UN FRAUDE</p>
      <h2 data-rv style="--d:1">"Cambiamos de cuenta bancaria": el correo más costoso</h2>
      <div class="timeline" data-rv>
        <div class="tl" data-rv style="--d:2"><b>08:10</b><h4>Llega el correo</h4><p>Parece del proveedor de siempre y pide actualizar la cuenta para el próximo pago.</p></div>
        <div class="tl" data-rv style="--d:3"><b>08:10</b><h4>Hornetsecurity lo analiza</h4><p>Revisa remitente, dominio, enlaces y patrones de fraude antes de entregarlo.</p></div>
        <div class="tl" data-rv style="--d:4"><b>08:10</b><h4>Se bloquea o se advierte</h4><p>El correo se detiene o llega marcado para que su equipo no caiga.</p></div>
        <div class="tl" data-rv style="--d:5"><b>08:11</b><h4>Su dinero sigue en casa</h4><p>Con un proceso claro: todo cambio de cuenta se confirma por teléfono.</p></div>
      </div>
      <p class="fine">Escenario ilustrativo. El resultado depende de la configuración y del servicio contratado.</p>
    </div>
  </section>

  <section class="sec" id="calcular">
    <div class="w calc">
      <div>
        <p class="kick" data-rv>ARME SU PROTECCIÓN</p>
        <h2 data-rv style="--d:1">¿Cuántos buzones de correo tiene?</h2>
        <p class="muted">Mueva la barra y vea qué protección le recomendamos como punto de partida.</p>
        <div class="slider" data-rv style="--d:2">
          <input type="range" id="lp-range" min="5" max="2000" step="5" value="100" aria-label="Número de buzones" />
          <div class="slider-val"><b id="lp-num">100</b> buzones</div>
        </div>
      </div>
      <div class="reco tilt" id="lp-reco" data-rv style="--d:2">
        <p class="kick" id="lp-tier">RECOMENDACIÓN</p>
        <h3 id="lp-title">+ Protección avanzada y archivo</h3>
        <ul id="lp-list"><li>Análisis de adjuntos en sandbox</li></ul>
        <a href="#proteger" class="btn-main" id="lp-reco-cta">Pedir esta recomendación →</a>
        <p class="fine">Orientativo. La propuesta final depende de su revisión gratuita.</p>
      </div>
    </div>
  </section>

  <section class="sec case">
    <div class="w case-in">
      <div data-rv><p class="kick">EL RIESGO ES REAL</p><p class="big">USD 3.046 M</p><p class="case-t">en pérdidas reportadas por fraude de correo corporativo (BEC) en 2025, según el informe IC3 del FBI.</p></div>
      <ul class="why stagger" data-rv>
        <li><b>Partner Silver de Hornetsecurity</b>Implementación certificada en Microsoft 365.</li>
        <li><b>Revisión DMARC gratuita</b>Le decimos si pueden suplantar su dominio y cómo corregirlo.</li>
        <li><b>Soporte en español</b>Equipo local en Bogotá con cobertura nacional.</li>
        <li><b>Desde 2016</b>Más de 1.150 empresas atendidas en Colombia.</li>
      </ul>
    </div>
  </section>


  <section class="sec alt">
    <div class="w">
      <p class="kick" data-rv>QUÉ PASA DESPUÉS</p>
      <h2 data-rv style="--d:1">Así funciona: sin cortar su correo y sin enredos</h2>
      <div class="steps4">
        <div class="st tilt" data-rv style="--d:2"><span>1</span><h4>Le contactamos</h4><p>Un especialista de Star le escribe para entender su caso y su plan de Microsoft 365.</p></div>
        <div class="st tilt" data-rv style="--d:3"><span>2</span><h4>Revisamos su correo</h4><p>Dominio (SPF, DKIM y DMARC), filtro actual y respaldo. Le mostramos qué está expuesto.</p></div>
        <div class="st tilt" data-rv style="--d:4"><span>3</span><h4>Propuesta clara</h4><p>Edición recomendada, alcance y tiempos, por escrito. Usted decide sin presión.</p></div>
        <div class="st tilt" data-rv style="--d:5"><span>4</span><h4>Implementación planificada</h4><p>El cambio se hace en una ventana acordada, para que su equipo siga recibiendo correo.</p></div>
      </div>
    </div>
  </section>

  <section class="sec form-sec" id="proteger">
    <div class="w form-in">
      <div>
        <p class="kick" data-rv>REVISIÓN GRATUITA</p>
        <h2 data-rv style="--d:1">Proteja su correo 24/7. Empecemos por revisarlo.</h2>
        <ul class="checks stagger" data-rv><li>Si pueden suplantar su dominio (SPF, DKIM y DMARC)</li><li>Qué está dejando pasar su filtro actual</li><li>Si su Microsoft 365 tiene backup real</li><li>Recomendación clara y sin compromiso</li></ul>
        <a href={wa} target="_blank" rel="noopener" class="wa-big">Prefiero WhatsApp: 322 786 2375</a>
      </div>
      <form action="/api/leads" method="post" data-lead-form class="card-form" data-rv style="--d:2">
        <input type="hidden" name="_redirect" value="/gracias" />
        <input type="hidden" name="_source_form" value="Hornetsecurity - Landing pauta" />
        <input type="hidden" name="service" value="Hornetsecurity" />
        <div class="two"><label>Nombre *<input name="name" required autocomplete="name" /></label><label>Empresa *<input name="company" required autocomplete="organization" /></label></div>
        <div class="two"><label>Correo corporativo *<input type="email" name="email" required autocomplete="email" /></label><label>Teléfono *<input type="tel" name="phone" required autocomplete="tel" /></label></div>
        <div class="two"><label>Número de buzones *<select name="dispositivos" id="lp-devices" required><option value="">Seleccione un rango</option>{deviceRanges.map((r) => <option value={r}>{r}</option>)}</select></label><label>Dominio de su empresa<input name="message" placeholder="suempresa.com.co" /></label></div>
        <label class="chk"><input type="checkbox" name="privacy" required /> <span>Acepto la <a href="/privacidad/">Política de Privacidad</a> y el tratamiento de mis datos *</span></label>
        <button type="submit" class="btn-main full">Quiero proteger mi correo →</button>
        <p class="fine">Revisión sin costo y sin compromiso.</p>
      </form>
    </div>
  </section>

  <section class="sec">
    <div class="w faq">
      <h2 data-rv>Preguntas frecuentes</h2>
      {faqs.map((f, n) => <details data-rv style={`--d:${n}`}><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <footer class="foot">Star Solutions TI S.A.S. · Cra 27 # 49-19, Bogotá · <a href="/privacidad/">Privacidad</a> · <a href="/">star-ti.com</a></footer>
  <a href="#proteger" class="sticky-cta">Proteger mi correo 24/7 →</a>
</div>

<script define:vars={{ eventos }}>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Contadores
  const fmt = (n) => n.toLocaleString('es-CO');
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return; io.unobserve(e.target);
    const end = +e.target.dataset.count; if (reduce) { e.target.textContent = fmt(end); return; }
    const t0 = performance.now(), d = 1400;
    const step = (t) => { const p = Math.min(1, (t - t0) / d); e.target.textContent = fmt(Math.round(end * (1 - Math.pow(1 - p, 3)))); if (p < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  }), { threshold: .4 });
  document.querySelectorAll('[data-count]').forEach((el) => io.observe(el));
  // Pestañas
  document.querySelectorAll('.tab').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-selected', x === b ? 'true' : 'false'); });
    document.querySelectorAll('.panel').forEach((p) => p.classList.toggle('on', p.dataset.panel === b.dataset.tab));
  }));
  // Consola en vivo (ilustrativa)
  const feed = document.getElementById('lp-feed'), clock = document.getElementById('lp-clock');
  let i = 4, secs = 7200;
  if (!reduce) {
    setInterval(() => { secs = (secs + 1) % 86400; const h = String(Math.floor(secs / 3600)).padStart(2, '0'), m = String(Math.floor(secs / 60) % 60).padStart(2, '0'), s = String(secs % 60).padStart(2, '0'); clock.textContent = `${h}:${m}:${s}`; }, 1000);
    setInterval(() => {
      const [c, t, st] = eventos[i++ % eventos.length];
      const li = document.createElement('li'); li.className = 'new';
      li.innerHTML = `<i style="background:${c};box-shadow:0 0 10px ${c}"></i><span>${t}</span><b style="color:${c}">${st}</b>`;
      feed.prepend(li); if (feed.children.length > 4) feed.lastElementChild.remove();
    }, 2600);
  }
  // Calculadora orientativa
  const range = document.getElementById('lp-range'), num = document.getElementById('lp-num');
  const tiers = [
    { max: 49, k: 'EMPRESA PEQUEÑA', t: 'Filtro y cifrado del correo', l: ['Antispam y antimalware', 'Cifrado y firmas corporativas', 'Administración en la nube'], r: '1 a 49' },
    { max: 249, k: 'EMPRESA MEDIANA', t: '+ Protección avanzada y archivo', l: ['Análisis de adjuntos en sandbox', 'Archivo legal del correo', 'Continuidad si Microsoft 365 falla'], r: '50 a 249' },
    { max: 999, k: 'EMPRESA GRANDE', t: '+ Backup de Microsoft 365', l: ['Copia de correo, OneDrive, SharePoint y Teams', 'Recuperación en minutos', 'Todo lo anterior'], r: '250 a 999' },
    { max: Infinity, k: 'CORPORATIVO / SECTOR PÚBLICO', t: 'Suite completa + concienciación', l: ['Entrenamiento antiphishing para el equipo', 'Gestión de permisos en Microsoft 365', 'Despliegue por fases con Star'], r: '1.000 o más' },
  ];
  const upd = () => {
    const v = +range.value; num.textContent = fmt(v);
    const tr = tiers.find((x) => v <= x.max);
    document.getElementById('lp-tier').textContent = tr.k; document.getElementById('lp-title').textContent = tr.t;
    document.getElementById('lp-list').innerHTML = tr.l.map((x) => `<li>${x}</li>`).join('');
    range.style.setProperty('--p', ((v - 5) / 1995 * 100) + '%');
    document.getElementById('lp-devices').value = tr.r;
  };
  range.addEventListener('input', upd); upd();

  // Aparición al hacer scroll
  const rv = document.querySelectorAll('.lp [data-rv]');
  if (reduce || !('IntersectionObserver' in window)) rv.forEach((e) => e.classList.add('in'));
  else { const ro = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); } }), { threshold: .15, rootMargin: '0px 0px -40px 0px' }); rv.forEach((e) => ro.observe(e)); }
  // Barra de progreso de lectura
  const bar = document.getElementById('lp-progress');
  addEventListener('scroll', () => { const h = document.documentElement; bar.style.transform = `scaleX(${h.scrollTop / (h.scrollHeight - h.clientHeight)})`; }, { passive: true });
  // Inclinación 3D al pasar el mouse
  const fine = matchMedia('(hover:hover) and (pointer:fine)').matches;
  if (!reduce && fine) {

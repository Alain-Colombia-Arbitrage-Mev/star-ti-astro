---
// Página de aterrizaje para pauta (Google/Meta/LinkedIn). Sin menú, una sola oferta.
// noindex y fuera del sitemap: no compite con /bitdefender/.
import BaseLayout from '@layouts/BaseLayout.astro';
import { seoData } from '@data/seo';

const seo = seoData['lp/bitdefender'];
const wa = 'https://wa.me/573227862375?text=' + encodeURIComponent('Hola, quiero proteger los equipos de mi empresa con Bitdefender 24/7.');
const deviceRanges = ['1 a 99', '100 a 499', '500 a 1.999', '2.000 o más'];

const capas = [
  { id: 'equipos', t: 'Equipos y servidores', h: 'Cada equipo, protegido desde la primera conexión', d: 'Prevención con aprendizaje automático contra malware, ransomware y ataques sin archivo en Windows, macOS y Linux, en estaciones de trabajo y servidores físicos o virtuales.', i: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>' },
  { id: 'ransomware', t: 'Ransomware', h: 'Si un ransomware empieza a cifrar, se detiene', d: 'GravityZone detecta el comportamiento de cifrado, bloquea el proceso y ayuda a recuperar los archivos afectados, antes de que el daño se extienda por la red.', i: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>' },
  { id: 'edr', t: 'EDR y XDR', h: 'Ver qué pasó, por dónde entró y hasta dónde llegó', d: 'Detección y respuesta con línea de tiempo del ataque, correlación entre equipos, correo y nube, y aislamiento del equipo comprometido con un clic.', i: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M8 11h6M11 8v6"/>' },
  { id: 'nube', t: 'Nube y correo', h: 'Protección también fuera de la oficina', d: 'Cargas en la nube, servidores de correo y equipos remotos administrados desde la misma consola, con políticas iguales para todos.', i: '<path d="M17.5 19a4.5 4.5 0 1 0-1.4-8.8A6 6 0 0 0 4 12a4 4 0 0 0 1 7.9z"/>' },
  { id: 'mdr', t: 'MDR 24/7', h: 'Analistas vigilando mientras su equipo descansa', d: 'Con el servicio MDR de Bitdefender, un equipo de analistas monitorea, investiga y responde las 24 horas. Star lo implementa y es su contacto en español.', i: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>' },
];
const faqs = [
  { q: '¿La revisión tiene costo?', a: 'No. Revisamos gratis su protección actual y le entregamos una recomendación, sin compromiso de compra.' },
  { q: '¿Tengo que tener Bitdefender hoy?', a: 'No. Si usa otro antivirus, le mostramos cómo se compara y qué implica migrar sin dejar equipos desprotegidos.' },
  { q: '¿Qué significa protección 24/7?', a: 'Que la amenaza se bloquea automáticamente a cualquier hora y, con MDR, que un equipo de analistas revisa y responde las alertas aunque su equipo de TI no esté conectado.' },
  { q: '¿Funciona para equipos remotos y en casa?', a: 'Sí. Los equipos quedan protegidos y administrados desde la nube, estén en la oficina o fuera de ella.' },
  { q: '¿Quién implementa y da soporte?', a: 'Star Solutions TI, Reseller Platinum de Bitdefender, con soporte local en Bogotá y cobertura nacional.' },
];
const eventos = [
  ['#22d3ee', 'Ransomware detenido en equipo de contabilidad', 'BLOQUEADO'],
  ['#a78bfa', 'Equipo con comportamiento sospechoso', 'AISLADO'],
  ['#fbbf24', 'Adjunto malicioso en correo', 'ELIMINADO'],
  ['#34d399', 'Política actualizada en todos los equipos', 'OK'],
  ['#f472b6', 'Intento de acceso a sitio de phishing', 'BLOQUEADO'],
  ['#22d3ee', 'Analista MDR revisando alerta', '24/7'],
];
---

<BaseLayout seo={seo}>
<div class="lp">
  <header class="top">
    <div class="w row">
      <span class="brand"><img src="/logo.png" alt="Star Solutions TI" width="36" height="36" /><span>Star Solutions TI</span></span>
      <span class="pill hide-sm">Reseller Platinum de Bitdefender</span>
      <a href={wa} target="_blank" rel="noopener" class="wa-btn">WhatsApp 322 786 2375</a>
    </div>
  </header>

  <section class="hero">
    <div class="grid-bg"></div><div class="glow g1"></div><div class="glow g2"></div>
    <div class="w hero-in">
      <div>
        <span class="tag"><i class="dot"></i>Protección activa · 24 horas · 7 días</span>
        <h1>Los equipos de su empresa deben estar <span class="grad">protegidos 24/7.</span></h1>
        <p class="lead">Con Bitdefender GravityZone, cada computador y servidor queda protegido contra ransomware, phishing y ataques avanzados, de día y de noche. Star lo implementa, lo administra y le responde en español.</p>
        <div class="ctas">
          <a href="#proteger" class="btn-main">Quiero proteger mis equipos <span aria-hidden="true">→</span></a>
          <a href="#calcular" class="btn-ghost">¿Cuántos equipos tiene?</a>
        </div>
        <div class="stats">
          <div><b data-count="150">0</b><b>+</b><span>empresas protegidas</span></div>
          <div><b data-count="50000">0</b><b>+</b><span>equipos con GravityZone</span></div>
          <div><img src="/marcas/bitdefender-platinum-reseller.webp" alt="Bitdefender Reseller Platinum" width="130" height="49" /></div>
        </div>
      </div>
      <div class="console" aria-label="Ilustración de la consola de protección">
        <div class="c-head"><i class="dot"></i>CONSOLA · PROTECCIÓN ACTIVA <span class="clock" id="lp-clock">02:00:00</span></div>
        <div class="radar"><span class="sweep"></span><span class="blip b1"></span><span class="blip b2"></span><span class="blip b3"></span></div>
        <ul class="feed" id="lp-feed">
          {eventos.slice(0, 4).map(([c, t, s]) => <li><i style={`background:${c};box-shadow:0 0 10px ${c}`}></i><span>{t}</span><b style={`color:${c}`}>{s}</b></li>)}
        </ul>
        <p class="note">Ilustración. Eventos de ejemplo.</p>
      </div>
    </div>
  </section>

  <section class="sec" id="protege">
    <div class="w">
      <p class="kick">QUÉ PROTEGE BITDEFENDER</p>
      <h2>Una sola plataforma para todo lo que puede ser atacado</h2>
      <div class="tabs" role="tablist">
        {capas.map((c, n) => <button role="tab" class={n === 0 ? 'tab on' : 'tab'} data-tab={c.id} aria-selected={n === 0 ? 'true' : 'false'}><svg viewBox="0 0 24 24" set:html={c.i}></svg>{c.t}</button>)}
      </div>
      {capas.map((c, n) => (
        <div class={n === 0 ? 'panel on' : 'panel'} data-panel={c.id} role="tabpanel">
          <div><h3>{c.h}</h3><p>{c.d}</p><a href="#proteger" class="link">Proteger mis equipos →</a></div>
          <div class="icon-big"><svg viewBox="0 0 24 24" set:html={c.i}></svg></div>
        </div>
      ))}
    </div>
  </section>

  <section class="sec alt">
    <div class="w">
      <p class="kick">¿POR QUÉ 24/7?</p>
      <h2>Los ataques no esperan el horario de oficina</h2>
      <div class="timeline">
        <div class="tl"><b>02:00</b><h4>Alguien abre un adjunto</h4><p>Un correo bien hecho llega a la bandeja de un empleado que trabaja desde casa.</p></div>
        <div class="tl"><b>02:00</b><h4>Bitdefender lo detiene</h4><p>El comportamiento malicioso se bloquea en el equipo, sin esperar a nadie.</p></div>
        <div class="tl"><b>02:05</b><h4>Se aísla el equipo</h4><p>Con EDR o MDR, el equipo afectado se separa de la red para que no se propague.</p></div>
        <div class="tl"><b>08:00</b><h4>Usted recibe el informe</h4><p>Qué pasó, qué se hizo y qué recomendamos. Sin perder la operación.</p></div>
      </div>
      <p class="fine">Escenario ilustrativo. Los tiempos dependen de la edición y del servicio contratado.</p>
    </div>
  </section>

  <section class="sec" id="calcular">
    <div class="w calc">
      <div>
        <p class="kick">ARME SU PROTECCIÓN</p>
        <h2>¿Cuántos equipos tiene su empresa?</h2>
        <p class="muted">Mueva la barra y vea qué nivel de protección le recomendamos como punto de partida.</p>
        <div class="slider">
          <input type="range" id="lp-range" min="10" max="3000" step="10" value="150" aria-label="Número de equipos" />
          <div class="slider-val"><b id="lp-num">150</b> equipos</div>
        </div>
      </div>
      <div class="reco" id="lp-reco">
        <p class="kick" id="lp-tier">RECOMENDACIÓN</p>
        <h3 id="lp-title">Prevención + EDR</h3>
        <ul id="lp-list"><li>Protección contra malware y ransomware</li><li>EDR: detección y respuesta</li><li>Consola en la nube</li></ul>
        <a href="#proteger" class="btn-main" id="lp-reco-cta">Pedir esta recomendación →</a>
        <p class="fine">Orientativo. La propuesta final depende de su revisión gratuita.</p>
      </div>
    </div>
  </section>

  <section class="sec case">
    <div class="w case-in">
      <div><p class="kick">CASO REAL</p><p class="big" data-count="32000">0</p><p class="case-t">equipos protegidos con Bitdefender en una sola entidad pública, implementados y administrados por Star.</p></div>
      <ul class="why">
        <li><b>Reseller Platinum</b>El nivel más alto del programa de partners de Bitdefender.</li>
        <li><b>Implementación completa</b>No solo vendemos la licencia: la dejamos funcionando y configurada.</li>
        <li><b>Soporte en español</b>Equipo local en Bogotá con cobertura nacional.</li>
        <li><b>Desde 2016</b>Más de 1.150 empresas atendidas en Colombia.</li>
      </ul>
    </div>
  </section>

  <section class="sec form-sec" id="proteger">
    <div class="w form-in">
      <div>
        <p class="kick">REVISIÓN GRATUITA</p>
        <h2>Proteja sus equipos 24/7. Empecemos por revisar lo que tiene.</h2>
        <ul class="checks"><li>Cuántos equipos protege hoy y cuántos tiene realmente</li><li>Qué funciones paga y no usa</li><li>Qué le falta: EDR, correo, MDR 24/7</li><li>Recomendación clara: renovar, ajustar o migrar</li></ul>
        <a href={wa} target="_blank" rel="noopener" class="wa-big">Prefiero WhatsApp: 322 786 2375</a>
      </div>
      <form action="/api/leads" method="post" data-lead-form class="card-form">
        <input type="hidden" name="_redirect" value="/gracias" />
        <input type="hidden" name="_source_form" value="Bitdefender - Landing pauta" />
        <input type="hidden" name="service" value="Bitdefender" />
        <div class="two"><label>Nombre *<input name="name" required autocomplete="name" /></label><label>Empresa *<input name="company" required autocomplete="organization" /></label></div>
        <div class="two"><label>Correo corporativo *<input type="email" name="email" required autocomplete="email" /></label><label>Teléfono *<input type="tel" name="phone" required autocomplete="tel" /></label></div>
        <label>Número de equipos *<select name="dispositivos" id="lp-devices" required><option value="">Seleccione un rango</option>{deviceRanges.map((r) => <option value={r}>{r}</option>)}</select></label>
        <label class="chk"><input type="checkbox" name="privacy" required /> <span>Acepto la <a href="/privacidad/">Política de Privacidad</a> y el tratamiento de mis datos *</span></label>
        <button type="submit" class="btn-main full">Quiero proteger mis equipos →</button>
        <p class="fine">Revisión sin costo y sin compromiso.</p>
      </form>
    </div>
  </section>

  <section class="sec">
    <div class="w faq">
      <h2>Preguntas frecuentes</h2>
      {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <footer class="foot">Star Solutions TI S.A.S. · Cra 27 # 49-19, Bogotá · <a href="/privacidad/">Privacidad</a> · <a href="/">star-ti.com</a></footer>
  <a href="#proteger" class="sticky-cta">Proteger mis equipos 24/7 →</a>
</div>

<script define:vars={{ eventos }}>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Contadores
  const fmt = (n) => n.toLocaleString('es-CO');
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return; io.unobserve(e.target);
    const end = +e.target.dataset.count; if (reduce) { e.target.textContent = fmt(end); return; }
    const t0 = performance.now(), d = 1400;
    const step = (t) => { const p = Math.min(1, (t - t0) / d); e.target.textContent = fmt(Math.round(end * (1 - Math.pow(1 - p, 3)))); if (p < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  }), { threshold: .4 });
  document.querySelectorAll('[data-count]').forEach((el) => io.observe(el));
  // Pestañas
  document.querySelectorAll('.tab').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-selected', x === b ? 'true' : 'false'); });
    document.querySelectorAll('.panel').forEach((p) => p.classList.toggle('on', p.dataset.panel === b.dataset.tab));
  }));
  // Consola en vivo (ilustrativa)
  const feed = document.getElementById('lp-feed'), clock = document.getElementById('lp-clock');
  let i = 4, secs = 7200;
  if (!reduce) {
    setInterval(() => { secs = (secs + 1) % 86400; const h = String(Math.floor(secs / 3600)).padStart(2, '0'), m = String(Math.floor(secs / 60) % 60).padStart(2, '0'), s = String(secs % 60).padStart(2, '0'); clock.textContent = `${h}:${m}:${s}`; }, 1000);
    setInterval(() => {
      const [c, t, st] = eventos[i++ % eventos.length];
      const li = document.createElement('li'); li.className = 'new';
      li.innerHTML = `<i style="background:${c};box-shadow:0 0 10px ${c}"></i><span>${t}</span><b style="color:${c}">${st}</b>`;
      feed.prepend(li); if (feed.children.length > 4) feed.lastElementChild.remove();
    }, 2600);
  }
  // Calculadora orientativa
  const range = document.getElementById('lp-range'), num = document.getElementById('lp-num');
  const tiers = [
    { max: 99, k: 'PEQUEÑA EMPRESA', t: 'Prevención avanzada', l: ['Antimalware y antiransomware', 'Control web y de dispositivos', 'Consola en la nube'], r: '1 a 99' },
    { max: 499, k: 'MEDIANA EMPRESA', t: 'Prevención + EDR', l: ['Todo lo anterior', 'EDR: detección y respuesta', 'Aislamiento de equipos con un clic'], r: '100 a 499' },
    { max: 1999, k: 'EMPRESA GRANDE', t: 'XDR + MDR 24/7', l: ['Correlación entre equipos, correo y nube', 'Analistas vigilando 24/7 (MDR)', 'Informes para gerencia y auditoría'], r: '500 a 1.999' },
    { max: Infinity, k: 'CORPORATIVO / SECTOR PÚBLICO', t: 'XDR + MDR 24/7 a escala', l: ['Despliegue por fases', 'Administración por Star', 'Experiencia en 32.000 equipos'], r: '2.000 o más' },
  ];
  const upd = () => {
    const v = +range.value; num.textContent = fmt(v);
    const tr = tiers.find((x) => v <= x.max);
    document.getElementById('lp-tier').textContent = tr.k; document.getElementById('lp-title').textContent = tr.t;
    document.getElementById('lp-list').innerHTML = tr.l.map((x) => `<li>${x}</li>`).join('');
    range.style.setProperty('--p', ((v - 10) / 2990 * 100) + '%');
    document.getElementById('lp-devices').value = tr.r;
  };
  range.addEventListener('input', upd); upd();
</script>

<style is:global>
.lp{--bg:#060a16;--bg2:#0b1226;--line:rgba(148,163,255,.16);--ink:#e8edff;--mut:#97a3c6;--c:#22d3ee;--v:#8b5cf6;--r:#ef4444;--grad:linear-gradient(90deg,#22d3ee,#8b5cf6);background:var(--bg);color:var(--ink);font-family:inherit}
.lp .w{max-width:1160px;margin:0 auto;padding:0 20px}
.lp .top{position:sticky;top:0;z-index:20;background:rgba(6,10,22,.8);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.lp .row{height:64px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.lp .brand{display:flex;align-items:center;gap:10px;font-weight:700}.lp .brand img{height:36px;width:36px}
.lp .pill{font-size:12px;color:#67e8f9;border:1px solid rgba(34,211,238,.35);padding:6px 12px;border-radius:999px;letter-spacing:.06em}
.lp .wa-btn{background:#25d366;color:#fff;font-weight:700;font-size:14px;padding:9px 16px;border-radius:999px}
.lp .hero{position:relative;overflow:hidden;padding:72px 0 80px}
.lp .grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(148,163,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(148,163,255,.06) 1px,transparent 1px);background-size:48px 48px;mask-image:radial-gradient(ellipse at 60% 30%,#000 30%,transparent 75%)}
.lp .glow{position:absolute;border-radius:50%;filter:blur(80px);opacity:.5}.lp .g1{width:520px;height:520px;background:#4f46e5;right:-120px;top:-80px}.lp .g2{width:420px;height:420px;background:#0891b2;left:-140px;bottom:-160px}
.lp .hero-in{position:relative;display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}
.lp .tag{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:.1em;color:#67e8f9;border:1px solid rgba(34,211,238,.3);background:rgba(34,211,238,.06);padding:8px 14px;border-radius:999px;text-transform:uppercase}
.lp .dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#34d399;box-shadow:0 0 10px #34d399;animation:lp-pulse 1.6s infinite}
@keyframes lp-pulse{50%{opacity:.35}}
.lp h1{font-size:clamp(34px,5vw,58px);line-height:1.04;letter-spacing:-.03em;margin:18px 0;font-weight:800;text-align:left}
.lp .grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.lp .lead{color:var(--mut);font-size:18px;max-width:560px;text-align:left}
.lp .ctas{display:flex;flex-wrap:wrap;gap:12px;margin:28px 0}
.lp .btn-main{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--grad);color:#04101c;font-weight:800;padding:15px 24px;border-radius:12px;box-shadow:0 10px 30px rgba(34,211,238,.25);transition:transform .15s,box-shadow .2s}
.lp .btn-main:hover{box-shadow:0 12px 40px rgba(139,92,246,.45)}.lp .btn-main:active{transform:scale(.97)}.lp .full{width:100%;border:0;cursor:pointer;font-size:17px}
.lp .btn-ghost{display:inline-flex;align-items:center;padding:15px 22px;border-radius:12px;border:1px solid var(--line);color:var(--ink);font-weight:700}.lp .btn-ghost:hover{border-color:var(--c)}
.lp .stats{display:flex;flex-wrap:wrap;align-items:center;gap:28px}.lp .stats b{font-size:28px;font-weight:800}.lp .stats span{display:block;font-size:13px;color:var(--mut)}.lp .stats img{height:50px;width:auto;background:#fff;border-radius:8px;padding:4px}
.lp .console{background:linear-gradient(145deg,rgba(255,255,255,.09),rgba(255,255,255,.02));border:1px solid var(--line);border-radius:22px;padding:22px;box-shadow:0 40px 100px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.12);transform:perspective(1300px) rotateY(-9deg) rotateX(4deg)}
.lp .c-head{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:.14em;color:#86efac}.lp .clock{margin-left:auto;color:#67e8f9;font-variant-numeric:tabular-nums}
.lp .radar{position:relative;height:150px;margin:16px 0;border-radius:14px;background:radial-gradient(circle,rgba(34,211,238,.12) 0,transparent 65%),repeating-radial-gradient(circle,transparent 0 24px,rgba(125,211,252,.18) 25px 26px);overflow:hidden}
.lp .sweep{position:absolute;left:50%;top:50%;width:150px;height:150px;margin:-75px;border-radius:50%;background:conic-gradient(rgba(34,211,238,.45),transparent 25%);animation:lp-spin 4s linear infinite}
@keyframes lp-spin{to{transform:rotate(360deg)}}
.lp .blip{position:absolute;width:8px;height:8px;border-radius:50%;background:#f472b6;box-shadow:0 0 12px #f472b6;animation:lp-pulse 2s infinite}.lp .b1{left:62%;top:30%}.lp .b2{left:38%;top:62%;animation-delay:.7s}.lp .b3{left:55%;top:70%;background:#fbbf24;box-shadow:0 0 12px #fbbf24;animation-delay:1.3s}
.lp .feed{list-style:none;padding:0;margin:0;display:grid;gap:8px}.lp .feed li{display:flex;align-items:center;gap:10px;font-size:14px;padding:10px 12px;border-radius:10px;background:rgba(255,255,255,.04);border:1px solid var(--line)}
.lp .feed li i{flex:none;width:9px;height:9px;border-radius:50%}.lp .feed li span{flex:1;color:#dbe3ff}.lp .feed li b{font-size:11px;letter-spacing:.08em}
.lp .feed li.new{animation:lp-in .5s cubic-bezier(.23,1,.32,1)}@keyframes lp-in{from{opacity:0;transform:translateY(-8px)}}
.lp .note,.lp .fine{font-size:12px;color:#6f7a9a;margin-top:10px}
.lp .sec{padding:84px 0}.lp .alt{background:var(--bg2)}
.lp .kick{font-size:12px;font-weight:800;letter-spacing:.16em;color:#67e8f9;margin-bottom:10px}
.lp h2{font-size:clamp(28px,3.6vw,42px);line-height:1.1;letter-spacing:-.025em;font-weight:800;margin-bottom:28px;text-align:left}
.lp .muted{color:var(--mut)}
.lp .tabs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:20px}
.lp .tab{display:inline-flex;align-items:center;gap:8px;padding:11px 16px;border-radius:12px;border:1px solid var(--line);background:rgba(255,255,255,.03);color:var(--mut);font-weight:700;cursor:pointer;transition:all .2s}
.lp .tab svg,.lp .icon-big svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.lp .tab.on,.lp .tab:hover{color:#04101c;background:var(--grad);border-color:transparent}
.lp .panel{display:none;grid-template-columns:1fr auto;gap:30px;align-items:center;padding:32px;border-radius:22px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(34,211,238,.07),rgba(139,92,246,.07))}
.lp .panel.on{display:grid;animation:lp-in .4s cubic-bezier(.23,1,.32,1)}
.lp .panel h3{font-size:24px;margin-bottom:10px}.lp .panel p{color:var(--mut);max-width:640px;text-align:left}.lp .link{display:inline-block;margin-top:16px;color:#67e8f9;font-weight:700}
.lp .icon-big{width:120px;height:120px;border-radius:28px;display:flex;align-items:center;justify-content:center;background:rgba(34,211,238,.08);border:1px solid rgba(34,211,238,.3);color:#67e8f9;box-shadow:0 0 50px rgba(34,211,238,.2)}.lp .icon-big svg{width:56px;height:56px}
.lp .timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;position:relative}
.lp .tl{padding:24px;border-radius:18px;background:rgba(255,255,255,.04);border:1px solid var(--line);position:relative}
.lp .tl b{font-size:22px;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;font-variant-numeric:tabular-nums}.lp .tl h4{margin:8px 0 6px;font-size:17px}.lp .tl p{color:var(--mut);font-size:14px;text-align:left}
.lp .calc{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.lp .slider{margin-top:26px}.lp input[type=range]{--p:5%;-webkit-appearance:none;appearance:none;width:100%;height:10px;border-radius:99px;background:linear-gradient(90deg,#22d3ee,#8b5cf6) 0/var(--p) 100% no-repeat,rgba(255,255,255,.1);outline:none}
.lp input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:28px;height:28px;border-radius:50%;background:#fff;box-shadow:0 0 0 6px rgba(34,211,238,.25),0 0 20px #22d3ee;cursor:pointer}
.lp input[type=range]::-moz-range-thumb{width:28px;height:28px;border:0;border-radius:50%;background:#fff;box-shadow:0 0 0 6px rgba(34,211,238,.25)}
.lp .slider-val{margin-top:16px;font-size:18px;color:var(--mut)}.lp .slider-val b{font-size:44px;color:#fff;font-weight:800;font-variant-numeric:tabular-nums}
.lp .reco{padding:30px;border-radius:22px;border:1px solid rgba(34,211,238,.3);background:linear-gradient(145deg,rgba(34,211,238,.1),rgba(139,92,246,.12));box-shadow:0 20px 60px rgba(34,211,238,.08)}
.lp .reco h3{font-size:28px;margin-bottom:12px}.lp .reco ul{margin:0 0 22px;padding-left:20px;color:#dbe3ff;display:grid;gap:6px}
.lp .case{background:radial-gradient(600px 300px at 20% 50%,rgba(239,68,68,.15),transparent 70%),var(--bg2)}
.lp .case-in{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.lp .big{font-size:clamp(64px,9vw,110px);font-weight:800;letter-spacing:-.04em;line-height:1}.lp .case-t{font-size:20px;color:#dbe3ff;margin-top:10px;text-align:left}
.lp .why{list-style:none;padding:0;display:grid;gap:14px}.lp .why li{padding:16px 18px;border-radius:14px;background:rgba(255,255,255,.04);border:1px solid var(--line);color:var(--mut)}.lp .why b{display:block;color:#fff;margin-bottom:2px}
.lp .form-in{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:start}
.lp .checks{list-style:none;padding:0;display:grid;gap:12px;margin-bottom:24px}.lp .checks li{padding-left:30px;position:relative;color:#dbe3ff}.lp .checks li:before{content:"✓";position:absolute;left:0;top:-1px;width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;color:#04101c;background:var(--grad)}
.lp .wa-big{display:inline-block;padding:13px 20px;border-radius:12px;background:#25d366;color:#fff;font-weight:700}
.lp .card-form{display:grid;gap:14px;padding:28px;border-radius:22px;background:rgba(255,255,255,.05);border:1px solid var(--line);box-shadow:0 30px 80px rgba(0,0,0,.4)}
.lp .card-form label{display:grid;gap:6px;font-size:13px;font-weight:700;color:var(--mut)}
.lp .card-form input:not([type=checkbox]),.lp .card-form select{font:inherit;font-weight:500;color:var(--ink);background:rgba(6,10,22,.6);border:1px solid var(--line);border-radius:10px;padding:12px 14px}
.lp .card-form select option{background:#0b1226}
.lp .card-form input:focus,.lp .card-form select:focus{outline:none;border-color:var(--c);box-shadow:0 0 0 3px rgba(34,211,238,.15)}
.lp .two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.lp .chk{display:flex!important;align-items:flex-start;gap:10px;font-weight:500!important}.lp .chk input{margin-top:3px;accent-color:#22d3ee}.lp .chk a{color:#67e8f9;text-decoration:underline}
.lp .faq{max-width:820px}.lp details{border:1px solid var(--line);border-radius:14px;padding:18px 20px;margin-bottom:12px;background:rgba(255,255,255,.03)}.lp summary{font-weight:700;cursor:pointer}.lp details p{color:var(--mut);margin-top:10px;text-align:left}
.lp .foot{border-top:1px solid var(--line);padding:30px 20px 90px;text-align:center;font-size:13px;color:#6f7a9a}.lp .foot a{text-decoration:underline}
.lp .sticky-cta{display:none}
@media(max-width:900px){.lp .hero-in,.lp .calc,.lp .case-in,.lp .form-in{grid-template-columns:1fr}.lp .timeline{grid-template-columns:1fr 1fr}.lp .console{transform:none}.lp .panel{grid-template-columns:1fr}.lp .icon-big{display:none}.lp .hide-sm{display:none}.lp .two{grid-template-columns:1fr}
.lp .sticky-cta{display:block;position:fixed;left:12px;right:12px;bottom:12px;z-index:30;text-align:center;padding:15px;border-radius:14px;background:var(--grad);color:#04101c;font-weight:800;box-shadow:0 10px 30px rgba(0,0,0,.5)}}
@media(prefers-reduced-motion:reduce){.lp .sweep,.lp .dot,.lp .blip{animation:none}}
</style>
</BaseLayout>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import ConsultoriaForm from '@components/ConsultoriaForm.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import BrandLogoCard from '@components/BrandLogoCard.astro';
import { seoData } from '@data/seo';
import { lastpassFaqs } from '@data/lastpass';

const seo = seoData.lastpass;

const check = 'M11.6667 3.5L5.25 9.91667L2.33333 7';

// Por qué las credenciales son un tema de cumplimiento (no solo de comodidad).
const LP_WHY = [
  {
    title: 'Las credenciales son el punto débil',
    desc: 'Contraseñas reutilizadas, anotadas en hojas de cálculo o compartidas por WhatsApp son una de las vías de entrada más comunes en los incidentes. Según LastPass, el 78% de las personas reutiliza la misma contraseña.',
  },
  {
    title: 'Los auditores piden evidencia',
    desc: 'ISO 27001, la Superintendencia Financiera o un cliente corporativo no se conforman con una política escrita: quieren ver quién tiene acceso a qué, desde cuándo, y cómo se retira cuando alguien sale.',
  },
  {
    title: 'El acceso debe terminar con el contrato',
    desc: 'Cuando un empleado o proveedor se va, cada contraseña que conocía es un riesgo. Sin un gestor centralizado no hay forma confiable de saber qué cuentas cambiar.',
  },
];

const LP_FEATURES = [
  {
    title: 'Cifrado de Conocimiento Cero',
    desc: 'Cada bóveda se cifra en el dispositivo del usuario con AES de 256 bits y PBKDF2-SHA256 con salting. Ni LastPass ni el administrador pueden leer las contraseñas.',
    icon: 'M10 2L3 6v5c0 4.5 3 8.5 7 9.5 4-1 7-5 7-9.5V6l-7-4z',
  },
  {
    title: 'Más de 100 Políticas de Seguridad',
    desc: 'Longitud y complejidad de contraseña maestra, MFA obligatorio, restricción por país o dispositivo, bloqueo de exportación y otras reglas aplicadas por grupo o por usuario.',
    icon: 'M6 2h6l4 4v12H6zM12 2v4h4M9 10h4M9 13h4',
  },
  {
    title: 'Autenticación Multifactor (MFA)',
    desc: 'Segundo factor obligatorio para entrar a la bóveda. Con Business Max, MFA avanzado sin contraseña para estaciones de trabajo, VPN y proveedores de identidad, con reglas biométricas y contextuales.',
    icon: 'M5 9V6a5 5 0 0110 0v3M4 9h12v9H4zM10 13v2',
  },
  {
    title: 'Inicio de Sesión Único (SSO)',
    desc: 'Acceso a aplicaciones corporativas con una sola identidad, mediante una biblioteca de aplicaciones preintegradas. Business Max permite SSO ilimitado.',
    icon: 'M8 10h9m-3-3l3 3-3 3M11 4H4v12h7',
  },
  {
    title: 'Carpetas Compartidas con Control',
    desc: 'Comparta credenciales por equipo o proyecto con permisos definidos, incluso sin revelar la contraseña al usuario, y revóquelas al instante cuando cambia el rol.',
    icon: 'M3 6h5l2 2h7v9H3zM10 12h4',
  },
  {
    title: 'Monitoreo de la Dark Web',
    desc: 'Vigilancia 24/7 de las direcciones guardadas en las bóvedas frente a bases de credenciales filtradas, con alertas para cambiar la contraseña antes de que la usen.',
    icon: 'M2 10s3-6 8-6 8 6 8 6-3 6-8 6-8-6-8-6zM10 12a2 2 0 100-4 2 2 0 000 4z',
  },
];

const LP_ACCESS = [
  { t: 'Altas y bajas automáticas', d: 'Integración con Microsoft Entra ID, Active Directory, Google Workspace, Okta y OneLogin: el usuario que se desactiva en el directorio pierde el acceso a LastPass y a lo compartido.' },
  { t: 'Mínimo privilegio por grupos', d: 'Cada área ve solo las credenciales que necesita para su trabajo, con políticas distintas para TI, finanzas o proveedores externos.' },
  { t: 'Acceso sin revelar la contraseña', d: 'Comparta el acceso a una cuenta crítica sin que la persona conozca la clave, para retirarlo sin tener que cambiarla.' },
  { t: 'Puntaje de seguridad', d: 'Mide contraseñas débiles, reutilizadas o antiguas por usuario y para toda la organización, y prioriza dónde actuar.' },
  { t: 'Trazabilidad y SIEM', d: 'Informes de actividad, cambios de políticas, accesos SSO y eventos SAML, con integración a SIEM como Splunk o Microsoft Sentinel.' },
];

// Mapeo de LastPass a controles del Anexo A de ISO/IEC 27001:2022.
const LP_ISO = [
  { ctrl: '5.15', name: 'Control de acceso', how: 'Políticas centralizadas por grupo y carpetas compartidas con permisos definidos.' },
  { ctrl: '5.16', name: 'Gestión de identidades', how: 'Aprovisionamiento automático desde el directorio corporativo (Entra ID, Google, Okta).' },
  { ctrl: '5.17', name: 'Información de autenticación', how: 'Contraseñas generadas, únicas y cifradas; reglas de contraseña maestra; monitoreo de filtraciones.' },
  { ctrl: '5.18', name: 'Derechos de acceso', how: 'Revocación inmediata al cambiar de rol o al salir de la empresa; informes de quién accede a qué.' },
  { ctrl: '8.2', name: 'Derechos de acceso privilegiado', how: 'Credenciales administrativas en carpetas restringidas, compartidas sin revelar la clave.' },
  { ctrl: '8.5', name: 'Autenticación segura', how: 'MFA obligatorio, inicio de sesión federado y opciones sin contraseña.' },
  { ctrl: '8.15', name: 'Registro de eventos', how: 'Registro de actividad de usuarios y administradores exportable a SIEM.' },
];

const LP_PHASES = [
  { n: '1', t: 'Diagnóstico', d: 'Identificamos dónde viven hoy las contraseñas (hojas de cálculo, navegadores, chats) y qué cuentas son críticas para su operación.' },
  { n: '2', t: 'Diseño de Políticas', d: 'Definimos grupos, carpetas compartidas y políticas alineadas con su SGSI, ISO 27001 o los requisitos de su sector.' },
  { n: '3', t: 'Despliegue', d: 'Integramos con su directorio, importamos credenciales de forma segura y capacitamos a los usuarios en la extensión y la app.' },
  { n: '4', t: 'Seguimiento', d: 'Revisamos el puntaje de seguridad, los informes y las alertas de dark web, y ajustamos las políticas con soporte local en español.' },
];

const LP_SECTORS = [
  {
    sector: 'Banca y Finanzas',
    need: 'Control estricto de accesos a sistemas core, banca electrónica y plataformas de pago, bajo los requisitos de ciberseguridad de la Superintendencia Financiera y de PCI DSS (requisito 8).',
    how: 'MFA obligatorio, carpetas restringidas para credenciales privilegiadas, revocación automática y evidencia de accesos para auditoría interna y revisoría.',
  },
  {
    sector: 'Salud',
    need: 'Muchas personas comparten cuentas de sistemas clínicos y administrativos, con datos sensibles protegidos por la Ley 1581 de Habeas Data.',
    how: 'Cuentas compartidas sin revelar la contraseña, accesos por rol y trazabilidad de quién usó cada credencial y cuándo.',
  },
  {
    sector: 'Sector Público',
    need: 'Rotación de contratistas y obligaciones del Modelo de Seguridad y Privacidad de la Información (MSPI) del MinTIC sobre gestión de accesos.',
    how: 'Altas y bajas atadas al directorio, políticas por dependencia e informes exportables como evidencia del MSPI.',
  },
  {
    sector: 'Empresas con ISO 27001',
    need: 'Los controles 5.15 a 5.18 y 8.5 exigen demostrar la gestión de identidades, autenticación y derechos de acceso, no solo describirla.',
    how: 'LastPass genera la evidencia de cada control. Star Solutions TI, certificada ISO 27001, lo integra en su SGSI y sus procedimientos.',
  },
];
---

<BaseLayout seo={seo}>
  <Navbar />

  <div class="bg-white min-h-screen font-['Instrument_Sans',sans-serif]">

    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-gray-50 to-white py-12 sm:py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="mb-6">
              <span class="inline-block bg-red-100 text-red-700 text-xs font-medium px-3 py-1 rounded">
                GESTIÓN DE CONTRASEÑAS Y ACCESOS EMPRESARIAL
              </span>
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
              LastPass: Control de Credenciales{" "}
              <span class="text-red-700">para Cumplir y Auditar.</span>
            </h1>
            <p class="text-lg sm:text-xl text-gray-600 mb-8 max-w-3xl">
              Centralice las contraseñas de su empresa en bóvedas cifradas, aplique políticas de acceso y MFA
              para todos, y demuestre en cada auditoría quién tiene acceso a qué. Star Solutions TI implementa
              LastPass en Colombia, alineado con ISO 27001 y la normativa de su sector, con soporte local en español.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="#consultoria" class="bg-gradient-to-r from-red-600 to-red-700 text-white font-semibold px-8 py-4 rounded-full hover:from-red-700 hover:to-red-800 transition shadow-lg inline-flex items-center justify-center gap-2">
                Solicitar Demo
              </a>
              <a href="/contacto/" class="bg-white border-2 border-gray-200 text-gray-800 font-semibold px-8 py-4 rounded-full hover:bg-gray-50 transition inline-flex items-center justify-center gap-2 focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">
                Hablar con un Experto
              </a>
            </div>
            <div class="mt-8 flex items-center gap-2 text-sm text-gray-500">
              <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 14 14">
                <path d={check} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
              </svg>
              <span>Se integra con Microsoft Entra ID, Google Workspace y Okta</span>
            </div>
          </div>
          <div class="hidden lg:flex items-center justify-center">
            <BrandLogoCard src="/marcas/lastpass.webp" alt="Logo oficial de LastPass" width={800} height={161} maxWidth="max-w-md" />
          </div>
        </div>
      </div>
    </section>

    <!-- Trust Section -->
    <section class="bg-[#111827] py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
          <div>
            <h3 class="text-white font-bold text-xl mb-2">100.000+</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Empresas usan LastPass, según el fabricante</p>
          </div>
          <div>
            <h3 class="text-white font-bold text-xl mb-2">ISO 27001 · ISO 27701</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Seguridad de la información y privacidad certificadas</p>
          </div>
          <div>
            <h3 class="text-white font-bold text-xl mb-2">SOC 2 Tipo II</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Además SOC 3, BSI C5 y TRUSTe</p>
          </div>
          <div>
            <h3 class="text-white font-bold text-xl mb-2">AES-256</h3>
            <p class="text-white text-xs uppercase tracking-wider opacity-75">Cifrado de conocimiento cero (zero-knowledge)</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ¿Qué es? · Bloque definicional para AI/GEO -->
    <section class="bg-white pt-14 sm:pt-16" aria-labelledby="que-es-lastpass">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="que-es-lastpass" class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">¿Qué es LastPass?</h2>
        <p class="text-lg text-gray-700 leading-relaxed">LastPass es un gestor de contraseñas y accesos para empresas que guarda las credenciales de cada empleado en una bóveda cifrada con modelo de conocimiento cero (AES de 256 bits), de modo que ni el proveedor ni el administrador pueden leerlas. Su versión empresarial, LastPass Business, añade una consola de administración con más de 100 políticas de seguridad, autenticación multifactor, inicio de sesión único (SSO), carpetas compartidas con permisos, monitoreo de credenciales en la dark web, integración con directorios como Microsoft Entra ID, Google Workspace y Okta, e informes de actividad exportables a SIEM. En materia de cumplimiento, permite demostrar con evidencia los controles de gestión de identidades, autenticación y derechos de acceso que exigen ISO 27001, PCI DSS y la Ley 1581 de protección de datos. LastPass cuenta con certificaciones ISO 27001, ISO 27701 y SOC 2 Tipo II. Star Solutions TI implementa LastPass en Colombia, con soporte técnico en español para empresas en Bogotá y toda la región.</p>
      </div>
    </section>

    <!-- Por qué es clave en Compliance -->
    <section class="bg-white py-16 sm:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-12">
          <span class="text-red-700 text-xs font-medium uppercase tracking-wide">Por qué es clave en Compliance</span>
          <h2 class="text-3xl sm:text-4xl font-bold mt-4 mb-4">
            Gestionar Contraseñas Ya No Es un Tema de Comodidad
          </h2>
          <p class="text-gray-600 max-w-3xl">
            Es un requisito de seguridad y de cumplimiento. Un gestor corporativo convierte una práctica
            informal y difícil de controlar en un proceso medible y auditable.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {LP_WHY.map((w, i) => (
            <div class="border-l-4 border-red-600 bg-gray-50 rounded-r-2xl p-6">
              <div class="text-sm font-bold text-red-700 mb-2">0{i + 1}</div>
              <h3 class="text-lg font-semibold mb-2">{w.title}</h3>
              <p class="text-sm text-gray-600">{w.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Características de seguridad (6 Cards) -->
    <section class="bg-gray-50 py-16 sm:py-20 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold mb-4">
            Características de{" "}<span class="text-red-700">Seguridad</span>
          </h2>
          <p class="text-gray-600 max-w-3xl">
            Protección técnica de las credenciales y control administrativo completo, sin que la empresa
            tenga que ver las contraseñas de sus empleados.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {LP_FEATURES.map((f) => (
            <div class="bg-white border border-gray-200 rounded-2xl p-6">
              <div class="bg-gray-50 rounded-lg w-10 h-10 flex items-center justify-center mb-4">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 20 20">
                  <path d={f.icon} stroke="#374151" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.66667" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold mb-2">{f.title}</h3>
              <p class="text-sm text-gray-600">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Beneficios en políticas de acceso -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
          <div>
            <span class="text-red-700 text-xs font-medium uppercase tracking-wide">Identidades y Control de Accesos</span>
            <h2 class="text-3xl sm:text-4xl font-bold mt-4 mb-6">
              Beneficios en sus Políticas de Acceso
            </h2>
            <p class="text-gray-600 mb-6">
              El ciclo de vida de un acceso (alta, cambio de rol y retiro) es donde más fallan las empresas.
              LastPass lo conecta con su directorio corporativo para que las políticas se apliquen solas y no
              dependan de que alguien recuerde cambiar una contraseña.
            </p>
            <p class="text-gray-600 mb-8">
              El resultado es el principio de mínimo privilegio aplicado en la práctica: cada persona accede
              solo a lo que necesita, con autenticación fuerte, y la empresa conserva el registro de todo.
            </p>

            <div class="grid grid-cols-2 gap-6">
              <div class="border-l-4 border-red-600 pl-4">
                <div class="text-2xl font-bold text-gray-900 mb-1">100+</div>
                <div class="text-sm text-gray-600">Políticas de seguridad configurables por grupo</div>
              </div>
              <div class="border-l-4 border-red-600 pl-4">
                <div class="text-2xl font-bold text-gray-900 mb-1">7 controles</div>
                <div class="text-sm text-gray-600">Del Anexo A de ISO 27001 cubiertos directamente</div>
              </div>
            </div>
          </div>

          <div>
            <div class="bg-gradient-to-br from-red-50 to-white border border-red-100 rounded-2xl p-8">
              <h3 class="text-xl font-semibold mb-6">Lo que gana su política de accesos:</h3>
              <div class="space-y-4">
                {LP_ACCESS.map((a) => (
                  <div class="flex items-start gap-3">
                    <div class="bg-green-100 border border-green-200 rounded-full p-1 mt-0.5">
                      <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 14 14">
                        <path d={check} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.16667" />
                      </svg>
                    </div>
                    <div>
                      <h3 class="font-semibold text-gray-900">{a.t}</h3>
                      <p class="text-sm text-gray-600">{a.d}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mapa de cumplimiento ISO 27001 -->
    <section class="py-16 sm:py-20 lg:py-24 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-gray-900">
            LastPass y los Controles de ISO 27001
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Cómo LastPass aporta evidencia a los controles del Anexo A de ISO/IEC 27001:2022 relacionados con
            identidades y accesos.
          </p>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white">
          <table class="w-full text-sm text-left text-gray-700 min-w-[640px]">
            <caption class="sr-only">Controles del Anexo A de ISO/IEC 27001:2022 sobre identidades y accesos y cómo los apoya LastPass.</caption>
            <thead class="bg-gray-900 text-white">
              <tr>
                <th scope="col" class="px-5 py-5 font-semibold">Control</th>
                <th scope="col" class="px-5 py-5 font-semibold">Requisito</th>
                <th scope="col" class="px-5 py-5 font-semibold">Cómo lo apoya LastPass</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {LP_ISO.map((r, i) => (
                <tr class={i % 2 ? 'bg-gray-50' : 'bg-white'}>
                  <th scope="row" class="px-5 py-4 font-bold text-red-700 text-left whitespace-nowrap">A.{r.ctrl}</th>
                  <td class="px-5 py-4 font-medium text-gray-900">{r.name}</td>
                  <td class="px-5 py-4 text-gray-600">{r.how}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-gray-500 mt-4 text-center">
          LastPass apoya estos controles, pero la certificación ISO 27001 es de la organización y requiere un SGSI completo.
          <a href="/iso-27001/" class="text-red-700 underline hover:text-red-800">Conozca nuestra consultoría ISO 27001</a>.
        </p>
      </div>
    </section>

    <!-- Implementación -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4">
            Implementación en 4 Fases
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Del caos de contraseñas sueltas a un control de accesos auditable, sin frenar la operación.
          </p>
        </div>

        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-200">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            {LP_PHASES.map((p) => (
              <div class="text-center">
                <div class="bg-red-100 text-red-800 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg">
                  {p.n}
                </div>
                <h3 class="font-semibold mb-2">{p.t}</h3>
                <p class="text-sm text-gray-600">{p.d}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Casos por Sector -->
    <section class="py-16 sm:py-20 lg:py-24 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-gray-900">
            Casos de Uso por Sector en Colombia
          </h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Cada sector tiene exigencias distintas sobre quién accede a qué. Star Solutions TI configura LastPass según su contexto regulatorio.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {LP_SECTORS.map((s) => (
            <div class="bg-white border border-gray-200 rounded-2xl p-6 flex flex-col gap-4">
              <h3 class="text-lg font-bold text-gray-900">{s.sector}</h3>
              <div>
                <p class="text-xs font-semibold text-red-700 uppercase tracking-wide mb-1">Reto:</p>
                <p class="text-sm text-gray-600">{s.need}</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-green-700 uppercase tracking-wide mb-1">Cómo lo resolvemos:</p>
                <p class="text-sm text-gray-600">{s.how}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 sm:py-20 lg:py-24 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-center">
          Preguntas Frecuentes sobre LastPass
        </h2>
        <p class="text-gray-600 text-center mb-12">
          Lo que más nos preguntan las áreas de TI, seguridad y cumplimiento antes de implementarlo.
        </p>
        <div class="space-y-4">
          {lastpassFaqs.map((f) => (
            <details class="bg-white border border-gray-200 rounded-xl group">
              <summary class="font-semibold text-lg p-6 cursor-pointer list-none flex items-center justify-between gap-4">
                {f.q}
